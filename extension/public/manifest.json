{
	"manifest_version": 3,
	"name": "Loka",
	"short_name": "Loka",
	"version": "0.1.0",
	"description": "Spaces, folders inside folders, a command bar and an archive for your tabs. Every space is its own world.",
	"minimum_chrome_version": "120",
	"icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
	"action": {
		"default_title": "Open Loka",
		"default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
	},
	"side_panel": { "default_path": "sidebar.html" },
	"background": { "service_worker": "background.js", "type": "module" },
	"chrome_url_overrides": { "newtab": "newtab.html" },
	"options_page": "settings.html",
	"permissions": [
		"tabs",
		"tabGroups",
		"storage",
		"sidePanel",
		"alarms",
		"downloads",
		"downloads.open",
		"management",
		"favicon",
		"scripting",
		"search",
		"bookmarks"
	],
	"host_permissions": ["<all_urls>"],
	"commands": {
		"_execute_action": {
			"suggested_key": { "default": "Alt+L" },
			"description": "Open the Loka sidebar"
		}
	}
}
