+
+#include "base/values.h"
+
+// Loka's spaces: essentials, each space's pinned tree (folders hold folders)
+// and open tabs, and the archive. A port of the prototype's
+// prototype/src/features/sidebar/sidebar.logic.ts, rule for rule; the two are
+// held equal by the shared cases in sidebar/model-cases.json
+// (model_cases_unittest.cc). Pure functions of their arguments: ids and times
+// come in from the caller. Every tab lives in exactly one place.
+namespace loka {
+
+using TabId = std::string;
+
+struct Tab {
+  TabId id;
+  std::string title;
+  std::string url;
+  // When the tab was last shown, in ms since 1970. Open tabs without one are
+  // never archived.
+  std::optional<double> last_active_at;
+
+  bool operator==(const Tab&) const = default;
+};
+
+// An open tab the archive took away, kept so it can be found and restored.
+struct ArchivedTab {
+  Tab tab;
+  std::string space_id;
+  double archived_at = 0;
+
+  bool operator==(const ArchivedTab&) const = default;
+};
+
+struct PinnedNode {
+  enum class Kind { kTab, kFolder };
+
+  static PinnedNode TabNode(TabId id);
+  static PinnedNode Folder(std::string id,
+                           std::string name,
+                           bool open,
+                           std::vector<PinnedNode> children);
+
+  bool is_folder() const { return kind == Kind::kFolder; }
+  bool operator==(const PinnedNode&) const = default;
+
+  Kind kind = Kind::kTab;
+  std::string id;
+  // Folders only.
+  std::string name;
+  bool open = true;
+  std::vector<PinnedNode> children;
+};
+
+struct Space {
+  std::string id;
+  std::string name;
+  // Hue (0-360) that tints the window while this space shows.
+  double hue = 0;
+  // "banded", "ringed", "cratered" or "ocean".
+  std::string planet = "banded";
+  // "light", "dark" or "system".
+  std::string scheme = "system";
+  std::vector<PinnedNode> pinned;
+  std::vector<TabId> open;
+  std::optional<TabId> active_tab_id;
+
+  bool operator==(const Space&) const = default;
+};
+
+struct State {
+  std::map<TabId, Tab> tabs;
+  std::vector<TabId> essentials;
+  std::vector<Space> spaces;
+  std::string active_space_id;
+  // Newest first. Only open tabs are archived.
+  std::vector<ArchivedTab> archive;
+
+  bool operator==(const State&) const = default;
+};
+
+// Where a dragged tab or folder lands. `index` counts positions before the
+// move; past the end (infinity) means the end.
+struct Place {
+  enum class Area { kEssentials, kPinned, kOpen };
+
+  static Place Essentials(double index);
+  static Place Pinned(std::string space_id,
+                      std::optional<std::string> parent_id,
+                      double index);
+  static Place Open(std::string space_id, double index);
+
+  Area area = Area::kOpen;
+  std::string space_id;
+  std::optional<std::string> parent_id;
+  double index = 0;
+};
+
+inline constexpr double kEnd = std::numeric_limits<double>::infinity();
+inline constexpr size_t kArchiveLimit = 200;
+
+// How a space looks. `scheme` is left out by looks that don't choose one: a
+// new space follows the system, an edit keeps it.
+struct SpaceLook {
+  std::string name;
+  double hue = 0;
+  std::string planet;
+  std::optional<std::string> scheme;
+};
+
+// The space showing. The state always has it.
+const Space& ActiveSpace(const State& state);
+const Space* FindSpace(const State& state, std::string_view space_id);
+const PinnedNode* FindFolder(const std::vector<PinnedNode>& nodes,
+                             std::string_view folder_id);
+// True when the tab sits anywhere inside the folder, at any depth.
+bool FolderHolds(const PinnedNode& folder, std::string_view tab_id);
+// Every tab in a pinned tree, depth first.
+std::vector<TabId> PinnedTabIds(const std::vector<PinnedNode>& nodes);
+
+// Each returns the state unchanged when the change isn't allowed.
+State MoveItem(const State& state, std::string_view id, const Place& to);
+State OpenTab(const State& state,
+              std::string_view url,
+              std::string_view title,
+              double now,
+              const TabId& id);
+State NavigateTab(const State& state,
+                  std::string_view tab_id,
+                  std::string_view url,
+                  std::string_view title);
+State ActivateTab(const State& state, std::string_view tab_id, double now);
+// Closing an open tab deletes it; closing a pinned tab or Essential only
+// unloads it, so the model keeps it.
+State CloseTab(const State& state, std::string_view tab_id);
+State SwitchSpace(const State& state, std::string_view space_id);
+State CreateSpace(const State& state,
+                  const SpaceLook& look,
+                  const std::string& id);
+State UpdateSpace(const State& state,
+                  std::string_view space_id,
+                  const SpaceLook& look);
+State DeleteSpace(const State& state, std::string_view space_id);
+State FocusOrOpen(const State& state,
+                  std::string_view url,
+                  std::string_view title,
+                  double now,
+                  const TabId& id);
+State CreateFolder(const State& state,
+                   std::string_view space_id,
+                   const std::optional<std::string>& parent_id,
+                   std::string_view name,
+                   const std::string& id);
+State RenameFolder(const State& state,
+                   std::string_view folder_id,
+                   std::string_view name);
+State ToggleFolder(const State& state, std::string_view folder_id);
+State UngroupFolder(const State& state, std::string_view folder_id);
+// Nullopt when refused.
+std::optional<State> GroupIntoFolder(const State& state,
+                                     std::string_view target_id,
+                                     std::string_view dragged_id,
+                                     std::string_view name,
+                                     const std::string& id);
+State ArchiveStale(const State& state,
+                   double now,
+                   double max_age_ms,
+                   const std::set<TabId>& keep);
+State RestoreArchived(const State& state, std::string_view tab_id, double now);
+State RevealTab(const State& state, std::string_view tab_id, double now);
+std::vector<TabId> VisibleTabOrder(const State& state);
+State StepTab(const State& state, int step, double now);
+
+// The saved form, the same JSON the prototype writes (exportState).
+base::DictValue ToValue(const State& state);
+// Parses saved or exported spaces. Nullopt unless every tab exists and sits in
+// exactly one place. Fills in what older files lack and drops the 0.1.0
+// alpha's own pages.
+std::optional<State> ImportState(const base::Value& value);
+std::optional<State> ImportStateJson(std::string_view json);
+
+}  // namespace loka
+
+#endif  // COMPONENTS_LOKA_CORE_SPACES_MODEL_H_
