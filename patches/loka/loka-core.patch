+// Copyright 2026 The Loka Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "components/loka/core/tab_links.h"
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+#include <set>
+#include <tuple>
+
+#include "base/strings/string_number_conversions.h"
+
+namespace loka {
+
+namespace {
+
+constexpr char kEssentials[] = "essentials";
+
+// A tab still on its way to its first page: about:blank until one commits.
+bool IsBlank(std::string_view url) {
+  return url.empty() || url == "about:blank";
+}
+
+Space* MutableSpace(State& state, std::string_view space_id) {
+  for (Space& space : state.spaces) {
+    if (space.id == space_id) {
+      return &space;
+    }
+  }
+  return nullptr;
+}
+
+// Adds a browser tab to a space's open tabs as a new Loka tab, at the top,
+// and links them.
+std::pair<State, LiveMap> AddOpenTab(const State& state,
+                                     const LiveMap& live,
+                                     const BrowserTab& tab,
+                                     std::string_view space_id,
+                                     double now,
+                                     const TabId& id) {
+  State next = state;
+  next.tabs[id] = Tab{id, tab.title.empty() ? tab.url : tab.title, tab.url,
+                      tab.last_accessed.value_or(now)};
+  if (Space* space = MutableSpace(next, space_id)) {
+    space->open.insert(space->open.begin(), id);
+    if (tab.active) {
+      space->active_tab_id = id;
+    }
+  }
+  LiveMap linked = live;
+  linked.Set(id, tab.id);
+  return {std::move(next), std::move(linked)};
+}
+
+// Makes a tab the shown one: switches to its space if it has one, then
+// activates it.
+State ShowTab(const State& state, std::string_view tab_id, double now) {
+  std::optional<std::string> home = HomeOf(state, tab_id);
+  const State& in_space = home && *home != kEssentials
+                              ? SwitchSpace(state, *home)
+                              : state;
+  return ActivateTab(in_space, tab_id, now);
+}
+
+const BrowserTab* FindTab(const std::vector<BrowserTab>& tabs, int id) {
+  auto it = std::ranges::find(tabs, id, &BrowserTab::id);
+  return it == tabs.end() ? nullptr : &*it;
+}
+
+}  // namespace
+
+LiveMap::LiveMap() = default;
+LiveMap::LiveMap(const LiveMap&) = default;
+LiveMap& LiveMap::operator=(const LiveMap&) = default;
+LiveMap::~LiveMap() = default;
+
+std::optional<int> LiveMap::BrowserIdOf(std::string_view tab_id) const {
+  for (const auto& [id, browser_id] : entries_) {
+    if (id == tab_id) {
+      return browser_id;
+    }
+  }
+  return std::nullopt;
+}
+
+std::optional<TabId> LiveMap::TabIdOf(int browser_id) const {
+  for (const auto& [id, linked] : entries_) {
+    if (linked == browser_id) {
+      return id;
+    }
+  }
+  return std::nullopt;
+}
+
+void LiveMap::Set(const TabId& tab_id, int browser_id) {
+  for (auto& [id, linked] : entries_) {
+    if (id == tab_id) {
+      linked = browser_id;
+      return;
+    }
+  }
+  entries_.emplace_back(tab_id, browser_id);
+}
+
+void LiveMap::Erase(std::string_view tab_id) {
+  std::erase_if(entries_, [&](const auto& entry) { return entry.first == tab_id; });
+}
+
+std::optional<std::string> HomeOf(const State& state, std::string_view tab_id) {
+  if (std::ranges::contains(state.essentials, tab_id)) {
+    return kEssentials;
+  }
+  for (const Space& space : state.spaces) {
+    if (std::ranges::contains(space.open, tab_id) ||
+        std::ranges::contains(PinnedTabIds(space.pinned), tab_id)) {
+      return space.id;
+    }
+  }
+  return std::nullopt;
+}
+
+bool IsEmptyTab(std::string_view url) {
+  // ^chrome://(loka-newtab|newtab|new-tab-page)(/|$)
+  constexpr std::string_view kScheme = "chrome://";
+  if (!url.starts_with(kScheme)) {
+    return false;
+  }
+  std::string_view rest = url.substr(kScheme.size());
+  for (std::string_view host : {"loka-newtab", "newtab", "new-tab-page"}) {
+    if (rest.starts_with(host) &&
+        (rest.size() == host.size() || rest[host.size()] == '/')) {
+      return true;
+    }
+  }
+  return false;
+}
+
+std::pair<State, LiveMap> AdoptTabs(const State& state,
+                                    const std::vector<BrowserTab>& tabs,
+                                    double now,
+                                    MakeId make_id) {
+  LiveMap live;
+  State next = state;
+  std::set<TabId> taken;
+  auto candidates = [&next]() {
+    const Space& space = ActiveSpace(next);
+    std::vector<TabId> ids = space.open;
+    for (TabId& id : PinnedTabIds(space.pinned)) {
+      ids.push_back(std::move(id));
+    }
+    ids.insert(ids.end(), next.essentials.begin(), next.essentials.end());
+    for (const Space& other : next.spaces) {
+      if (other.id == space.id) {
+        continue;
+      }
+      ids.insert(ids.end(), other.open.begin(), other.open.end());
+      for (TabId& id : PinnedTabIds(other.pinned)) {
+        ids.push_back(std::move(id));
+      }
+    }
+    return ids;
+  };
+  for (const BrowserTab& tab : tabs) {
+    // A tab still on its way joins once it has a page (TabUpdated).
+    if (IsEmptyTab(tab.url) || IsBlank(tab.url)) {
+      continue;
+    }
+    std::optional<TabId> match;
+    for (const TabId& id : candidates()) {
+      auto found = next.tabs.find(id);
+      if (!taken.contains(id) && found != next.tabs.end() &&
+          found->second.url == tab.url) {
+        match = id;
+        break;
+      }
+    }
+    if (match) {
+      taken.insert(*match);
+      live.Set(*match, tab.id);
+      continue;
+    }
+    std::tie(next, live) = AddOpenTab(next, live, tab, next.active_space_id,
+                                      now, make_id());
+    taken.insert(live.TabIdOf(tab.id).value_or(""));
+  }
+  // Open tabs that no browser tab took are gone.
+  const std::vector<Space> spaces = next.spaces;
+  for (const Space& space : spaces) {
+    for (const TabId& id : space.open) {
+      if (!live.BrowserIdOf(id)) {
+        next = CloseTab(next, id);
+      }
+    }
+  }
+  auto active = std::ranges::find_if(tabs, &BrowserTab::active);
+  if (active != tabs.end()) {
+    if (std::optional<TabId> active_id = live.TabIdOf(active->id)) {
+      next = ShowTab(next, *active_id, now);
+    }
+  }
+  return {std::move(next), std::move(live)};
+}
+
+std::pair<State, LiveMap> TabCreated(const State& state,
+                                     const LiveMap& live,
+                                     const BrowserTab& tab,
+                                     double now,
+                                     const std::optional<TabId>& for_tab_id,
+                                     MakeId make_id) {
+  if (for_tab_id && state.tabs.contains(*for_tab_id)) {
+    LiveMap linked = live;
+    linked.Set(*for_tab_id, tab.id);
+    return {state, std::move(linked)};
+  }
+  if (live.TabIdOf(tab.id) || IsEmptyTab(tab.url)) {
+    return {state, live};
+  }
+  std::optional<TabId> opener =
+      tab.opener_tab_id ? live.TabIdOf(*tab.opener_tab_id) : std::nullopt;
+  std::optional<std::string> opener_home =
+      opener ? HomeOf(state, *opener) : std::nullopt;
+  const std::string space_id = opener_home && *opener_home != kEssentials
+                                   ? *opener_home
+                                   : state.active_space_id;
+  return AddOpenTab(state, live, tab, space_id, now, make_id());
+}
+
+std::pair<State, LiveMap> TabRemoved(const State& state,
+                                     const LiveMap& live,
+                                     int browser_id) {
+  std::optional<TabId> id = live.TabIdOf(browser_id);
+  if (!id) {
+    return {state, live};
+  }
+  LiveMap rest = live;
+  rest.Erase(*id);
+  return {CloseTab(state, *id), std::move(rest)};
+}
+
+std::pair<State, LiveMap> TabUpdated(const State& state,
+                                     const LiveMap& live,
+                                     const BrowserTab& tab,
+                                     double now,
+                                     MakeId make_id) {
+  std::optional<TabId> id = live.TabIdOf(tab.id);
+  if (!id) {
+    if (IsEmptyTab(tab.url) || IsBlank(tab.url)) {
+      return {state, live};
+    }
+    return TabCreated(state, live, tab, now, std::nullopt, make_id);
+  }
+  auto current = state.tabs.find(*id);
+  if (current == state.tabs.end()) {
+    return {state, live};
+  }
+  const bool is_open = std::ranges::any_of(state.spaces, [&](const Space& s) {
+    return std::ranges::contains(s.open, *id);
+  });
+  if (is_open && IsEmptyTab(tab.url)) {
+    return TabRemoved(state, live, tab.id);
+  }
+  Tab next = current->second;
+  if (is_open) {
+    next.url = tab.url;
+    next.title = tab.title.empty() ? tab.url : tab.title;
+  } else if (tab.url == current->second.url && !tab.title.empty()) {
+    // A pinned tab or Essential keeps the address it was pinned with, and
+    // only takes the title while it's on that address.
+    next.title = tab.title;
+  }
+  if (next.url == current->second.url && next.title == current->second.title) {
+    return {state, live};
+  }
+  State updated = state;
+  updated.tabs[*id] = std::move(next);
+  return {std::move(updated), live};
+}
+
+State TabActivated(const State& state,
+                   const LiveMap& live,
+                   int browser_id,
+                   double now) {
+  std::optional<TabId> id = live.TabIdOf(browser_id);
+  if (!id) {
+    return state;
+  }
+  if (ActiveSpace(state).active_tab_id == *id && HomeOf(state, *id)) {
+    return state;
+  }
+  return ShowTab(state, *id, now);
+}
+
+std::vector<Op> PlanReconcile(const State& state,
+                              const LiveMap& live,
+                              const std::vector<BrowserTab>& tabs,
+                              const Groups& groups,
+                              bool switched) {
+  std::vector<Op> ops;
+  std::set<int> linked;
+  for (const auto& [id, browser_id] : live.entries()) {
+    linked.insert(browser_id);
+  }
+  std::vector<Op> removes;
+  auto remove = [&removes](int browser_id) {
+    Op op{Op::Kind::kRemove};
+    op.browser_id = browser_id;
+    removes.push_back(std::move(op));
+  };
+  for (const auto& [id, browser_id] : live.entries()) {
+    if (!state.tabs.contains(id) && FindTab(tabs, browser_id)) {
+      remove(browser_id);
+    }
+  }
+  for (const BrowserTab& t : tabs) {
+    if (!t.active && !linked.contains(t.id) && IsEmptyTab(t.url)) {
+      remove(t.id);
+    }
+  }
+  auto on_screen_it = std::ranges::find_if(tabs, &BrowserTab::active);
+  const BrowserTab* on_screen =
+      on_screen_it == tabs.end() ? nullptr : &*on_screen_it;
+  const bool leaving =
+      on_screen && std::ranges::any_of(removes, [&](const Op& op) {
+        return op.browser_id == on_screen->id;
+      });
+  const bool on_empty_tab = on_screen && !linked.contains(on_screen->id) &&
+                            IsEmptyTab(on_screen->url);
+  const Space& space = ActiveSpace(state);
+  const std::optional<TabId>& shown = space.active_tab_id;
+  if (shown && state.tabs.contains(*shown)) {
+    std::optional<int> browser_id = live.BrowserIdOf(*shown);
+    const BrowserTab* tab = browser_id ? FindTab(tabs, *browser_id) : nullptr;
+    if (!tab) {
+      Op op{Op::Kind::kCreate};
+      op.tab_id = *shown;
+      op.url = state.tabs.at(*shown).url;
+      ops.push_back(std::move(op));
+    } else if (!tab->active) {
+      Op op{Op::Kind::kActivate};
+      op.browser_id = tab->id;
+      ops.push_back(std::move(op));
+    }
+  } else if (switched || leaving) {
+    std::vector<TabId> ids = space.open;
+    for (TabId& id : PinnedTabIds(space.pinned)) {
+      ids.push_back(std::move(id));
+    }
+    std::optional<int> first;
+    for (const TabId& id : ids) {
+      std::optional<int> browser_id = live.BrowserIdOf(id);
+      if (browser_id && FindTab(tabs, *browser_id)) {
+        first = browser_id;
+        break;
+      }
+    }
+    if (first) {
+      Op op{Op::Kind::kActivate};
+      op.browser_id = *first;
+      ops.push_back(std::move(op));
+    } else if (!on_empty_tab) {
+      // Already on an empty tab, from one empty space to another: it stays.
+      ops.push_back(Op{Op::Kind::kEmptyTab});
+    }
+  }
+  ops.insert(ops.end(), removes.begin(), removes.end());
+  for (const Space& s : state.spaces) {
+    std::vector<std::pair<int, std::vector<int>>> by_window;
+    for (const auto& [id, browser_id] : live.entries()) {
+      const BrowserTab* tab = FindTab(tabs, browser_id);
+      if (!tab || !state.tabs.contains(id) || HomeOf(state, id) != s.id) {
+        continue;
+      }
+      auto window = std::ranges::find(
+          by_window, tab->window_id,
+          &std::pair<int, std::vector<int>>::first);
+      if (window == by_window.end()) {
+        by_window.emplace_back(tab->window_id, std::vector<int>{browser_id});
+      } else {
+        window->second.push_back(browser_id);
+      }
+    }
+    for (const auto& [window_id, members] : by_window) {
+      const std::string key = GroupKey(s.id, window_id);
+      auto record = std::ranges::find(groups, key,
+                                      &std::pair<std::string, GroupRecord>::first);
+      const GroupRecord* group =
+          record == groups.end() ? nullptr : &record->second;
+      const std::string color = GroupColor(s.hue);
+      std::vector<int> strays;
+      for (int browser_id : members) {
+        const BrowserTab* tab = FindTab(tabs, browser_id);
+        if (!group || !tab || tab->group_id != group->id) {
+          strays.push_back(browser_id);
+        }
+      }
+      if (!strays.empty()) {
+        Op op{Op::Kind::kGroup};
+        op.key = key;
+        op.browser_ids = std::move(strays);
+        op.title = s.name;
+        op.color = color;
+        ops.push_back(std::move(op));
+      } else if (group && group->title &&
+                 (*group->title != s.name || group->color != color)) {
+        // The space was renamed or recolored since its group was made.
+        Op op{Op::Kind::kLook};
+        op.key = key;
+        op.group_id = group->id;
+        op.title = s.name;
+        op.color = color;
+        ops.push_back(std::move(op));
+      }
+    }
+  }
+  std::vector<int> ungroup;
+  for (const auto& [id, browser_id] : live.entries()) {
+    const BrowserTab* tab = FindTab(tabs, browser_id);
+    if (tab && tab->group_id != -1 && HomeOf(state, id) == kEssentials) {
+      ungroup.push_back(browser_id);
+    }
+  }
+  // An empty tab is in no space, so in no space's group.
+  if (on_screen && on_empty_tab && on_screen->group_id != -1) {
+    ungroup.push_back(on_screen->id);
+  }
+  if (!ungroup.empty()) {
+    Op op{Op::Kind::kUngroup};
+    op.browser_ids = std::move(ungroup);
+    ops.push_back(std::move(op));
+  }
+  for (const auto& [key, group] : groups) {
+    const bool collapsed = key.substr(0, key.find('@')) != space.id;
+    if (group.collapsed != collapsed) {
+      Op op{Op::Kind::kCollapse};
+      op.group_id = group.id;
+      op.collapsed = collapsed;
+      ops.push_back(std::move(op));
+    }
+  }
+  return ops;
+}
+
+std::string GroupKey(std::string_view space_id, int window_id) {
+  return std::string(space_id) + "@" + base::NumberToString(window_id);
+}
+
+std::string GroupColor(double hue) {
+  static constexpr std::pair<std::string_view, double> kGroupHues[] = {
+      {"red", 0},     {"orange", 30}, {"yellow", 55}, {"green", 140},
+      {"cyan", 180},  {"blue", 215},  {"purple", 270}, {"pink", 320},
+  };
+  std::string_view best = "grey";
+  double best_gap = std::numeric_limits<double>::infinity();
+  for (const auto& [color, h] : kGroupHues) {
+    const double raw =
+        std::abs(std::fmod(std::fmod(hue - h, 360.0) + 360.0, 360.0));
+    const double gap = std::min(raw, 360.0 - raw);
+    if (gap < best_gap) {
+      best = color;
+      best_gap = gap;
+    }
+  }
+  return std::string(best);
+}
+
+State FirstState(const std::string& space_id) {
+  Space space;
+  space.id = space_id;
+  space.name = "Personal";
+  space.hue = 200;
+  space.planet = "ringed";
+  space.scheme = "system";
+  State state;
+  state.spaces.push_back(std::move(space));
+  state.active_space_id = space_id;
+  return state;
+}
+
+base::DictValue ToValue(const LiveMap& live) {
+  base::DictValue value;
+  for (const auto& [id, browser_id] : live.entries()) {
+    value.Set(id, browser_id);
+  }
+  return value;
+}
+
+base::DictValue ToValue(const Op& op) {
+  base::DictValue value;
+  auto ids = [](const std::vector<int>& browser_ids) {
+    base::ListValue list;
+    for (int id : browser_ids) {
+      list.Append(id);
+    }
+    return list;
+  };
+  switch (op.kind) {
+    case Op::Kind::kCreate:
+      value.Set("op", "create");
+      value.Set("tabId", op.tab_id);
+      value.Set("url", op.url);
+      break;
+    case Op::Kind::kEmptyTab:
+      value.Set("op", "empty-tab");
+      break;
+    case Op::Kind::kActivate:
+      value.Set("op", "activate");
+      value.Set("browserId", op.browser_id);
+      break;
+    case Op::Kind::kRemove:
+      value.Set("op", "remove");
+      value.Set("browserId", op.browser_id);
+      break;
+    case Op::Kind::kGroup:
+      value.Set("op", "group");
+      value.Set("key", op.key);
+      value.Set("browserIds", ids(op.browser_ids));
+      value.Set("title", op.title);
+      value.Set("color", op.color);
+      break;
+    case Op::Kind::kLook:
+      value.Set("op", "look");
+      value.Set("key", op.key);
+      value.Set("groupId", op.group_id);
+      value.Set("title", op.title);
+      value.Set("color", op.color);
+      break;
+    case Op::Kind::kUngroup:
+      value.Set("op", "ungroup");
+      value.Set("browserIds", ids(op.browser_ids));
+      break;
+    case Op::Kind::kCollapse:
+      value.Set("op", "collapse");
+      value.Set("groupId", op.group_id);
+      value.Set("collapsed", op.collapsed);
+      break;
+  }
+  return value;
+}
