+
+// Keeps Loka's spaces and a window's real tabs in step, both ways. A port of
+// prototype/src/features/tabs/live.logic.ts, held equal to it by the shared
+// cases (model_cases_unittest.cc):
+//   browser -> Loka: a tab opened, closed, changed or picked updates the spaces
+//   Loka -> browser: PlanReconcile lists what the browser must do so its tabs
+//   match the spaces.
+namespace loka {
+
+// The parts of a browser tab Loka reads.
+struct BrowserTab {
+  int id = 0;
+  std::string url;
+  std::string title;
+  bool active = false;
+  // -1 when the tab isn't in a group.
+  int group_id = -1;
+  int window_id = 0;
+  std::optional<int> opener_tab_id;
+  std::optional<double> last_accessed;
+};
+
+// Which browser tab shows each loaded Loka tab, in the order the links were
+// made: the order PlanReconcile walks them in.
+class LiveMap {
+ public:
+  LiveMap();
+  LiveMap(const LiveMap&);
+  LiveMap& operator=(const LiveMap&);
+  ~LiveMap();
+
+  std::optional<int> BrowserIdOf(std::string_view tab_id) const;
+  std::optional<TabId> TabIdOf(int browser_id) const;
+  // Links `tab_id` to `browser_id`, keeping its place if it was linked.
+  void Set(const TabId& tab_id, int browser_id);
+  void Erase(std::string_view tab_id);
+  const std::vector<std::pair<TabId, int>>& entries() const {
+    return entries_;
+  }
+  bool operator==(const LiveMap&) const = default;
+
+ private:
+  std::vector<std::pair<TabId, int>> entries_;
+};
+
+// A space's tab group in one window, as the sync last set it. Title and color
+// are unknown for older records.
+struct GroupRecord {
+  int id = 0;
+  bool collapsed = false;
+  std::optional<std::string> title;
+  std::optional<std::string> color;
+};
+
+// Group records by GroupKey, in the order they were made.
+using Groups = std::vector<std::pair<std::string, GroupRecord>>;
+
+struct Op {
+  enum class Kind {
+    kCreate,
+    kEmptyTab,
+    kActivate,
+    kRemove,
+    kGroup,
+    kLook,
+    kUngroup,
+    kCollapse,
+  };
+
+  Kind kind;
+  // kCreate.
+  TabId tab_id;
+  std::string url;
+  // kActivate, kRemove.
+  int browser_id = 0;
+  // kGroup, kLook.
+  std::string key;
+  std::string title;
+  std::string color;
+  // kGroup, kUngroup.
+  std::vector<int> browser_ids;
+  // kLook, kCollapse.
+  int group_id = 0;
+  // kCollapse.
+  bool collapsed = false;
+};
+
+using MakeId = base::FunctionRef<TabId()>;
+
+// Which space a tab belongs to, "essentials" for an Essential, or nullopt.
+std::optional<std::string> HomeOf(const State& state, std::string_view tab_id);
+// chrome://newtab and Loka's empty page: never one of Loka's tabs.
+bool IsEmptyTab(std::string_view url);
+
+std::pair<State, LiveMap> AdoptTabs(const State& state,
+                                    const std::vector<BrowserTab>& tabs,
+                                    double now,
+                                    MakeId make_id);
+std::pair<State, LiveMap> TabCreated(const State& state,
+                                     const LiveMap& live,
+                                     const BrowserTab& tab,
+                                     double now,
+                                     const std::optional<TabId>& for_tab_id,
+                                     MakeId make_id);
+std::pair<State, LiveMap> TabRemoved(const State& state,
+                                     const LiveMap& live,
+                                     int browser_id);
+std::pair<State, LiveMap> TabUpdated(const State& state,
+                                     const LiveMap& live,
+                                     const BrowserTab& tab,
+                                     double now,
+                                     MakeId make_id);
+State TabActivated(const State& state,
+                   const LiveMap& live,
+                   int browser_id,
+                   double now);
+std::vector<Op> PlanReconcile(const State& state,
+                              const LiveMap& live,
+                              const std::vector<BrowserTab>& tabs,
+                              const Groups& groups,
+                              bool switched);
+
+std::string GroupKey(std::string_view space_id, int window_id);
+// The tab group color nearest a space's hue, going round the color wheel.
+std::string GroupColor(double hue);
+// One space, nothing pinned: for a profile with no saved spaces.
+State FirstState(const std::string& space_id);
+
+base::DictValue ToValue(const LiveMap& live);
+base::DictValue ToValue(const Op& op);
+
+}  // namespace loka
