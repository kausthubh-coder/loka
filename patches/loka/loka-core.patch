+// Copyright 2026 The Loka Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+// Runs the cases the prototype's model wrote (prototype/src/features/sidebar/
+// model-cases.json, made by `bun run model:cases`) through the C++ model and
+// expects the same results, so the two models can't drift apart. The file's
+// path comes in LOKA_MODEL_CASES (scripts/model-cases.mjs sets it).
+
+#include <optional>
+#include <set>
+#include <string>
+#include <vector>
+
+#include "base/environment.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/values.h"
+#include "components/loka/core/spaces_model.h"
+#include "components/loka/core/tab_links.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace loka {
+namespace {
+
+// Numbers compare as numbers: JSON gives small ones as ints, the model writes
+// doubles.
+base::Value Normalize(const base::Value& value) {
+  if (value.is_int()) {
+    return base::Value(static_cast<double>(value.GetInt()));
+  }
+  if (value.is_list()) {
+    base::ListValue list;
+    for (const base::Value& item : value.GetList()) {
+      list.Append(Normalize(item));
+    }
+    return base::Value(std::move(list));
+  }
+  if (value.is_dict()) {
+    base::DictValue dict;
+    for (const auto [key, item] : value.GetDict()) {
+      dict.Set(key, Normalize(item));
+    }
+    return base::Value(std::move(dict));
+  }
+  return value.Clone();
+}
+
+std::string Json(const base::Value& value) {
+  return base::WriteJsonWithOptions(value, base::JSONWriter::OPTIONS_PRETTY_PRINT)
+      .value_or("<unwritable>");
+}
+
+void ExpectSame(const base::Value& expected, const base::Value& actual) {
+  base::Value want = Normalize(expected);
+  base::Value got = Normalize(actual);
+  EXPECT_EQ(want, got) << "expected:\n" << Json(want) << "\nactual:\n" << Json(got);
+}
+
+// A case's starting state: always a valid one (the seed, or what an earlier
+// op made from it).
+State ReadState(const base::Value& value) {
+  std::optional<State> state = ImportState(value);
+  if (state) {
+    return *state;
+  }
+  ADD_FAILURE() << "a case's starting state doesn't import:\n" << Json(value);
+  return State();
+}
+
+double Number(const base::DictValue& args, std::string_view key) {
+  const base::Value* value = args.Find(key);
+  if (!value || value->is_none()) {
+    return kEnd;
+  }
+  return value->GetDouble();
+}
+
+std::optional<std::string> OptionalString(const base::DictValue& args,
+                                          std::string_view key) {
+  const std::string* value = args.FindString(key);
+  return value ? std::optional<std::string>(*value) : std::nullopt;
+}
+
+std::string String(const base::DictValue& args, std::string_view key) {
+  const std::string* value = args.FindString(key);
+  return value ? *value : std::string();
+}
+
+SpaceLook ReadLook(const base::DictValue& look) {
+  return SpaceLook{String(look, "name"), look.FindDouble("hue").value_or(0),
+                   String(look, "planet"), OptionalString(look, "scheme")};
+}
+
+Place ReadPlace(const base::DictValue& to) {
+  const std::string area = String(to, "area");
+  const double index = Number(to, "index");
+  if (area == "essentials") {
+    return Place::Essentials(index);
+  }
+  if (area == "pinned") {
+    return Place::Pinned(String(to, "spaceId"), OptionalString(to, "parentId"),
+                         index);
+  }
+  return Place::Open(String(to, "spaceId"), index);
+}
+
+BrowserTab ReadTab(const base::DictValue& t) {
+  BrowserTab tab;
+  tab.id = t.FindInt("id").value_or(0);
+  tab.url = String(t, "url");
+  tab.title = String(t, "title");
+  tab.active = t.FindBool("active").value_or(false);
+  tab.group_id = t.FindInt("groupId").value_or(-1);
+  tab.window_id = t.FindInt("windowId").value_or(0);
+  tab.opener_tab_id = t.FindInt("openerTabId");
+  tab.last_accessed = t.FindDouble("lastAccessed");
+  return tab;
+}
+
+std::vector<BrowserTab> ReadTabs(const base::DictValue& args) {
+  std::vector<BrowserTab> tabs;
+  for (const base::Value& t : *args.FindList("tabs")) {
+    tabs.push_back(ReadTab(t.GetDict()));
+  }
+  return tabs;
+}
+
+// Pairs, to keep their order: [[lokaId, browserId], ...].
+LiveMap ReadLive(const base::DictValue& args) {
+  LiveMap live;
+  if (const base::ListValue* pairs = args.FindList("live")) {
+    for (const base::Value& pair : *pairs) {
+      live.Set(pair.GetList()[0].GetString(), pair.GetList()[1].GetInt());
+    }
+  }
+  return live;
+}
+
+base::ListValue LivePairs(const LiveMap& live) {
+  base::ListValue pairs;
+  for (const auto& [id, browser_id] : live.entries()) {
+    base::ListValue pair;
+    pair.Append(id);
+    pair.Append(browser_id);
+    pairs.Append(std::move(pair));
+  }
+  return pairs;
+}
+
+Groups ReadGroups(const base::DictValue& args) {
+  Groups groups;
+  for (const base::Value& pair : *args.FindList("groups")) {
+    const base::DictValue& r = pair.GetList()[1].GetDict();
+    groups.emplace_back(pair.GetList()[0].GetString(),
+                        GroupRecord{r.FindInt("id").value_or(0),
+                                    r.FindBool("collapsed").value_or(false),
+                                    OptionalString(r, "title"),
+                                    OptionalString(r, "color")});
+  }
+  return groups;
+}
+
+// What one case's op gives, in the shape its "expect" has.
+std::optional<base::DictValue> RunCase(const base::DictValue& c,
+                                   const base::DictValue& states) {
+  const std::string op = String(c, "op");
+  const base::DictValue& args = *c.FindDict("args");
+  State state;
+  if (const base::Value* start = c.Find("state")) {
+    state = ReadState(start->is_string() ? *states.Find(start->GetString())
+                                         : *start);
+  }
+  std::vector<std::string> ids;
+  if (const base::ListValue* list = args.FindList("ids")) {
+    for (const base::Value& id : *list) {
+      ids.push_back(id.GetString());
+    }
+  }
+  size_t next_id = 0;
+  auto make_id = [&]() -> TabId {
+    if (next_id < ids.size()) {
+      return ids[next_id++];
+    }
+    ADD_FAILURE() << "the case gave too few ids";
+    return "missing-id";
+  };
+  const double now = args.FindDouble("now").value_or(0);
+  base::DictValue result;
+  auto with_state = [&](const State& s) {
+    result.Set("state", ToValue(s));
+    return std::move(result);
+  };
+  auto with_links = [&](const std::pair<State, LiveMap>& pair) {
+    result.Set("state", ToValue(pair.first));
+    result.Set("live", LivePairs(pair.second));
+    return std::move(result);
+  };
+
+  if (op == "moveItem") {
+    return with_state(
+        MoveItem(state, String(args, "id"), ReadPlace(*args.FindDict("to"))));
+  }
+  if (op == "openTab") {
+    return with_state(OpenTab(state, String(args, "url"), String(args, "title"),
+                              now, String(args, "id")));
+  }
+  if (op == "navigateTab") {
+    return with_state(NavigateTab(state, String(args, "tabId"),
+                                  String(args, "url"), String(args, "title")));
+  }
+  if (op == "activateTab") {
+    return with_state(ActivateTab(state, String(args, "tabId"), now));
+  }
+  if (op == "closeTab") {
+    return with_state(CloseTab(state, String(args, "tabId")));
+  }
+  if (op == "switchSpace") {
+    return with_state(SwitchSpace(state, String(args, "spaceId")));
+  }
+  if (op == "createSpace") {
+    return with_state(CreateSpace(state, ReadLook(*args.FindDict("look")),
+                                  String(args, "id")));
+  }
+  if (op == "updateSpace") {
+    return with_state(UpdateSpace(state, String(args, "spaceId"),
+                                  ReadLook(*args.FindDict("look"))));
+  }
+  if (op == "deleteSpace") {
+    return with_state(DeleteSpace(state, String(args, "spaceId")));
+  }
+  if (op == "focusOrOpen") {
+    return with_state(FocusOrOpen(state, String(args, "url"),
+                                  String(args, "title"), now,
+                                  String(args, "id")));
+  }
+  if (op == "createFolder") {
+    return with_state(CreateFolder(state, String(args, "spaceId"),
+                                   OptionalString(args, "parentId"),
+                                   String(args, "name"), String(args, "id")));
+  }
+  if (op == "renameFolder") {
+    return with_state(
+        RenameFolder(state, String(args, "folderId"), String(args, "name")));
+  }
+  if (op == "toggleFolder") {
+    return with_state(ToggleFolder(state, String(args, "folderId")));
+  }
+  if (op == "ungroupFolder") {
+    return with_state(UngroupFolder(state, String(args, "folderId")));
+  }
+  if (op == "groupIntoFolder") {
+    std::optional<State> grouped =
+        GroupIntoFolder(state, String(args, "targetId"),
+                        String(args, "draggedId"), String(args, "name"),
+                        String(args, "id"));
+    if (!grouped) {
+      result.Set("refused", true);
+      return std::move(result);
+    }
+    return with_state(*grouped);
+  }
+  if (op == "archiveStale") {
+    std::set<TabId> keep;
+    for (const base::Value& id : *args.FindList("keep")) {
+      keep.insert(id.GetString());
+    }
+    return with_state(
+        ArchiveStale(state, now, args.FindDouble("maxAgeMs").value_or(0), keep));
+  }
+  if (op == "restoreArchived") {
+    return with_state(RestoreArchived(state, String(args, "tabId"), now));
+  }
+  if (op == "revealTab") {
+    return with_state(RevealTab(state, String(args, "tabId"), now));
+  }
+  if (op == "stepTab") {
+    return with_state(StepTab(state, args.FindInt("step").value_or(1), now));
+  }
+  if (op == "importState") {
+    std::optional<State> imported = ImportState(*args.Find("json"));
+    if (!imported) {
+      result.Set("refused", true);
+      return std::move(result);
+    }
+    return with_state(*imported);
+  }
+  if (op == "adoptTabs") {
+    return with_links(AdoptTabs(state, ReadTabs(args), now, make_id));
+  }
+  if (op == "tabCreated") {
+    return with_links(TabCreated(state, ReadLive(args),
+                                 ReadTab(*args.FindDict("tab")), now,
+                                 OptionalString(args, "forTabId"), make_id));
+  }
+  if (op == "tabRemoved") {
+    return with_links(TabRemoved(state, ReadLive(args),
+                                 args.FindInt("browserId").value_or(0)));
+  }
+  if (op == "tabUpdated") {
+    return with_links(TabUpdated(state, ReadLive(args),
+                                 ReadTab(*args.FindDict("tab")), now, make_id));
+  }
+  if (op == "tabActivated") {
+    return with_state(TabActivated(state, ReadLive(args),
+                                   args.FindInt("browserId").value_or(0), now));
+  }
+  if (op == "planReconcile") {
+    base::ListValue ops;
+    for (const Op& planned :
+         PlanReconcile(state, ReadLive(args), ReadTabs(args), ReadGroups(args),
+                       args.FindBool("switched").value_or(false))) {
+      ops.Append(ToValue(planned));
+    }
+    result.Set("ops", std::move(ops));
+    return std::move(result);
+  }
+  if (op == "groupColor") {
+    result.Set("color", GroupColor(args.FindDouble("hue").value_or(0)));
+    return std::move(result);
+  }
+  if (op == "firstState") {
+    return with_state(FirstState(String(args, "id")));
+  }
+  return std::nullopt;
+}
+
+TEST(LokaModelCases, MatchThePrototype) {
+  std::optional<std::string> path =
+      base::Environment::Create()->GetVar("LOKA_MODEL_CASES");
+  ASSERT_TRUE(path) << "Set LOKA_MODEL_CASES to model-cases.json "
+                       "(bun run model:cases -- --cpp does).";
+  std::string json;
+  ASSERT_TRUE(base::ReadFileToString(
+      base::FilePath(base::UTF8ToWide(*path)), &json))
+      << *path;
+  std::optional<base::Value> file =
+      base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(file && file->is_dict());
+  const base::DictValue& states = *file->GetDict().FindDict("states");
+  const base::ListValue& cases = *file->GetDict().FindList("cases");
+  ASSERT_FALSE(cases.empty());
+  for (const base::Value& c : cases) {
+    const base::DictValue& one = c.GetDict();
+    SCOPED_TRACE(String(one, "name"));
+    std::optional<base::DictValue> got = RunCase(one, states);
+    if (!got) {
+      ADD_FAILURE() << "no C++ for op " << String(one, "op");
+      continue;
+    }
+    ExpectSame(*one.Find("expect"), base::Value(std::move(*got)));
+  }
+}
+
