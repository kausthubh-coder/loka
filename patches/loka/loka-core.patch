+
+const Space& ActiveSpace(const State& state) {
+  const Space* space = FindSpace(state, state.active_space_id);
+  CHECK(space) << "active space " << state.active_space_id
+               << " does not exist";
+  return *space;
+}
+
+const Space* FindSpace(const State& state, std::string_view space_id) {
+  for (const Space& space : state.spaces) {
+    if (space.id == space_id) {
+      return &space;
+    }
+  }
+  return nullptr;
+}
+
+const PinnedNode* FindFolder(const std::vector<PinnedNode>& nodes,
+                             std::string_view folder_id) {
+  for (const PinnedNode& node : nodes) {
+    if (!node.is_folder()) {
+      continue;
+    }
+    if (node.id == folder_id) {
+      return &node;
+    }
+    if (const PinnedNode* inside = FindFolder(node.children, folder_id)) {
+      return inside;
+    }
+  }
+  return nullptr;
+}
+
+bool FolderHolds(const PinnedNode& folder, std::string_view tab_id) {
+  return std::ranges::any_of(folder.children, [&](const PinnedNode& child) {
+    return child.is_folder() ? FolderHolds(child, tab_id) : child.id == tab_id;
+  });
+}
+
+std::vector<TabId> PinnedTabIds(const std::vector<PinnedNode>& nodes) {
+  std::vector<TabId> ids;
+  AppendPinnedTabIds(nodes, ids);
+  return ids;
+}
+
+State MoveItem(const State& state, std::string_view id, const Place& to) {
+  std::optional<Detached> detached = Detach(state, id);
+  if (!detached) {
+    return state;
+  }
+  const PinnedNode& node = detached->node;
+  const Place& from = detached->from;
+  if (node.is_folder()) {
+    if (to.area != Place::Area::kPinned) {
+      return state;
+    }
+    if (to.parent_id && ContainsFolder(node, *to.parent_id)) {
+      return state;
+    }
+  }
+  // Indexes are given against the list before the move, so moving down the
+  // same list shifts by one.
+  const double index = SameContainer(from, to) &&
+                               static_cast<double>(from.index) < to.index
+                           ? to.index - 1
+                           : to.index;
+  State next = std::move(detached->state);
+  // A tab sent to another space stops being the one its old space shows.
+  // Essentials belong to every space.
+  if (from.area != Place::Area::kEssentials &&
+      to.area != Place::Area::kEssentials && from.space_id != to.space_id) {
+    Space* old = MutableSpace(next, from.space_id);
+    if (old && old->active_tab_id == id) {
+      old->active_tab_id.reset();
+    }
+  }
+  if (to.area == Place::Area::kEssentials) {
+    next.essentials.insert(
+        next.essentials.begin() + Clamp(index, next.essentials.size()),
+        node.id);
+    return next;
+  }
+  Space* space = MutableSpace(next, to.space_id);
+  if (to.area == Place::Area::kOpen) {
+    if (space) {
+      space->open.insert(space->open.begin() + Clamp(index, space->open.size()),
+                         node.id);
+    }
+    return next;
+  }
+  if (!space || !InsertPinned(space->pinned, to.parent_id, index, node)) {
+    return state;
+  }
+  return next;
+}
+
+State OpenTab(const State& state,
+              std::string_view url,
+              std::string_view title,
+              double now,
+              const TabId& id) {
+  State next = state;
+  next.tabs[id] = Tab{id, std::string(title), std::string(url), now};
+  Space* space = MutableSpace(next, next.active_space_id);
+  if (space) {
+    space->open.insert(space->open.begin(), id);
+    space->active_tab_id = id;
+  }
+  return next;
+}
+
+State NavigateTab(const State& state,
+                  std::string_view tab_id,
+                  std::string_view url,
+                  std::string_view title) {
+  auto it = state.tabs.find(std::string(tab_id));
+  if (it == state.tabs.end()) {
+    return state;
+  }
+  State next = state;
+  Tab& tab = next.tabs[it->first];
+  tab.url = url;
+  tab.title = title;
+  return next;
+}
+
+State ActivateTab(const State& state, std::string_view tab_id, double now) {
+  auto it = state.tabs.find(std::string(tab_id));
+  if (it == state.tabs.end()) {
+    return state;
+  }
+  State next = state;
+  next.tabs[it->first].last_active_at = now;
+  if (Space* space = MutableSpace(next, next.active_space_id)) {
+    space->active_tab_id = std::string(tab_id);
+  }
+  return next;
+}
+
+State CloseTab(const State& state, std::string_view tab_id) {
+  State next = state;
+  for (Space& owner : next.spaces) {
+    std::optional<size_t> at = IndexOf(owner.open, tab_id);
+    if (!at) {
+      continue;
+    }
+    next.tabs.erase(std::string(tab_id));
+    owner.open.erase(owner.open.begin() + *at);
+    if (owner.active_tab_id == tab_id) {
+      if (owner.open.empty()) {
+        owner.active_tab_id.reset();
+      } else {
+        owner.active_tab_id = owner.open[std::min(*at, owner.open.size() - 1)];
+      }
+    }
+    break;
+  }
+  for (Space& space : next.spaces) {
+    if (space.active_tab_id == tab_id) {
+      space.active_tab_id.reset();
+    }
+  }
+  return next;
+}
+
+State SwitchSpace(const State& state, std::string_view space_id) {
+  if (!FindSpace(state, space_id)) {
+    return state;
+  }
+  State next = state;
+  next.active_space_id = std::string(space_id);
+  return next;
+}
+
+State CreateSpace(const State& state,
+                  const SpaceLook& look,
+                  const std::string& id) {
+  State next = state;
+  Space space;
+  space.id = id;
+  space.name = look.name;
+  space.hue = look.hue;
+  space.planet = look.planet;
+  space.scheme = look.scheme.value_or("system");
+  next.spaces.push_back(std::move(space));
+  next.active_space_id = id;
+  return next;
+}
+
+State UpdateSpace(const State& state,
+                  std::string_view space_id,
+                  const SpaceLook& look) {
+  std::string name(base::TrimWhitespaceASCII(look.name, base::TRIM_ALL));
+  if (name.empty()) {
+    return state;
+  }
+  State next = state;
+  if (Space* space = MutableSpace(next, space_id)) {
+    space->name = name;
+    space->hue = look.hue;
+    space->planet = look.planet;
+    if (look.scheme) {
+      space->scheme = *look.scheme;
+    }
+  }
+  return next;
+}
+
+State DeleteSpace(const State& state, std::string_view space_id) {
+  auto it = std::ranges::find(state.spaces, space_id, &Space::id);
+  if (it == state.spaces.end() || state.spaces.size() < 2) {
+    return state;
+  }
+  const size_t index = static_cast<size_t>(it - state.spaces.begin());
+  std::set<TabId> gone(it->open.begin(), it->open.end());
+  for (TabId& id : PinnedTabIds(it->pinned)) {
+    gone.insert(std::move(id));
+  }
+  State next = state;
+  next.spaces.erase(next.spaces.begin() + index);
+  std::erase_if(next.tabs,
+                [&](const auto& entry) { return gone.contains(entry.first); });
+  if (state.active_space_id == space_id) {
+    next.active_space_id =
+        next.spaces[std::min(index, next.spaces.size() - 1)].id;
+  }
+  return next;
+}
+
+State FocusOrOpen(const State& state,
+                  std::string_view url,
+                  std::string_view title,
+                  double now,
+                  const TabId& id) {
+  auto has_url = [&](const TabId& tab_id) {
+    auto tab = state.tabs.find(tab_id);
+    return tab != state.tabs.end() && tab->second.url == url;
+  };
+  for (const Space& space : state.spaces) {
+    std::vector<TabId> ids = space.open;
+    AppendPinnedTabIds(space.pinned, ids);
+    auto found = std::ranges::find_if(ids, has_url);
+    if (found != ids.end()) {
+      return ActivateTab(SwitchSpace(state, space.id), *found, now);
+    }
+  }
+  auto essential = std::ranges::find_if(state.essentials, has_url);
+  if (essential != state.essentials.end()) {
+    return ActivateTab(state, *essential, now);
+  }
+  return OpenTab(state, url, title, now, id);
+}
+
+State CreateFolder(const State& state,
+                   std::string_view space_id,
+                   const std::optional<std::string>& parent_id,
+                   std::string_view name,
+                   const std::string& id) {
+  State next = state;
+  Space* space = MutableSpace(next, space_id);
+  if (!space ||
+      !InsertPinned(space->pinned, parent_id, kEnd,
+                    PinnedNode::Folder(id, std::string(name), true, {}))) {
+    return state;
+  }
+  return next;
+}
+
+State RenameFolder(const State& state,
+                   std::string_view folder_id,
+                   std::string_view name) {
+  State next = state;
+  for (Space& space : next.spaces) {
+    ForEachFolder(space.pinned, [&](PinnedNode& folder) {
+      if (folder.id == folder_id) {
+        folder.name = name;
+      }
+    });
+  }
+  return next;
+}
+
+State ToggleFolder(const State& state, std::string_view folder_id) {
+  State next = state;
+  for (Space& space : next.spaces) {
+    ForEachFolder(space.pinned, [&](PinnedNode& folder) {
+      if (folder.id == folder_id) {
+        folder.open = !folder.open;
+      }
+    });
+  }
+  return next;
+}
+
+State UngroupFolder(const State& state, std::string_view folder_id) {
+  std::optional<Detached> detached = Detach(state, folder_id);
+  if (!detached || !detached->node.is_folder() ||
+      detached->from.area != Place::Area::kPinned) {
+    return state;
+  }
+  const Place& from = detached->from;
+  State next = std::move(detached->state);
+  Space* space = MutableSpace(next, from.space_id);
+  if (!space) {
+    return state;
+  }
+  for (size_t offset = 0; offset < detached->node.children.size(); ++offset) {
+    if (!InsertPinned(space->pinned, from.parent_id, from.index + offset,
+                      detached->node.children[offset])) {
+      return state;
+    }
+  }
+  return next;
+}
+
+std::optional<State> GroupIntoFolder(const State& state,
+                                     std::string_view target_id,
+                                     std::string_view dragged_id,
+                                     std::string_view name,
+                                     const std::string& id) {
+  if (target_id == dragged_id ||
+      !state.tabs.contains(std::string(target_id)) ||
+      !state.tabs.contains(std::string(dragged_id)) ||
+      std::ranges::contains(state.essentials, target_id)) {
+    return std::nullopt;
+  }
+  std::optional<Detached> dragged = Detach(state, dragged_id);
+  std::optional<Detached> target =
+      dragged ? Detach(dragged->state, target_id) : std::nullopt;
+  if (!target || target->from.area == Place::Area::kEssentials) {
+    return std::nullopt;
+  }
+  const Place& from = target->from;
+  State next = std::move(target->state);
+  Space* space = MutableSpace(next, from.space_id);
+  if (!space) {
+    return std::nullopt;
+  }
+  PinnedNode folder = PinnedNode::Folder(
+      id, std::string(name), true,
+      {std::move(target->node), std::move(dragged->node)});
+  const bool inserted =
+      from.area == Place::Area::kPinned
+          ? InsertPinned(space->pinned, from.parent_id, from.index,
+                         std::move(folder))
+          : InsertPinned(space->pinned, std::nullopt,
+                         static_cast<double>(space->pinned.size()),
+                         std::move(folder));
+  if (!inserted) {
+    return std::nullopt;
+  }
+  return next;
+}
+
+State ArchiveStale(const State& state,
+                   double now,
+                   double max_age_ms,
+                   const std::set<TabId>& keep) {
+  std::vector<ArchivedTab> archived;
+  State next = state;
+  for (Space& space : next.spaces) {
+    std::erase_if(space.open, [&](const TabId& id) {
+      if (space.active_tab_id == id || keep.contains(id)) {
+        return false;
+      }
+      auto tab = state.tabs.find(id);
+      if (tab == state.tabs.end() || !tab->second.last_active_at ||
+          !(now - *tab->second.last_active_at > max_age_ms)) {
+        return false;
+      }
+      archived.push_back(ArchivedTab{tab->second, space.id, now});
+      return true;
+    });
+  }
+  if (archived.empty()) {
+    return state;
+  }
+  for (const ArchivedTab& gone : archived) {
+    next.tabs.erase(gone.tab.id);
+  }
+  archived.insert(archived.end(), state.archive.begin(), state.archive.end());
+  if (archived.size() > kArchiveLimit) {
+    archived.resize(kArchiveLimit);
+  }
+  next.archive = std::move(archived);
+  return next;
+}
+
+State RestoreArchived(const State& state, std::string_view tab_id, double now) {
+  auto entry = std::ranges::find_if(state.archive, [&](const ArchivedTab& a) {
+    return a.tab.id == tab_id;
+  });
+  if (entry == state.archive.end()) {
+    return state;
+  }
+  const std::string space_id =
+      FindSpace(state, entry->space_id) ? entry->space_id
+                                        : state.active_space_id;
+  State next = state;
+  Tab tab = entry->tab;
+  tab.last_active_at = now;
+  next.tabs[tab.id] = tab;
+  std::erase_if(next.archive,
+                [&](const ArchivedTab& a) { return a.tab.id == tab_id; });
+  next.active_space_id = space_id;
+  if (Space* space = MutableSpace(next, space_id)) {
+    space->open.insert(space->open.begin(), tab.id);
+    space->active_tab_id = tab.id;
+  }
+  return next;
+}
+
+State RevealTab(const State& state, std::string_view tab_id, double now) {
+  if (!state.tabs.contains(std::string(tab_id))) {
+    return state;
+  }
+  if (std::ranges::contains(state.essentials, tab_id)) {
+    return ActivateTab(state, tab_id, now);
+  }
+  const Space* space = nullptr;
+  for (const Space& candidate : state.spaces) {
+    if (std::ranges::contains(candidate.open, tab_id) ||
+        std::ranges::contains(PinnedTabIds(candidate.pinned), tab_id)) {
+      space = &candidate;
+      break;
+    }
+  }
+  if (!space) {
+    return state;
+  }
+  std::set<std::string> to_open;
+  AppendHolding(space->pinned, tab_id, to_open);
+  const std::string space_id = space->id;
+  State opened = state;
+  ForEachFolder(MutableSpace(opened, space_id)->pinned,
+                [&](PinnedNode& folder) {
+                  if (to_open.contains(folder.id)) {
+                    folder.open = true;
+                  }
+                });
+  return ActivateTab(SwitchSpace(opened, space_id), tab_id, now);
+}
+
+std::vector<TabId> VisibleTabOrder(const State& state) {
+  const Space& space = ActiveSpace(state);
+  std::vector<TabId> order = state.essentials;
+  AppendVisiblePinned(space.pinned, order);
+  order.insert(order.end(), space.open.begin(), space.open.end());
+  return order;
+}
+
+State StepTab(const State& state, int step, double now) {
+  std::vector<TabId> order = VisibleTabOrder(state);
+  if (order.empty()) {
+    return state;
+  }
+  const int count = static_cast<int>(order.size());
+  const std::optional<TabId>& active = ActiveSpace(state).active_tab_id;
+  std::optional<size_t> current =
+      active ? IndexOf(order, *active) : std::nullopt;
+  const int next = !current ? (step == 1 ? 0 : count - 1)
+                            : (static_cast<int>(*current) + step + count) % count;
+  return ActivateTab(state, order[static_cast<size_t>(next)], now);
+}
+
+base::DictValue ToValue(const State& state) {
+  base::DictValue value;
+  value.Set("version", 1);
+  base::DictValue tabs;
+  for (const auto& [id, tab] : state.tabs) {
+    tabs.Set(id, TabToValue(tab));
+  }
+  value.Set("tabs", std::move(tabs));
+  value.Set("essentials", StringsToValue(state.essentials));
+  base::ListValue spaces;
+  for (const Space& space : state.spaces) {
+    base::DictValue s;
+    s.Set("id", space.id);
+    s.Set("name", space.name);
+    s.Set("hue", space.hue);
+    s.Set("planet", space.planet);
+    s.Set("scheme", space.scheme);
+    base::ListValue pinned;
+    for (const PinnedNode& node : space.pinned) {
+      pinned.Append(NodeToValue(node));
+    }
+    s.Set("pinned", std::move(pinned));
+    s.Set("open", StringsToValue(space.open));
+    if (space.active_tab_id) {
+      s.Set("activeTabId", *space.active_tab_id);
+    } else {
+      s.Set("activeTabId", base::Value());
+    }
+    spaces.Append(std::move(s));
+  }
+  value.Set("spaces", std::move(spaces));
+  value.Set("activeSpaceId", state.active_space_id);
+  base::ListValue archive;
+  for (const ArchivedTab& archived : state.archive) {
+    base::DictValue a;
+    a.Set("tab", TabToValue(archived.tab));
+    a.Set("spaceId", archived.space_id);
+    a.Set("archivedAt", archived.archived_at);
+    archive.Append(std::move(a));
+  }
+  value.Set("archive", std::move(archive));
+  return value;
+}
+
+std::optional<State> ImportState(const base::Value& value) {
+  if (!value.is_dict()) {
+    return std::nullopt;
+  }
+  const base::DictValue& dict = value.GetDict();
+  std::optional<int> version = dict.FindInt("version");
+  const std::string* active = dict.FindString("activeSpaceId");
+  std::optional<std::vector<std::string>> essentials =
+      ParseStrings(dict.Find("essentials"));
+  const base::DictValue* tabs = dict.FindDict("tabs");
+  const base::ListValue* spaces = dict.FindList("spaces");
+  if (version != 1 || !active || !essentials || !tabs || !spaces) {
+    return std::nullopt;
+  }
+  State state;
+  state.active_space_id = *active;
+  state.essentials = std::move(*essentials);
+  if (const base::Value* archive = dict.Find("archive")) {
+    if (!archive->is_list()) {
+      return std::nullopt;
+    }
+    for (const base::Value& item : archive->GetList()) {
+      const base::DictValue* a = item.GetIfDict();
+      const base::Value* tab_value = a ? a->Find("tab") : nullptr;
+      std::optional<Tab> tab =
+          tab_value ? ParseTab(*tab_value, std::nullopt) : std::nullopt;
+      const std::string* space_id = a ? a->FindString("spaceId") : nullptr;
+      const base::Value* at = a ? a->Find("archivedAt") : nullptr;
+      std::optional<double> archived_at = at ? at->GetIfDouble() : std::nullopt;
+      if (!tab || !space_id || !archived_at) {
+        return std::nullopt;
+      }
+      state.archive.push_back(ArchivedTab{*tab, *space_id, *archived_at});
+    }
+  }
+  for (const auto [id, tab_value] : *tabs) {
+    std::optional<Tab> tab = ParseTab(tab_value, id);
+    if (!tab) {
+      return std::nullopt;
+    }
+    state.tabs[id] = std::move(*tab);
+  }
+  for (const base::Value& item : *spaces) {
+    std::optional<Space> space = ParseSpace(item);
+    if (!space) {
+      return std::nullopt;
+    }
+    state.spaces.push_back(std::move(*space));
+  }
+  // Every tab in exactly one place, and every place a tab.
+  std::vector<TabId> placed = state.essentials;
+  for (const Space& space : state.spaces) {
+    placed.insert(placed.end(), space.open.begin(), space.open.end());
+    AppendPinnedTabIds(space.pinned, placed);
+  }
+  std::set<TabId> unique(placed.begin(), placed.end());
+  if (unique.size() != placed.size() || placed.size() != state.tabs.size() ||
+      !std::ranges::all_of(placed, [&](const TabId& id) {
+        return state.tabs.contains(id);
+      })) {
+    return std::nullopt;
+  }
+  if (!FindSpace(state, state.active_space_id)) {
+    return std::nullopt;
+  }
+  return WithoutAlphaPages(std::move(state));
+}
+
+std::optional<State> ImportStateJson(std::string_view json) {
+  std::optional<base::Value> value =
+      base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  if (!value) {
+    return std::nullopt;
+  }
+  return ImportState(*value);
+}
+
+}  // namespace loka
