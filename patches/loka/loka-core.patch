+#ifndef COMPONENTS_LOKA_CORE_SPACES_MODEL_H_
+#define COMPONENTS_LOKA_CORE_SPACES_MODEL_H_
+
+#include <limits>
+#include <map>
+#include <optional>
+#include <set>
+#include <string>
+#include <string_view>
+#include <utility>
