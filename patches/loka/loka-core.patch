+// Copyright 2026 The Loka Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "components/loka/core/spaces_model.h"
+
+#include <algorithm>
+#include <cmath>
+#include <functional>
+#include <utility>
+
+#include "base/check.h"
+#include "base/json/json_reader.h"
+#include "base/strings/string_util.h"
+
+namespace loka {
+
+namespace {
+
+constexpr std::string_view kPlanets[] = {"banded", "ringed", "cratered",
+                                         "ocean"};
+constexpr std::string_view kSchemes[] = {"light", "dark", "system"};
+// The 0.1.0 alpha's sidebar was an extension with this id.
+constexpr std::string_view kAlphaExtensionId =
+    "kklllonkklkjgekkpeboddibgbjadkej";
+
+// Math.max(0, Math.min(index, length)).
+size_t Clamp(double index, size_t length) {
+  if (!(index > 0)) {
+    return 0;
+  }
+  if (index >= static_cast<double>(length)) {
+    return length;
+  }
+  return static_cast<size_t>(index);
+}
+
+Space* MutableSpace(State& state, std::string_view space_id) {
+  for (Space& space : state.spaces) {
+    if (space.id == space_id) {
+      return &space;
+    }
+  }
+  return nullptr;
+}
+
+template <typename T>
+std::optional<size_t> IndexOf(const std::vector<T>& list,
+                              std::string_view value) {
+  auto it = std::ranges::find(list, value);
+  if (it == list.end()) {
+    return std::nullopt;
+  }
+  return static_cast<size_t>(it - list.begin());
+}
+
+// Applies `update` to every folder, inside out, as mapFolders does.
+void ForEachFolder(std::vector<PinnedNode>& nodes,
+                   const std::function<void(PinnedNode&)>& update) {
+  for (PinnedNode& node : nodes) {
+    if (!node.is_folder()) {
+      continue;
+    }
+    ForEachFolder(node.children, update);
+    update(node);
+  }
+}
+
+bool ContainsFolder(const PinnedNode& folder, std::string_view folder_id) {
+  return FindFolder(std::vector<PinnedNode>{folder}, folder_id) != nullptr;
+}
+
+struct DetachedPinned {
+  PinnedNode node;
+  std::optional<std::string> parent_id;
+  size_t index = 0;
+};
+
+std::optional<DetachedPinned> DetachPinned(
+    std::vector<PinnedNode>& nodes,
+    std::string_view id,
+    const std::optional<std::string>& parent_id) {
+  for (size_t i = 0; i < nodes.size(); ++i) {
+    if (nodes[i].id == id) {
+      PinnedNode node = std::move(nodes[i]);
+      nodes.erase(nodes.begin() + i);
+      return DetachedPinned{std::move(node), parent_id, i};
+    }
+  }
+  for (PinnedNode& node : nodes) {
+    if (!node.is_folder()) {
+      continue;
+    }
+    if (auto found = DetachPinned(node.children, id, node.id)) {
+      return found;
+    }
+  }
+  return std::nullopt;
+}
+
+// Inserts `node` at `index` of the folder `parent_id` (the top when nullopt),
+// opening that folder. False when there's no such folder.
+bool InsertPinned(std::vector<PinnedNode>& nodes,
+                  const std::optional<std::string>& parent_id,
+                  double index,
+                  PinnedNode node) {
+  if (!parent_id) {
+    nodes.insert(nodes.begin() + Clamp(index, nodes.size()), std::move(node));
+    return true;
+  }
+  bool inserted = false;
+  ForEachFolder(nodes, [&](PinnedNode& folder) {
+    if (folder.id != *parent_id) {
+      return;
+    }
+    inserted = true;
+    folder.open = true;
+    folder.children.insert(
+        folder.children.begin() + Clamp(index, folder.children.size()),
+        node);
+  });
+  return inserted;
+}
+
+struct Detached {
+  State state;
+  PinnedNode node;
+  Place from;
+};
+
+std::optional<Detached> Detach(const State& state, std::string_view id) {
+  if (auto at = IndexOf(state.essentials, id)) {
+    Detached detached{state, PinnedNode::TabNode(std::string(id)),
+                      Place::Essentials(*at)};
+    detached.state.essentials.erase(detached.state.essentials.begin() + *at);
+    return detached;
+  }
+  for (size_t s = 0; s < state.spaces.size(); ++s) {
+    const Space& space = state.spaces[s];
+    if (auto at = IndexOf(space.open, id)) {
+      Detached detached{state, PinnedNode::TabNode(std::string(id)),
+                        Place::Open(space.id, *at)};
+      std::vector<TabId>& open = detached.state.spaces[s].open;
+      open.erase(open.begin() + *at);
+      return detached;
+    }
+    State next = state;
+    if (auto found = DetachPinned(next.spaces[s].pinned, id, std::nullopt)) {
+      Place from = Place::Pinned(space.id, found->parent_id, found->index);
+      return Detached{std::move(next), std::move(found->node), from};
+    }
+  }
+  return std::nullopt;
+}
+
+bool SameContainer(const Place& a, const Place& b) {
+  if (a.area != b.area) {
+    return false;
+  }
+  switch (a.area) {
+    case Place::Area::kEssentials:
+      return true;
+    case Place::Area::kOpen:
+      return a.space_id == b.space_id;
+    case Place::Area::kPinned:
+      return a.space_id == b.space_id && a.parent_id == b.parent_id;
+  }
+}
+
+void AppendPinnedTabIds(const std::vector<PinnedNode>& nodes,
+                        std::vector<TabId>& out) {
+  for (const PinnedNode& node : nodes) {
+    if (node.is_folder()) {
+      AppendPinnedTabIds(node.children, out);
+    } else {
+      out.push_back(node.id);
+    }
+  }
+}
+
+// The pinned tree's tabs in rendering order, skipping closed folders.
+void AppendVisiblePinned(const std::vector<PinnedNode>& nodes,
+                         std::vector<TabId>& out) {
+  for (const PinnedNode& node : nodes) {
+    if (!node.is_folder()) {
+      out.push_back(node.id);
+    } else if (node.open) {
+      AppendVisiblePinned(node.children, out);
+    }
+  }
+}
+
+// The folders above a tab, outermost first.
+void AppendHolding(const std::vector<PinnedNode>& nodes,
+                   std::string_view tab_id,
+                   std::set<std::string>& out) {
+  for (const PinnedNode& node : nodes) {
+    if (node.is_folder() && FolderHolds(node, tab_id)) {
+      out.insert(node.id);
+      AppendHolding(node.children, tab_id, out);
+    }
+  }
+}
+
+bool IsAlphaPage(std::string_view url) {
+  constexpr std::string_view kScheme = "chrome-extension://";
+  if (url.size() < kScheme.size() ||
+      !base::EqualsCaseInsensitiveASCII(url.substr(0, kScheme.size()),
+                                        kScheme)) {
+    return false;
+  }
+  std::string_view rest = url.substr(kScheme.size());
+  size_t end = rest.find_first_of("/?#");
+  std::string_view host = rest.substr(0, end);
+  return base::EqualsCaseInsensitiveASCII(host, kAlphaExtensionId);
+}
+
+void PruneDead(std::vector<PinnedNode>& nodes, const std::set<TabId>& dead) {
+  std::erase_if(nodes, [&](const PinnedNode& node) {
+    return !node.is_folder() && dead.contains(node.id);
+  });
+  for (PinnedNode& node : nodes) {
+    if (node.is_folder()) {
+      PruneDead(node.children, dead);
+    }
+  }
+}
+
+State WithoutAlphaPages(State state) {
+  std::set<TabId> dead;
+  for (const auto& [id, tab] : state.tabs) {
+    if (IsAlphaPage(tab.url)) {
+      dead.insert(id);
+    }
+  }
+  if (dead.empty()) {
+    return state;
+  }
+  std::erase_if(state.tabs,
+                [&](const auto& entry) { return dead.contains(entry.first); });
+  std::erase_if(state.essentials,
+                [&](const TabId& id) { return dead.contains(id); });
+  for (Space& space : state.spaces) {
+    PruneDead(space.pinned, dead);
+    std::erase_if(space.open, [&](const TabId& id) { return dead.contains(id); });
+    if (space.active_tab_id && dead.contains(*space.active_tab_id)) {
+      space.active_tab_id.reset();
+    }
+  }
+  std::erase_if(state.archive, [](const ArchivedTab& archived) {
+    return IsAlphaPage(archived.tab.url);
+  });
+  return state;
+}
+
+// ---- JSON -------------------------------------------------------------------
+
+base::DictValue TabToValue(const Tab& tab) {
+  base::DictValue value;
+  value.Set("id", tab.id);
+  value.Set("title", tab.title);
+  value.Set("url", tab.url);
+  if (tab.last_active_at) {
+    value.Set("lastActiveAt", *tab.last_active_at);
+  }
+  return value;
+}
+
+base::DictValue NodeToValue(const PinnedNode& node) {
+  base::DictValue value;
+  if (!node.is_folder()) {
+    value.Set("kind", "tab");
+    value.Set("id", node.id);
+    return value;
+  }
+  value.Set("kind", "folder");
+  value.Set("id", node.id);
+  value.Set("name", node.name);
+  value.Set("open", node.open);
+  base::ListValue children;
+  for (const PinnedNode& child : node.children) {
+    children.Append(NodeToValue(child));
+  }
+  value.Set("children", std::move(children));
+  return value;
+}
+
+base::ListValue StringsToValue(const std::vector<std::string>& strings) {
+  base::ListValue list;
+  for (const std::string& s : strings) {
+    list.Append(s);
+  }
+  return list;
+}
+
+std::optional<std::vector<std::string>> ParseStrings(const base::Value* value) {
+  if (!value || !value->is_list()) {
+    return std::nullopt;
+  }
+  std::vector<std::string> out;
+  for (const base::Value& item : value->GetList()) {
+    if (!item.is_string()) {
+      return std::nullopt;
+    }
+    out.push_back(item.GetString());
+  }
+  return out;
+}
+
+// isTab: an id (equal to `key` when given), a title and a URL; lastActiveAt
+// a number when present.
+std::optional<Tab> ParseTab(const base::Value& value,
+                            std::optional<std::string_view> key) {
+  if (!value.is_dict()) {
+    return std::nullopt;
+  }
+  const base::DictValue& dict = value.GetDict();
+  const std::string* id = dict.FindString("id");
+  const std::string* title = dict.FindString("title");
+  const std::string* url = dict.FindString("url");
+  if (!id || !title || !url || (key && *id != *key)) {
+    return std::nullopt;
+  }
+  Tab tab{*id, *title, *url, std::nullopt};
+  if (const base::Value* last = dict.Find("lastActiveAt")) {
+    std::optional<double> number = last->GetIfDouble();
+    if (!number) {
+      return std::nullopt;
+    }
+    tab.last_active_at = number;
+  }
+  return tab;
+}
+
+std::optional<PinnedNode> ParseNode(const base::Value& value) {
+  if (!value.is_dict()) {
+    return std::nullopt;
+  }
+  const base::DictValue& dict = value.GetDict();
+  const std::string* id = dict.FindString("id");
+  const std::string* kind = dict.FindString("kind");
+  if (!id) {
+    return std::nullopt;
+  }
+  if (kind && *kind == "tab") {
+    return PinnedNode::TabNode(*id);
+  }
+  const std::string* name = dict.FindString("name");
+  std::optional<bool> open = dict.FindBool("open");
+  const base::ListValue* children = dict.FindList("children");
+  if (!kind || *kind != "folder" || !name || !open || !children) {
+    return std::nullopt;
+  }
+  std::vector<PinnedNode> nodes;
+  for (const base::Value& child : *children) {
+    std::optional<PinnedNode> node = ParseNode(child);
+    if (!node) {
+      return std::nullopt;
+    }
+    nodes.push_back(std::move(*node));
+  }
+  return PinnedNode::Folder(*id, *name, *open, std::move(nodes));
+}
+
+std::optional<Space> ParseSpace(const base::Value& value) {
+  if (!value.is_dict()) {
+    return std::nullopt;
+  }
+  const base::DictValue& dict = value.GetDict();
+  const std::string* id = dict.FindString("id");
+  const std::string* name = dict.FindString("name");
+  const base::Value* hue = dict.Find("hue");
+  std::optional<double> hue_number = hue ? hue->GetIfDouble() : std::nullopt;
+  if (!id || !name || !hue_number) {
+    return std::nullopt;
+  }
+  Space space;
+  space.id = *id;
+  space.name = *name;
+  space.hue = *hue_number;
+  // Spaces from before planets and schemes have neither.
+  if (const base::Value* planet = dict.Find("planet")) {
+    if (!planet->is_string() ||
+        !std::ranges::contains(kPlanets, std::string_view(planet->GetString()))) {
+      return std::nullopt;
+    }
+    space.planet = planet->GetString();
+  }
+  if (const base::Value* scheme = dict.Find("scheme")) {
+    if (!scheme->is_string() ||
+        !std::ranges::contains(kSchemes, std::string_view(scheme->GetString()))) {
+      return std::nullopt;
+    }
+    space.scheme = scheme->GetString();
+  }
+  std::optional<std::vector<std::string>> open = ParseStrings(dict.Find("open"));
+  const base::ListValue* pinned = dict.FindList("pinned");
+  const base::Value* active = dict.Find("activeTabId");
+  if (!open || !pinned || !active || !(active->is_none() || active->is_string())) {
+    return std::nullopt;
+  }
+  space.open = std::move(*open);
+  for (const base::Value& item : *pinned) {
+    std::optional<PinnedNode> node = ParseNode(item);
+    if (!node) {
+      return std::nullopt;
+    }
+    space.pinned.push_back(std::move(*node));
+  }
+  if (active->is_string()) {
+    space.active_tab_id = active->GetString();
+  }
+  return space;
+}
+
