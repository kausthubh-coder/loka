+#ifndef COMPONENTS_LOKA_CORE_TAB_LINKS_H_
+#define COMPONENTS_LOKA_CORE_TAB_LINKS_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/functional/function_ref.h"
