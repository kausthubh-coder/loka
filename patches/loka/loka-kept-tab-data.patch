+
+void SessionServiceBase::SetKeptTabData(content::WebContents* tab,
+                                        const std::string& key,
+                                        const std::string& data) {
+  KeptTabData::For(tab).data[key] = data;
+  sessions::SessionTabHelper* helper =
+      sessions::SessionTabHelper::FromWebContents(tab);
+  if (!helper || !helper->window_id().is_valid() ||
+      !ShouldTrackChangesToWindow(helper->window_id())) {
+    return;
+  }
+  ScheduleCommand(sessions::CreateAddTabExtraDataCommand(helper->session_id(),
+                                                         key, data));
+}
+
+// static
+const std::string* SessionServiceBase::GetKeptTabData(
+    content::WebContents* tab,
+    const std::string& key) {
+  KeptTabData* kept = KeptTabData::From(tab);
+  if (!kept) {
+    return nullptr;
+  }
+  auto it = kept->data.find(key);
+  return it == kept->data.end() ? nullptr : &it->second;
+}
+
+// static
+void SessionServiceBase::CopyKeptTabData(
+    content::WebContents* tab,
+    std::map<std::string, std::string>* extra_data) {
+  if (KeptTabData* kept = KeptTabData::From(tab)) {
+    extra_data->insert(kept->data.begin(), kept->data.end());
+  }
+}
+
+// static
+void SessionServiceBase::RestoreKeptTabData(
+    content::WebContents* tab,
+    const std::map<std::string, std::string>& extra_data) {
+  for (const auto& [key, data] : extra_data) {
+    if (key.starts_with("loka.")) {
+      KeptTabData::For(tab).data[key] = data;
+    }
+  }
 }
 
