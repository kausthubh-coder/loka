+// Loka: what a tab keeps through rewrites of the session (SetKeptTabData).
+class KeptTabData : public base::SupportsUserData::Data {
+ public:
+  static const void* UserDataKey() {
+    static const char kKey = 0;
+    return &kKey;
+  }
+  static KeptTabData* From(content::WebContents* tab) {
+    return static_cast<KeptTabData*>(tab->GetUserData(UserDataKey()));
+  }
+  static KeptTabData& For(content::WebContents* tab) {
+    if (!From(tab)) {
+      tab->SetUserData(UserDataKey(), std::make_unique<KeptTabData>());
+    }
+    return *From(tab);
+  }
+
+  std::map<std::string, std::string> data;
+};
+
 }  // namespace
 
