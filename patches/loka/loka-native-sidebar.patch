+void LokaSidebarHandler::OnJavascriptAllowed() {
+  StartObserving();
+  StartObservingFeatures();
+  Profile* profile = Profile::FromWebUI(web_ui());
+  pref_change_registrar_.Init(profile->GetPrefs());
+  pref_change_registrar_.Add(
+      kLokaSidebarStorePref,
+      base::BindRepeating(&LokaSidebarHandler::OnStoreChanged,
+                          base::Unretained(this)));
+  pref_change_registrar_.Add(
+      prefs::kHeliumZenModeSidebarPinned,
+      base::BindRepeating(&LokaSidebarHandler::OnSidebarPinnedChanged,
+                          base::Unretained(this)));
+  pref_change_registrar_.Add(
+      kLokaOnboardingSpacesPref,
+      base::BindRepeating(&LokaSidebarHandler::OnStoreChanged,
+                          base::Unretained(this)));
+}
+
+void LokaSidebarHandler::OnJavascriptDisallowed() {
+  StopObservingFeatures();
+  pref_change_registrar_.RemoveAll();
+  if (observed_) {
+    observed_->RemoveObserver(this);
+    observed_ = nullptr;
+  }
+  weak_factory_.InvalidateWeakPtrs();
+  // A reloaded page starts from nothing and hears everything again.
+  watching_spaces_ = false;
+  spaces_observation_.Reset();
+  watching_tabs_ = false;
+  tabs_timer_.Stop();
+  sent_tabs_.clear();
+  sent_order_.clear();
+  sent_media_ = base::ListValue();
+  sent_extensions_ = base::ListValue();
+  sent_store_ = base::DictValue();
+}
+
+void LokaSidebarHandler::StartObserving() {
+  TabStripModel* tab_strip = GetTabStrip();
+  if (tab_strip == observed_) {
+    return;
+  }
+  if (observed_) {
+    observed_->RemoveObserver(this);
+  }
+  observed_ = tab_strip;
+  if (observed_) {
+    observed_->AddObserver(this);
+  }
+}
