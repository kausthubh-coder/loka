+// ---- Extensions -------------------------------------------------------------
+
+base::ListValue LokaSidebarHandler::ExtensionList() {
+  base::ListValue list;
+  Profile* profile = Profile::FromWebUI(web_ui());
+  ToolbarActionsModel* model = ToolbarActionsModel::Get(profile);
+  if (!model) {
+    return list;
+  }
+  auto* registry = extensions::ExtensionRegistry::Get(profile);
+  auto* actions = extensions::ExtensionActionManager::Get(profile);
+  TabStripModel* tab_strip = GetTabStrip();
+  content::WebContents* active =
+      tab_strip ? tab_strip->GetActiveWebContents() : nullptr;
+  const int tab_id =
+      active ? extensions::ExtensionTabUtil::GetTabId(active) : -1;
+  // Pinned ones first, in the order the user pinned them, then the rest.
+  std::vector<ToolbarActionsModel::ActionId> ordered(
+      model->pinned_action_ids().begin(), model->pinned_action_ids().end());
+  for (const auto& id : model->action_ids()) {
+    if (!model->IsActionPinned(id)) {
+      ordered.push_back(id);
+    }
+  }
+  for (const auto& id : ordered) {
+    const extensions::Extension* extension =
+        registry->enabled_extensions().GetByID(id);
+    if (!extension) {
+      continue;
+    }
+    base::DictValue data;
+    data.Set("id", id);
+    data.Set("name", extension->name());
+    data.Set("icon", extensions::ExtensionIconSource::GetIconURL(
+                         extension, 32, ExtensionIconSet::Match::kBigger,
+                         /*grayscale=*/false)
+                         .spec());
+    std::string badge;
+    std::string badge_color;
+    if (extensions::ExtensionAction* action =
+            actions->GetExtensionAction(*extension)) {
+      badge = action->GetDisplayBadgeText(tab_id);
+      badge_color = CssColor(action->GetBadgeBackgroundColor(tab_id));
+    }
+    data.Set("badge", badge);
+    data.Set("badgeColor", badge_color);
+    data.Set("pinned", model->IsActionPinned(id));
+    data.Set("hasOptions", extensions::OptionsPageInfo::HasOptionsPage(
+                               extension));
+    list.Append(std::move(data));
+  }
+  return list;
+}
+
+void LokaSidebarHandler::ScheduleExtensionsChanged() {
+  if (extensions_change_pending_ || !IsJavascriptAllowed()) {
+    return;
+  }
+  extensions_change_pending_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<LokaSidebarHandler> self) {
+                       if (!self || !self->IsJavascriptAllowed()) {
+                         return;
+                       }
+                       self->extensions_change_pending_ = false;
+                       // Pages loading in other tabs update extension
+                       // actions all the time; most change nothing shown.
+                       base::ListValue list = self->ExtensionList();
+                       if (list == self->sent_extensions_) {
+                         return;
+                       }
+                       self->sent_extensions_ = list.Clone();
+                       self->FireWebUIListener("extensions-changed", list);
+                     },
+                     weak_factory_.GetWeakPtr()));
+}
