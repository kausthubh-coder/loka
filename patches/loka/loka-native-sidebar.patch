+LokaMediaWatcher::LokaMediaWatcher(content::WebContents* contents,
+                                   base::RepeatingClosure on_change)
+    : contents_(contents), on_change_(std::move(on_change)) {
+  // The session reports its current state to a new observer straight away.
+  content::MediaSession::Get(contents)->AddObserver(
+      receiver_.BindNewPipeAndPassRemote());
+}
+
+LokaMediaWatcher::~LokaMediaWatcher() = default;
+
+bool LokaMediaWatcher::IsActive() const {
+  return info_ &&
+         info_->state !=
+             media_session::mojom::MediaSessionInfo::SessionState::kInactive;
+}
+
+bool LokaMediaWatcher::IsPlaying() const {
+  return info_ && info_->playback_state ==
+                      media_session::mojom::MediaPlaybackState::kPlaying;
+}
+
+bool LokaMediaWatcher::Can(
+    media_session::mojom::MediaSessionAction action) const {
+  return std::ranges::find(actions_, action) != actions_.end();
+}
+
+std::u16string LokaMediaWatcher::title() const {
+  return metadata_ ? metadata_->title : std::u16string();
+}
+
+std::u16string LokaMediaWatcher::artist() const {
+  return metadata_ ? metadata_->artist : std::u16string();
+}
+
+void LokaMediaWatcher::MediaSessionInfoChanged(
+    media_session::mojom::MediaSessionInfoPtr info) {
+  info_ = std::move(info);
+  on_change_.Run();
+}
+
+void LokaMediaWatcher::MediaSessionMetadataChanged(
+    const std::optional<media_session::MediaMetadata>& metadata) {
+  metadata_ = metadata;
+  on_change_.Run();
+}
+
+void LokaMediaWatcher::MediaSessionActionsChanged(
+    const std::vector<media_session::mojom::MediaSessionAction>& actions) {
+  actions_ = actions;
+  on_change_.Run();
+}
+
+void LokaMediaWatcher::MediaSessionImagesChanged(
+    const base::flat_map<media_session::mojom::MediaSessionImageType,
+                         std::vector<media_session::MediaImage>>& images) {
+  const int request = ++artwork_request_;
+  auto it = images.find(media_session::mojom::MediaSessionImageType::kArtwork);
+  std::optional<media_session::MediaImage> image;
+  if (it != images.end()) {
+    image = media_session::MediaImageManager(kArtworkMinSize,
+                                             kArtworkDesiredSize)
+                .SelectImage(it->second);
+  }
+  if (!image) {
+    if (!artwork_.empty()) {
+      artwork_.clear();
+      on_change_.Run();
+    }
+    return;
+  }
+  content::MediaSession::Get(contents_)->GetMediaImageBitmap(
+      *image, kArtworkMinSize, kArtworkDesiredSize,
+      base::BindOnce(&LokaMediaWatcher::OnArtwork, weak_factory_.GetWeakPtr(),
+                     request));
+}
+
+void LokaMediaWatcher::OnArtwork(int request, const SkBitmap& bitmap) {
+  if (request != artwork_request_) {
+    return;
+  }
+  std::string artwork;
+  if (!bitmap.drawsNothing()) {
+    if (std::optional<std::vector<uint8_t>> png =
+            gfx::PNGCodec::EncodeBGRASkBitmap(bitmap,
+                                              /*discard_transparency=*/false)) {
+      artwork = "data:image/png;base64," + base::Base64Encode(*png);
+    }
+  }
+  if (artwork != artwork_) {
+    artwork_ = std::move(artwork);
+    on_change_.Run();
+  }
+}
