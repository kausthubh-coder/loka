+
+tabs::TabInterface* LokaSidebarHandler::FindTab(const base::Value& id) {
+  TabStripModel* tab_strip = GetTabStrip();
+  if (!tab_strip || !id.is_int()) {
+    return nullptr;
+  }
+  tabs::TabInterface* tab = tabs::TabHandle(id.GetInt()).Get();
+  if (!tab || tab_strip->GetIndexOfTab(tab) == TabStripModel::kNoTab) {
+    return nullptr;
+  }
+  return tab;
+}
+
+int LokaSidebarHandler::GroupNumber(const tab_groups::TabGroupId& group) {
+  auto [it, inserted] = group_numbers_.try_emplace(group, next_group_number_);
+  if (inserted) {
+    ++next_group_number_;
+  }
+  return it->second;
+}
+
+std::string LokaSidebarHandler::FaviconUrl(tabs::TabInterface* tab) {
+  gfx::ImageSkia image =
+      TabIcon(tab, web_ui()->GetWebContents()->GetColorProvider());
+  if (image.isNull()) {
+    return std::string();
+  }
+  const float scale = web_ui()->GetDeviceScaleFactor();
+  // A new picture gets a new address, so no image cache shows an old one;
+  // the same picture keeps its address, so the row doesn't load it again.
+  // Icons drawn from vector art are new objects each time, hence the pixels.
+  static int next_version = 0;
+  auto [it, inserted] = favicons_.try_emplace(TabId(tab), image, 0);
+  auto& [cached, version] = it->second;
+  if (inserted || (!cached.BackedBySameObjectAs(image) &&
+                   !gfx::BitmapsAreEqual(
+                       cached.GetRepresentation(scale).GetBitmap(),
+                       image.GetRepresentation(scale).GetBitmap()))) {
+    version = ++next_version;
+  }
+  cached = image;
+  return base::StrCat({kLokaSidebarURL, kTabIconPath,
+                       base::NumberToString(TabId(tab)), "-",
+                       base::NumberToString(version), "@",
+                       base::NumberToString(base::ClampRound(scale * 100)),
+                       ".png"});
+}
+
+base::DictValue LokaSidebarHandler::TabData(tabs::TabInterface* tab,
+                                             int index) {
+  TabStripModel* tab_strip = GetTabStrip();
+  content::WebContents* contents = tab->GetContents();
+  TabUIHelper* helper = TabUIHelper::From(tab);
+  GURL url = helper ? helper->GetLastCommittedURL() : GURL();
+  if ((!url.is_valid() || url.is_empty()) && helper) {
+    url = helper->GetVisibleURL();
+  }
+  // No index: a tab opened at the front would change every tab's, and the
+  // tabs' order travels on its own ("order" in TabChanges).
+  base::DictValue data;
+  data.Set("id", TabId(tab));
+  data.Set("url", url.spec());
+  data.Set("title",
+           helper ? base::UTF16ToUTF8(helper->GetTitle()) : std::string());
+  data.Set("favicon", FaviconUrl(tab));
+  data.Set("active", tab_strip->active_index() == index);
+  data.Set("pinned", tab->IsPinned());
+  data.Set("loading", contents->IsLoading());
+  data.Set("audible", contents->IsCurrentlyAudible());
+  data.Set("muted", contents->IsAudioMuted());
+  // Unloaded to save memory (LokaTabSleeper, Memory Saver): it loads again
+  // when shown.
+  data.Set("discarded", contents->WasDiscarded());
+  const std::optional<tab_groups::TabGroupId> group = tab->GetGroup();
+  data.Set("groupId", group ? GroupNumber(*group) : -1);
+  if (tabs::TabInterface* opener = tab_strip->GetOpenerOfTabAt(index)) {
+    data.Set("openerId", TabId(opener));
+  }
+  data.Set("lastAccessed",
+           contents->GetLastActiveTime().InMillisecondsFSinceUnixEpoch());
+  return data;
+}
+
+base::ListValue LokaSidebarHandler::TabList() {
+  base::ListValue tabs;
+  TabStripModel* tab_strip = GetTabStrip();
+  if (!tab_strip) {
+    return tabs;
+  }
+  std::set<int32_t> ids;
+  for (int i = 0; i < tab_strip->count(); ++i) {
+    tabs.Append(TabData(tab_strip->GetTabAtIndex(i), i));
+    ids.insert(TabId(tab_strip->GetTabAtIndex(i)));
+  }
+  std::erase_if(favicons_, [&ids](const auto& entry) {
+    return !ids.contains(entry.first);
+  });
+  return tabs;
+}
+
+base::DictValue LokaSidebarHandler::TabChanges() {
+  base::DictValue changes;
+  TabStripModel* tab_strip = GetTabStrip();
+  std::map<int32_t, base::DictValue> now;
+  std::vector<int32_t> order;
+  base::ListValue changed;
+  for (int i = 0; tab_strip && i < tab_strip->count(); ++i) {
+    tabs::TabInterface* tab = tab_strip->GetTabAtIndex(i);
+    base::DictValue data = TabData(tab, i);
+    auto heard = sent_tabs_.find(TabId(tab));
+    if (heard == sent_tabs_.end() || heard->second != data) {
+      changed.Append(data.Clone());
+    }
+    order.push_back(TabId(tab));
+    now.emplace(TabId(tab), std::move(data));
+  }
+  base::ListValue removed;
+  for (const auto& [id, data] : sent_tabs_) {
+    if (!now.contains(id)) {
+      removed.Append(id);
+    }
+  }
+  if (!changed.empty()) {
+    changes.Set("tabs", std::move(changed));
+  }
+  if (!removed.empty()) {
+    changes.Set("removed", std::move(removed));
+  }
+  if (order != sent_order_) {
+    base::ListValue ids;
+    for (int32_t id : order) {
+      ids.Append(id);
+    }
+    changes.Set("order", std::move(ids));
+  }
+  std::erase_if(favicons_, [&now](const auto& entry) {
+    return !now.contains(entry.first);
+  });
+  sent_tabs_ = std::move(now);
+  sent_order_ = std::move(order);
+  return changes;
+}
+
+base::ListValue LokaSidebarHandler::GroupList() {
+  base::ListValue groups;
+  TabStripModel* tab_strip = GetTabStrip();
+  if (!tab_strip || !tab_strip->group_model()) {
+    return groups;
+  }
+  for (const tab_groups::TabGroupId& id :
+       tab_strip->group_model()->ListTabGroups()) {
+    const TabGroup* group = tab_strip->group_model()->GetTabGroup(id);
+    base::DictValue data;
+    data.Set("id", GroupNumber(id));
+    data.Set("title", base::UTF16ToUTF8(group->visual_data()->title()));
+    data.Set("collapsed", group->visual_data()->is_collapsed());
+    groups.Append(std::move(data));
+  }
+  return groups;
+}
+
+base::DictValue LokaSidebarHandler::StoreValue() {
+  Profile* profile = Profile::FromWebUI(web_ui());
+  base::DictValue store =
+      profile->GetPrefs()->GetDict(kLokaSidebarStorePref).Clone();
+  // What setup saved rides along, read-only, so the sidebar can take it in.
+  const std::string& onboarding =
+      profile->GetPrefs()->GetString(kLokaOnboardingSpacesPref);
+  if (!onboarding.empty()) {
+    store.Set("onboarding", onboarding);
+  }
+  return store;
+}
