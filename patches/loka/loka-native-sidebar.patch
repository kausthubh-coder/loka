+  ResolveJavascriptCallback(args[0], DownloadList());
+}
+
+void LokaSidebarHandler::HandleDownloadAction(const base::ListValue& args) {
+  if (args.size() < 2 || !args[0].is_int() || !args[1].is_string()) {
+    return;
+  }
+  Profile* profile = Profile::FromWebUI(web_ui());
+  content::DownloadManager* manager = profile->GetDownloadManager();
+  download::DownloadItem* item =
+      manager ? manager->GetDownload(static_cast<uint32_t>(args[0].GetInt()))
+              : nullptr;
+  if (!item) {
+    return;
+  }
+  const std::string& action = args[1].GetString();
+  if (action == "open" &&
+      item->GetState() == download::DownloadItem::COMPLETE) {
+    item->OpenDownload();
+  } else if (action == "show") {
+    platform_util::ShowItemInFolder(profile, item->GetTargetFilePath());
+  } else if (action == "pause") {
+    item->Pause();
+  } else if (action == "resume" || action == "retry") {
+    if (item->CanResume()) {
+      item->Resume(/*user_resume=*/true);
+    }
+  } else if (action == "cancel") {
+    item->Cancel(/*user_cancel=*/true);
+  } else if (action == "remove") {
+    item->Remove();
+  }
+}
