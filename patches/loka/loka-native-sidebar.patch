+// sidebar's built-in command bar takes the commands.
+bool HasCommandBarPage() {
+  return std::ranges::any_of(kLokaSidebarGenerated, [](const auto& resource) {
+    return std::string_view(resource.path) == "command.html";
+  });
+}
+
+constexpr size_t kMaxDownloads = 30;
+
+std::string CssColor(SkColor color) {
+  if (SkColorGetA(color) == 0) {
+    return std::string();
+  }
+  return base::StringPrintf("rgb(%d %d %d)", SkColorGetR(color),
+                            SkColorGetG(color), SkColorGetB(color));
+}
+
+std::string DownloadState(const download::DownloadItem& item) {
+  switch (item.GetState()) {
+    case download::DownloadItem::IN_PROGRESS:
+      return item.IsPaused() ? "paused" : "running";
+    case download::DownloadItem::COMPLETE:
+      return "complete";
+    case download::DownloadItem::CANCELLED:
+      return "cancelled";
+    case download::DownloadItem::INTERRUPTED:
+    case download::DownloadItem::MAX_DOWNLOAD_STATE:
+      return "failed";
+  }
+  return "failed";
+}
+
+std::string SuggestionKind(const AutocompleteMatch& match) {
+  if (match.has_tab_match.value_or(false) ||
+      match.type == AutocompleteMatchType::OPEN_TAB) {
+    return "tab";
+  }
+  if (AutocompleteMatch::IsSearchType(match.type)) {
+    return "search";
+  }
+  switch (match.type) {
+    case AutocompleteMatchType::BOOKMARK_TITLE:
+      return "bookmark";
+    case AutocompleteMatchType::HISTORY_URL:
+    case AutocompleteMatchType::HISTORY_TITLE:
+    case AutocompleteMatchType::HISTORY_BODY:
+    case AutocompleteMatchType::HISTORY_KEYWORD:
+      return "history";
+    default:
+      return "url";
+  }
+}
