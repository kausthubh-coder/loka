+
+// A page loading in the background changes its title, icon and spinner many
+// times a second; the sidebar hears about them at most once a frame.
+constexpr base::TimeDelta kTabsBatch = base::Milliseconds(16);
+
+// FaviconUrl's addresses: tab-icon/<tab id>-<version>@<scale %>.png.
+constexpr char kTabIconPath[] = "tab-icon/";
+
+// The tab's icon as the browser draws it, or nothing when that would be the
+// stand-in globe: the page shows its own fallback for that.
+gfx::ImageSkia TabIcon(tabs::TabInterface* tab,
+                       const ui::ColorProvider& provider) {
+  TabUIHelper* helper = TabUIHelper::From(tab);
+  if (!helper || !helper->ShouldDisplayFavicon()) {
+    return gfx::ImageSkia();
+  }
+  const ui::ImageModel favicon = helper->GetFavicon();
+  if (favicon.IsEmpty()) {
+    return gfx::ImageSkia();
+  }
+  gfx::ImageSkia image = favicon.Rasterize(&provider);
+  if (image.BackedBySameObjectAs(
+          favicon::GetDefaultFaviconModel().Rasterize(&provider))) {
+    return gfx::ImageSkia();
+  }
+  return image;
+}
