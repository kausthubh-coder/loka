+LokaSidebarUIConfig::LokaSidebarUIConfig()
+    : DefaultTopChromeWebUIConfig(content::kChromeUIScheme, kLokaSidebarHost) {}
+
+LokaSidebarUI::LokaSidebarUI(content::WebUI* web_ui)
+    : TopChromeWebUIController(web_ui, /*enable_chrome_send=*/true) {
+  Profile* profile = Profile::FromWebUI(web_ui);
+  content::WebUIDataSource* source =
+      content::WebUIDataSource::CreateAndAdd(profile, kLokaSidebarHost);
+  webui::SetupWebUIDataSource(source, kLokaSidebarGenerated,
+                              IDR_LOKA_SIDEBAR_SIDEBAR_HTML);
+  // Lit renders with template elements, not innerHTML, but its build keeps a
+  // policy name around; allow it so nothing trips over Trusted Types.
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::TrustedTypes,
+      "trusted-types lit-html;");
+  // Favicons of tabs that aren't loaded come from the browser's favicon cache.
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ImgSrc,
+      "img-src chrome://favicon2 chrome://theme data: blob: 'self';");
+  // Each space's hue is set as an inline style (--hue) on its elements.
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::StyleSrc,
+      "style-src 'self' 'unsafe-inline';");
+
+  content::URLDataSource::Add(
+      profile, std::make_unique<FaviconSource>(
+                   profile, chrome::FaviconUrlFormat::kFavicon2));
+  content::URLDataSource::Add(profile, std::make_unique<ThemeSource>(profile));
+
+  web_ui->AddMessageHandler(std::make_unique<LokaSidebarHandler>());
+}
+
+LokaSidebarUI::~LokaSidebarUI() = default;
+
+// static
+void LokaSidebarUI::RegisterProfilePrefs(
+    user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterDictionaryPref(kLokaSidebarStorePref);
+}
