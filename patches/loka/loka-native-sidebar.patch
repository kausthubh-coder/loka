+void LokaSidebarHandler::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  ScheduleTabsChanged();
+}
+
+void LokaSidebarHandler::OnTabChangedAt(tabs::TabInterface* tab,
+                                        TabChangeType change_type) {
+  ScheduleTabsChanged();
+}
+
+void LokaSidebarHandler::OnTabGroupChanged(const TabGroupChange& change) {
+  ScheduleTabsChanged();
+}
+
+void LokaSidebarHandler::ScheduleTabsChanged() {
+  if (tabs_change_pending_ || !IsJavascriptAllowed()) {
+    return;
+  }
+  tabs_change_pending_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&LokaSidebarHandler::SendTabsChanged,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void LokaSidebarHandler::SendTabsChanged() {
+  tabs_change_pending_ = false;
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  // The sidebar can be moved to another window's panel; follow it.
+  StartObserving();
+  FireWebUIListener("tabs-changed", TabList());
+}
+
+void LokaSidebarHandler::OnStoreChanged() {
+  FireWebUIListener("store-changed", StoreValue());
+}
