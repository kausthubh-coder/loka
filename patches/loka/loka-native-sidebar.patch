+// static
+bool LokaNewTabUIConfig::RewriteURL(GURL* url,
+                                    content::BrowserContext* context) {
+  // Loka: chrome://new-tab-page too, where Chrome's own page would go, so
+  // nothing reaches Chrome's or Helium's new tab page. In incognito as well.
+  if (!url->SchemeIs(content::kChromeUIScheme) ||
+      (url->host() != chrome::kChromeUINewTabHost &&
+       url->host() != chrome::kChromeUINewTabPageHost)) {
+    return false;
+  }
+  *url = GURL(kLokaNewTabURL);
+  return true;
+}
+
+// static
+bool LokaNewTabUIConfig::ReverseRewriteURL(GURL* url,
+                                           content::BrowserContext* context) {
+  if (!url->SchemeIs(content::kChromeUIScheme) ||
+      url->host() != kLokaNewTabHost) {
+    return false;
+  }
+  *url = GURL(chrome::kChromeUINewTabURL);
+  return true;
