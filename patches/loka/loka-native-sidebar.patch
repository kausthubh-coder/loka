+// Unloads the tabs of spaces no window is showing. Each window keeps every
+// other space's tabs in a folded tab group; a loaded tab in a folded group that
+// nobody has seen for the time set in Settings (30 minutes unless changed) is
+// discarded the way Memory Saver does it. It keeps its Back history, title and
+// icon and loads again when opened. Chromium's own rules still apply, so tabs
+// playing sound, sharing the camera, mic or screen, or holding typed form input
+// stay loaded. One per profile, made by the first sidebar.
+class LokaTabSleeper : public base::SupportsUserData::Data,
+                       public ProfileObserver {
+ public:
+  static void EnsureForProfile(Profile* profile);
+
+  // How long a tab must have been out of sight, from the sidebar's settings
+  // (the "ui.v1" JSON in the loka.store pref): its sleepAfterMinutes, where 0
+  // is never. Nullopt for never.
+  static std::optional<base::TimeDelta> SleepAfter(std::string_view ui_json);
+
+  explicit LokaTabSleeper(Profile* profile);
+  LokaTabSleeper(const LokaTabSleeper&) = delete;
+  LokaTabSleeper& operator=(const LokaTabSleeper&) = delete;
+  ~LokaTabSleeper() override;
+
+  // ProfileObserver: the profile's prefs go before its user data (this), so
+  // stop watching them then.
+  void OnProfileWillBeDestroyed(Profile* profile) override;
+
+ private:
+  void Sweep();
+  // Sweeps at once when the setting changes, not only on the next tick.
+  void OnStoreChanged();
+
+  raw_ptr<Profile> profile_;
+  base::RepeatingTimer timer_;
+  PrefChangeRegistrar store_;
+  std::string ui_json_;
+};
