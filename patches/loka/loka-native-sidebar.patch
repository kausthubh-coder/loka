+BrowserWindowInterface* LokaSidebarHandler::GetBrowser() {
+  content::WebContents* contents = web_ui()->GetWebContents();
+  if (BrowserWindowInterface* browser =
+          webui::GetBrowserWindowInterface(contents)) {
+    return browser;
+  }
+  // Loka's Settings page is a tab, not part of the window's chrome.
+  tabs::TabInterface* tab = tabs::TabInterface::MaybeGetFromContents(contents);
+  return tab ? tab->GetBrowserWindowInterface() : nullptr;
+}
