+// ---- Address field suggestions ----------------------------------------------
+
+void LokaSidebarHandler::HandleSuggest(const base::ListValue& args) {
+  if (args.empty() || !args[0].is_string()) {
+    return;
+  }
+  AllowJavascript();
+  Profile* profile = Profile::FromWebUI(web_ui());
+  if (!autocomplete_) {
+    autocomplete_ = std::make_unique<AutocompleteController>(
+        std::make_unique<ChromeAutocompleteProviderClient>(profile),
+        AutocompleteControllerConfig{
+            .provider_types =
+                AutocompleteClassifier::DefaultOmniboxProviders()});
+    autocomplete_->AddObserver(this);
+  }
+  suggest_query_ = args[0].GetString();
+  if (suggest_query_.empty()) {
+    autocomplete_->Stop(AutocompleteStopReason::kClobbered);
+    FireWebUIListener("suggestions", base::Value(suggest_query_),
+                      base::ListValue());
+    return;
+  }
+  AutocompleteInput input(base::UTF8ToUTF16(suggest_query_),
+                          metrics::OmniboxEventProto::OTHER,
+                          ChromeAutocompleteSchemeClassifier(profile));
+  autocomplete_->Start(input);
+}
+
+void LokaSidebarHandler::OnResultChanged(AutocompleteController* controller,
+                                         bool default_match_changed) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  base::ListValue list;
+  for (const AutocompleteMatch& match : controller->result()) {
+    if (!match.destination_url.is_valid()) {
+      continue;
+    }
+    base::DictValue data;
+    const std::string kind = SuggestionKind(match);
+    data.Set("kind", kind);
+    // A search's description is the engine's name; its contents are the words.
+    const std::u16string& title =
+        kind == "search" || match.description.empty() ? match.contents
+                                                       : match.description;
+    data.Set("title", base::UTF16ToUTF8(title));
+    data.Set("url", match.destination_url.spec());
+    list.Append(std::move(data));
+  }
+  FireWebUIListener("suggestions", base::Value(suggest_query_), list);
+}
