@@ -0,0 +1,168 @@
+// Copyright 2026 The Loka Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/loka/loka_command_bar.h"
+
+#include <algorithm>
+#include <map>
+
+#include "base/no_destructor.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/webui/loka_sidebar/loka_sidebar_handler.h"
+#include "chrome/browser/ui/webui/loka_sidebar/loka_sidebar_ui.h"
+#include "chrome/browser/ui/webui/webui_embedding_context.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/views/controls/webview/web_contents_set_background_color.h"
+#include "ui/views/controls/webview/webview.h"
+#include "url/gurl.h"
+
+namespace {
+
+// The bar's window: wide enough for long titles, tall enough for nine
+// results. The page draws the bar at the top of it and leaves the rest clear.
+constexpr int kWidth = 680;
+constexpr int kHeight = 520;
+
+std::map<BrowserWindowInterface*, std::unique_ptr<LokaCommandBar>>& Bars() {
+  static base::NoDestructor<
+      std::map<BrowserWindowInterface*, std::unique_ptr<LokaCommandBar>>>
+      bars;
+  return *bars;
+}
+
+}  // namespace
+
+// static
+void LokaCommandBar::Show(BrowserWindowInterface* browser,
+                          const std::string& command) {
+  auto& bar = Bars()[browser];
+  if (!bar) {
+    bar.reset(new LokaCommandBar(browser));
+  }
+  bar->ShowWith(command);
+}
+
+// static
+void LokaCommandBar::Hide(BrowserWindowInterface* browser) {
+  if (auto it = Bars().find(browser); it != Bars().end()) {
+    it->second->HideNow();
+  }
+}
+
+// static
+std::optional<std::string> LokaCommandBar::TakePendingCommand(
+    BrowserWindowInterface* browser) {
+  auto it = Bars().find(browser);
+  if (it == Bars().end()) {
+    return std::nullopt;
+  }
+  return std::exchange(it->second->pending_command_, std::nullopt);
+}
+
+LokaCommandBar::LokaCommandBar(BrowserWindowInterface* browser)
+    : browser_(browser) {
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  browser_widget_ = browser_view ? browser_view->GetWidget() : nullptr;
+  if (browser_widget_) {
+    browser_widget_observation_.Observe(browser_widget_.get());
+  }
+}
+
+LokaCommandBar::~LokaCommandBar() = default;
+
+void LokaCommandBar::EnsureWidget() {
+  if (widget_ || !browser_widget_) {
+    return;
+  }
+  widget_ = std::make_unique<views::Widget>();
+  views::Widget::InitParams params(
+      views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+      views::Widget::InitParams::TYPE_WINDOW_FRAMELESS);
+  params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+  params.parent = browser_widget_->GetNativeView();
+  params.context = browser_widget_->GetNativeWindow();
+  params.shadow_type = views::Widget::InitParams::ShadowType::kNone;
+  params.name = "LokaCommandBar";
+  widget_->Init(std::move(params));
+
+  auto web_view = std::make_unique<views::WebView>(browser_->GetProfile());
+  webui::SetBrowserWindowInterface(web_view->GetWebContents(), browser_);
+  views::WebContentsSetBackgroundColor::CreateForWebContentsWithColor(
+      web_view->GetWebContents(), SK_ColorTRANSPARENT);
+  web_view->LoadInitialURL(GURL(std::string(kLokaSidebarURL) + "command.html"));
+  web_view_ = widget_->SetContentsView(std::move(web_view));
+  widget_->SetVisibilityChangedAnimationsEnabled(false);
+  widget_observation_.Observe(widget_.get());
+}
+
+void LokaCommandBar::Place() {
+  if (!widget_ || !browser_widget_) {
+    return;
+  }
+  // Centered over the window, a fifth of the way down, like Arc's.
+  const gfx::Rect window = browser_widget_->GetWindowBoundsInScreen();
+  const int width = std::min(kWidth, window.width() - 32);
+  const int height = std::min(kHeight, window.height() - 32);
+  widget_->SetBounds(gfx::Rect(window.x() + (window.width() - width) / 2,
+                               window.y() + window.height() / 5, width,
+                               height));
+}
+
+void LokaCommandBar::ShowWith(const std::string& command) {
+  EnsureWidget();
+  if (!widget_) {
+    return;
+  }
+  Place();
+  widget_->Show();
+  widget_->Activate();
+  web_view_->RequestFocus();
+  web_view_->GetWebContents()->Focus();
+  // The page may still be loading the first time: it takes the command when
+  // it's ready. Otherwise it hears it now.
+  pending_command_ = command;
+  if (LokaSidebarHandler::DeliverCommandBarCommand(browser_, command)) {
+    pending_command_.reset();
+  }
+}
+
+void LokaCommandBar::HideNow() {
+  if (widget_ && widget_->IsVisible()) {
+    widget_->Hide();
+    if (browser_widget_) {
+      browser_widget_->Activate();
+    }
+  }
+}
+
+void LokaCommandBar::OnWidgetActivationChanged(views::Widget* widget,
+                                               bool active) {
+  // Clicking anywhere else closes it, like a menu.
+  if (widget == widget_.get() && !active) {
+    HideNow();
+  }
+}
+
+void LokaCommandBar::OnWidgetBoundsChanged(views::Widget* widget,
+                                           const gfx::Rect& new_bounds) {
+  if (widget == browser_widget_ && widget_ && widget_->IsVisible()) {
+    Place();
+  }
+}
+
+void LokaCommandBar::OnWidgetDestroying(views::Widget* widget) {
+  if (widget == browser_widget_) {
+    widget_observation_.Reset();
+    browser_widget_observation_.Reset();
+    widget_.reset();
+    browser_widget_ = nullptr;
+    // Deletes this.
+    Bars().erase(browser_);
+  } else if (widget == widget_.get()) {
+    widget_observation_.Reset();
+  }
+}
