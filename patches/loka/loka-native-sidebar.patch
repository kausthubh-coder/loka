+LokaSidebarHandler::LokaSidebarHandler() = default;
+
+LokaSidebarHandler::~LokaSidebarHandler() {
+  if (observed_) {
+    observed_->RemoveObserver(this);
+  }
+}
+
+void LokaSidebarHandler::RegisterMessages() {
+  const auto add = [this](const char* name,
+                          void (LokaSidebarHandler::*handler)(
+                              const base::ListValue&)) {
+    web_ui()->RegisterMessageCallback(
+        name, base::BindRepeating(handler, base::Unretained(this)));
+  };
+  add("getTabs", &LokaSidebarHandler::HandleGetTabs);
+  add("getGroups", &LokaSidebarHandler::HandleGetGroups);
+  add("getStore", &LokaSidebarHandler::HandleGetStore);
+  add("setStore", &LokaSidebarHandler::HandleSetStore);
+  add("createTab", &LokaSidebarHandler::HandleCreateTab);
+  add("activateTab", &LokaSidebarHandler::HandleActivateTab);
+  add("closeTab", &LokaSidebarHandler::HandleCloseTab);
+  add("navigateTab", &LokaSidebarHandler::HandleNavigateTab);
+  add("goBack", &LokaSidebarHandler::HandleGoBack);
+  add("goForward", &LokaSidebarHandler::HandleGoForward);
+  add("reload", &LokaSidebarHandler::HandleReload);
+  add("setMuted", &LokaSidebarHandler::HandleSetMuted);
+  add("groupTabs", &LokaSidebarHandler::HandleGroupTabs);
+  add("updateGroup", &LokaSidebarHandler::HandleUpdateGroup);
+  add("ungroupTabs", &LokaSidebarHandler::HandleUngroupTabs);
+  add("search", &LokaSidebarHandler::HandleSearch);
+  add("openPage", &LokaSidebarHandler::HandleOpenPage);
+  add("windowAction", &LokaSidebarHandler::HandleWindowAction);
+  add("startWindowDrag", &LokaSidebarHandler::HandleStartWindowDrag);
+}
+
+void LokaSidebarHandler::OnJavascriptAllowed() {
+  StartObserving();
+  Profile* profile = Profile::FromWebUI(web_ui());
+  pref_change_registrar_.Init(profile->GetPrefs());
+  pref_change_registrar_.Add(
+      kLokaSidebarStorePref,
+      base::BindRepeating(&LokaSidebarHandler::OnStoreChanged,
+                          base::Unretained(this)));
+}
+
+void LokaSidebarHandler::OnJavascriptDisallowed() {
+  pref_change_registrar_.RemoveAll();
+  if (observed_) {
+    observed_->RemoveObserver(this);
+    observed_ = nullptr;
+  }
+  weak_factory_.InvalidateWeakPtrs();
+  tabs_change_pending_ = false;
+}
+
+void LokaSidebarHandler::StartObserving() {
+  TabStripModel* tab_strip = GetTabStrip();
+  if (tab_strip == observed_) {
+    return;
+  }
+  if (observed_) {
+    observed_->RemoveObserver(this);
+  }
+  observed_ = tab_strip;
+  if (observed_) {
+    observed_->AddObserver(this);
+  }
+}
