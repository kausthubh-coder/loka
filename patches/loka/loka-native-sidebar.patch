+#ifndef CHROME_BROWSER_UI_WEBUI_LOKA_SIDEBAR_LOKA_TAB_SLEEPER_H_
+#define CHROME_BROWSER_UI_WEBUI_LOKA_SIDEBAR_LOKA_TAB_SLEEPER_H_
