+void LokaSidebarHandler::HandleGetTabs(const base::ListValue& args) {
+  AllowJavascript();
+  ResolveJavascriptCallback(args[0], TabList());
+}
+
+void LokaSidebarHandler::HandleGetGroups(const base::ListValue& args) {
+  AllowJavascript();
+  ResolveJavascriptCallback(args[0], GroupList());
+}
+
+void LokaSidebarHandler::HandleGetStore(const base::ListValue& args) {
+  AllowJavascript();
+  ResolveJavascriptCallback(args[0], StoreValue());
+}
+
+void LokaSidebarHandler::HandleSetStore(const base::ListValue& args) {
+  if (args.size() < 2 || !args[0].is_string()) {
+    return;
+  }
+  Profile* profile = Profile::FromWebUI(web_ui());
+  ScopedDictPrefUpdate update(profile->GetPrefs(), kLokaSidebarStorePref);
+  if (args[1].is_string()) {
+    update->Set(args[0].GetString(), args[1].GetString());
+  } else {
+    update->Remove(args[0].GetString());
+  }
+}
+
+void LokaSidebarHandler::HandleCreateTab(const base::ListValue& args) {
+  AllowJavascript();
+  BrowserWindowInterface* browser = GetBrowser();
+  if (!browser || args.size() < 3) {
+    ResolveJavascriptCallback(args[0], base::Value());
+    return;
+  }
+  const std::string& spec = args[1].is_string() ? args[1].GetString() : "";
+  GURL url(spec.empty() ? "chrome://newtab/" : spec);
+  NavigateParams params(browser, url, ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+  params.disposition = args[2].is_bool() && !args[2].GetBool()
+                           ? WindowOpenDisposition::NEW_BACKGROUND_TAB
+                           : WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  Navigate(&params);
+  tabs::TabInterface* tab =
+      params.navigated_or_inserted_contents
+          ? tabs::TabInterface::MaybeGetFromContents(
+                params.navigated_or_inserted_contents)
+          : nullptr;
+  ResolveJavascriptCallback(args[0],
+                            tab ? base::Value(TabId(tab)) : base::Value());
+}
+
+void LokaSidebarHandler::HandleActivateTab(const base::ListValue& args) {
+  tabs::TabInterface* tab = args.empty() ? nullptr : FindTab(args[0]);
+  if (!tab) {
+    return;
+  }
+  TabStripModel* tab_strip = GetTabStrip();
+  tab_strip->ActivateTabAt(tab_strip->GetIndexOfTab(tab));
+}
+
+void LokaSidebarHandler::HandleCloseTab(const base::ListValue& args) {
+  tabs::TabInterface* tab = args.empty() ? nullptr : FindTab(args[0]);
+  if (!tab) {
+    return;
+  }
+  TabStripModel* tab_strip = GetTabStrip();
+  tab_strip->CloseWebContentsAt(
+      tab_strip->GetIndexOfTab(tab),
+      TabCloseTypes::CLOSE_USER_GESTURE |
+          TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+}
+
+void LokaSidebarHandler::HandleNavigateTab(const base::ListValue& args) {
+  tabs::TabInterface* tab = args.size() < 2 ? nullptr : FindTab(args[0]);
+  if (!tab || !args[1].is_string()) {
+    return;
+  }
+  GURL url(args[1].GetString());
+  if (!url.is_valid()) {
+    return;
+  }
+  content::NavigationController::LoadURLParams load(url);
+  load.transition_type = ui::PAGE_TRANSITION_TYPED;
+  tab->GetContents()->GetController().LoadURLWithParams(load);
+}
+
+void LokaSidebarHandler::HandleGoBack(const base::ListValue& args) {
+  tabs::TabInterface* tab = args.empty() ? nullptr : FindTab(args[0]);
+  if (tab && tab->GetContents()->GetController().CanGoBack()) {
+    tab->GetContents()->GetController().GoBack();
+  }
+}
+
+void LokaSidebarHandler::HandleGoForward(const base::ListValue& args) {
+  tabs::TabInterface* tab = args.empty() ? nullptr : FindTab(args[0]);
+  if (tab && tab->GetContents()->GetController().CanGoForward()) {
+    tab->GetContents()->GetController().GoForward();
+  }
+}
+
+void LokaSidebarHandler::HandleReload(const base::ListValue& args) {
+  tabs::TabInterface* tab = args.empty() ? nullptr : FindTab(args[0]);
+  if (tab) {
+    tab->GetContents()->GetController().Reload(content::ReloadType::NORMAL,
+                                               /*check_for_repost=*/true);
+  }
+}
+
+void LokaSidebarHandler::HandleSetMuted(const base::ListValue& args) {
+  tabs::TabInterface* tab = args.size() < 2 ? nullptr : FindTab(args[0]);
+  if (tab && args[1].is_bool()) {
+    tab->GetContents()->SetAudioMuted(args[1].GetBool());
+  }
+}
+
+void LokaSidebarHandler::HandleGroupTabs(const base::ListValue& args) {
+  AllowJavascript();
+  TabStripModel* tab_strip = GetTabStrip();
+  if (!tab_strip || args.size() < 3 || !args[1].is_list()) {
+    ResolveJavascriptCallback(args[0], base::Value());
+    return;
+  }
+  std::vector<int> indices;
+  for (const base::Value& id : args[1].GetList()) {
+    if (tabs::TabInterface* tab = FindTab(id)) {
+      indices.push_back(tab_strip->GetIndexOfTab(tab));
+    }
+  }
+  if (indices.empty()) {
+    ResolveJavascriptCallback(args[0], base::Value());
+    return;
+  }
+  std::sort(indices.begin(), indices.end());
+  std::optional<tab_groups::TabGroupId> group =
+      args[2].is_int() ? GroupFromNumber(args[2].GetInt()) : std::nullopt;
+  if (group && tab_strip->group_model()->ContainsTabGroup(*group)) {
+    tab_strip->AddToExistingGroup(indices, *group);
+  } else {
+    group = tab_strip->AddToNewGroup(indices);
+  }
+  ResolveJavascriptCallback(args[0], base::Value(GroupNumber(*group)));
+}
+
+void LokaSidebarHandler::HandleUpdateGroup(const base::ListValue& args) {
+  TabStripModel* tab_strip = GetTabStrip();
+  if (!tab_strip || args.size() < 4 || !args[0].is_int()) {
+    return;
+  }
+  std::optional<tab_groups::TabGroupId> id = GroupFromNumber(args[0].GetInt());
+  if (!id || !tab_strip->group_model()->ContainsTabGroup(*id)) {
+    return;
+  }
+  TabGroup* group = tab_strip->group_model()->GetTabGroup(*id);
+  const tab_groups::TabGroupVisualData* old = group->visual_data();
+  std::u16string title = args[1].is_string()
+                             ? base::UTF8ToUTF16(args[1].GetString())
+                             : old->title();
+  tab_groups::TabGroupColorId color = args[2].is_string()
+                                          ? ColorFromName(args[2].GetString())
+                                          : old->color();
+  bool collapsed =
+      args[3].is_bool() ? args[3].GetBool() : old->is_collapsed();
+  tab_strip->ChangeTabGroupVisuals(
+      *id, tab_groups::TabGroupVisualData(title, color, collapsed));
+}
+
+void LokaSidebarHandler::HandleUngroupTabs(const base::ListValue& args) {
+  TabStripModel* tab_strip = GetTabStrip();
+  if (!tab_strip || args.empty() || !args[0].is_list()) {
+    return;
+  }
+  std::vector<int> indices;
+  for (const base::Value& id : args[0].GetList()) {
+    if (tabs::TabInterface* tab = FindTab(id)) {
+      indices.push_back(tab_strip->GetIndexOfTab(tab));
+    }
+  }
+  if (indices.empty()) {
+    return;
+  }
+  std::sort(indices.begin(), indices.end());
+  tab_strip->RemoveFromGroup(indices);
+}
+
+void LokaSidebarHandler::HandleSearch(const base::ListValue& args) {
+  BrowserWindowInterface* browser = GetBrowser();
+  if (!browser || args.size() < 2 || !args[0].is_string()) {
+    return;
+  }
+  TemplateURLService* service =
+      TemplateURLServiceFactory::GetForProfile(Profile::FromWebUI(web_ui()));
+  const TemplateURL* engine =
+      service ? service->GetDefaultSearchProvider() : nullptr;
+  if (!engine) {
+    return;
+  }
+  GURL url = engine->GenerateSearchURL(service->search_terms_data(),
+                                       base::UTF8ToUTF16(args[0].GetString()));
+  const bool new_tab = !args[1].is_bool() || args[1].GetBool();
+  NavigateParams params(browser, url, ui::PAGE_TRANSITION_GENERATED);
+  params.disposition = new_tab ? WindowOpenDisposition::NEW_FOREGROUND_TAB
+                               : WindowOpenDisposition::CURRENT_TAB;
+  Navigate(&params);
+}
+
+void LokaSidebarHandler::HandleOpenPage(const base::ListValue& args) {
+  BrowserWindowInterface* browser = GetBrowser();
+  if (!browser || args.empty() || !args[0].is_string()) {
+    return;
+  }
+  // Only the browser's own pages: the sidebar opens settings, downloads and
+  // extensions this way.
+  GURL url(args[0].GetString());
+  if (!url.SchemeIs(content::kChromeUIScheme)) {
+    return;
+  }
+  NavigateParams params(browser, url, ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+  params.disposition = WindowOpenDisposition::SINGLETON_TAB;
+  Navigate(&params);
+}
+
+void LokaSidebarHandler::HandleWindowAction(const base::ListValue& args) {
+  BrowserWindowInterface* browser = GetBrowser();
+  if (!browser || args.empty() || !args[0].is_string()) {
+    return;
+  }
+  ui::BaseWindow* window = browser->GetWindow();
+  const std::string& action = args[0].GetString();
+  if (action == "minimize") {
+    window->Minimize();
+  } else if (action == "maximize") {
+    if (window->IsMaximized()) {
+      window->Restore();
+    } else {
+      window->Maximize();
+    }
+  } else if (action == "close") {
+    window->Close();
+  }
+}
+
+void LokaSidebarHandler::HandleStartWindowDrag(const base::ListValue& args) {
+  // The sidebar's empty top row moves the window, like a title bar: hand the
+  // press that's still down to Windows' own move loop.
+#if BUILDFLAG(IS_WIN)
+  BrowserWindowInterface* browser = GetBrowser();
+  if (!browser || browser->GetWindow()->IsFullscreen()) {
+    return;
+  }
+  HWND hwnd = views::HWNDForNativeWindow(browser->GetWindow()->GetNativeWindow());
+  if (!hwnd || !(::GetAsyncKeyState(VK_LBUTTON) & 0x8000)) {
+    return;
+  }
+  ::ReleaseCapture();
+  ::SendMessage(hwnd, WM_NCLBUTTONDOWN, HTCAPTION, 0);
+#endif
+}
