+// ---- Downloads --------------------------------------------------------------
+
+base::ListValue LokaSidebarHandler::DownloadList() {
+  base::ListValue list;
+  content::DownloadManager* manager =
+      Profile::FromWebUI(web_ui())->GetDownloadManager();
+  if (!manager) {
+    return list;
+  }
+  download::SimpleDownloadManager::DownloadVector items;
+  manager->GetAllDownloads(&items);
+  std::vector<download::DownloadItem*> shown;
+  for (download::DownloadItem* item : items) {
+    if (!item->IsTransient() && !item->IsTemporary()) {
+      shown.push_back(item);
+    }
+  }
+  std::sort(shown.begin(), shown.end(), [](auto* a, auto* b) {
+    return a->GetStartTime() > b->GetStartTime();
+  });
+  if (shown.size() > kMaxDownloads) {
+    shown.resize(kMaxDownloads);
+  }
+  for (download::DownloadItem* item : shown) {
+    std::string name = item->GetFileNameToReportUser().AsUTF8Unsafe();
+    if (name.empty()) {
+      name = item->GetURL().ExtractFileName();
+    }
+    base::DictValue data;
+    data.Set("id", static_cast<int>(item->GetId()));
+    data.Set("name", name);
+    data.Set("url", item->GetURL().spec());
+    data.Set("state", DownloadState(*item));
+    data.Set("receivedBytes", static_cast<double>(item->GetReceivedBytes()));
+    data.Set("totalBytes", static_cast<double>(item->GetTotalBytes() > 0
+                                                   ? item->GetTotalBytes()
+                                                   : -1));
+    data.Set("startTime",
+             item->GetStartTime().InMillisecondsFSinceUnixEpoch());
+    data.Set("canResume", item->CanResume());
+    list.Append(std::move(data));
+  }
+  return list;
+}
+
+void LokaSidebarHandler::ScheduleDownloadsChanged() {
+  if (downloads_change_pending_ || !IsJavascriptAllowed()) {
+    return;
+  }
+  downloads_change_pending_ = true;
+  // Progress updates come many times a second; a quarter second is plenty.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<LokaSidebarHandler> self) {
+            if (!self || !self->IsJavascriptAllowed()) {
+              return;
+            }
+            self->downloads_change_pending_ = false;
+            self->FireWebUIListener("downloads-changed", self->DownloadList());
+          },
+          weak_factory_.GetWeakPtr()),
+      base::Milliseconds(250));
+}
+
+void LokaSidebarHandler::OnDownloadCreated(content::DownloadManager* manager,
+                                           download::DownloadItem* item) {
+  ScheduleDownloadsChanged();
+}
+void LokaSidebarHandler::OnDownloadUpdated(content::DownloadManager* manager,
+                                           download::DownloadItem* item) {
+  ScheduleDownloadsChanged();
+}
+void LokaSidebarHandler::OnDownloadRemoved(content::DownloadManager* manager,
+                                           download::DownloadItem* item) {
