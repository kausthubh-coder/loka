+
+// What one tab's page says it is playing, from its Media Session: the title,
+// artist and artwork the page set (navigator.mediaSession), whether it plays
+// or is paused, and which buttons it supports. This is what Chrome's own
+// media controls read. `on_change` runs whenever any of it changes.
+class LokaMediaWatcher : public media_session::mojom::MediaSessionObserver {
+ public:
+  LokaMediaWatcher(content::WebContents* contents,
+                   base::RepeatingClosure on_change);
+  LokaMediaWatcher(const LokaMediaWatcher&) = delete;
+  LokaMediaWatcher& operator=(const LokaMediaWatcher&) = delete;
+  ~LokaMediaWatcher() override;
+
+  // The page has media that holds or held audio focus: playing, or paused
+  // where it can play again. False once it stops or navigates away.
+  bool IsActive() const;
+  bool IsPlaying() const;
+  bool Can(media_session::mojom::MediaSessionAction action) const;
+  // The page's own title and artist, empty when it set none.
+  std::u16string title() const;
+  std::u16string artist() const;
+  // The page's artwork as a data: URL, empty when it set none.
+  const std::string& artwork() const { return artwork_; }
+
+  // media_session::mojom::MediaSessionObserver:
+  void MediaSessionInfoChanged(
+      media_session::mojom::MediaSessionInfoPtr info) override;
+  void MediaSessionMetadataChanged(
+      const std::optional<media_session::MediaMetadata>& metadata) override;
+  void MediaSessionActionsChanged(
+      const std::vector<media_session::mojom::MediaSessionAction>& actions)
+      override;
+  void MediaSessionImagesChanged(
+      const base::flat_map<media_session::mojom::MediaSessionImageType,
+                           std::vector<media_session::MediaImage>>& images)
+      override;
+  void MediaSessionPositionChanged(
+      const std::optional<media_session::MediaPosition>& position) override {}
+
+ private:
+  void OnArtwork(int request, const SkBitmap& bitmap);
+
+  raw_ptr<content::WebContents> contents_;
+  base::RepeatingClosure on_change_;
+  media_session::mojom::MediaSessionInfoPtr info_;
+  std::optional<media_session::MediaMetadata> metadata_;
+  std::vector<media_session::mojom::MediaSessionAction> actions_;
+  std::string artwork_;
+  // Artwork downloads finish out of order; only the latest one counts.
+  int artwork_request_ = 0;
+  mojo::Receiver<media_session::mojom::MediaSessionObserver> receiver_{this};
+  base::WeakPtrFactory<LokaMediaWatcher> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_LOKA_SIDEBAR_LOKA_MEDIA_WATCHER_H_
