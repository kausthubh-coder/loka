+
+void LokaSidebarHandler::ScheduleTabsChanged() {
+  if (!watching_tabs_ || !IsJavascriptAllowed() || tabs_timer_.IsRunning()) {
+    return;
+  }
+  // Right away (after the current batch of tab strip changes) unless the
+  // last send was less than a frame ago.
+  const base::TimeDelta wait =
+      std::max(base::TimeDelta(),
+               kTabsBatch - (base::TimeTicks::Now() - tabs_sent_at_));
+  tabs_timer_.Start(FROM_HERE, wait,
+                    base::BindOnce(&LokaSidebarHandler::SendTabsChanged,
+                                   base::Unretained(this)));
+}
+
+void LokaSidebarHandler::SendTabsChanged() {
+  tabs_timer_.Stop();
+  if (!watching_tabs_ || !IsJavascriptAllowed()) {
+    return;
+  }
+  tabs_sent_at_ = base::TimeTicks::Now();
+  // The sidebar can be moved to another window's panel; follow it.
+  StartObserving();
+  base::DictValue changes = TabChanges();
+  if (!changes.empty()) {
+    FireWebUIListener("tabs-changed", changes);
+  }
+  // What's playing changes with the tabs' sound.
+  SendMediaChanged();
+}
+
+void LokaSidebarHandler::OnStoreChanged() {
+  // Only the keys that changed, and never back to the page that wrote them.
+  base::DictValue store = StoreValue();
+  base::DictValue changed;
+  for (const auto [key, value] : store) {
+    const base::Value* heard = sent_store_.Find(key);
+    if (!heard || *heard != value) {
+      changed.Set(key, value.Clone());
+    }
+  }
+  sent_store_ = std::move(store);
+  if (!setting_store_ && !changed.empty()) {
+    FireWebUIListener("store-changed", changed);
+  }
+}
+
+void LokaSidebarHandler::HandleSyncTabs(const base::ListValue& args) {
+  // The page's copy of the tabs is current once this answers: whatever
+  // changed is sent first ("tabs-changed"), everything on the first call.
+  AllowJavascript();
+  watching_tabs_ = true;
+  SendTabsChanged();
+  ResolveJavascriptCallback(args[0], base::Value());
+}
+
+void LokaSidebarHandler::HandleGetTabs(const base::ListValue& args) {
+  AllowJavascript();
+  ResolveJavascriptCallback(args[0], TabList());
+}
+
+void LokaSidebarHandler::HandleGetGroups(const base::ListValue& args) {
