+tab_groups::TabGroupColorId ColorFromName(const std::string& name) {
+  static constexpr std::pair<const char*, tab_groups::TabGroupColorId>
+      kColors[] = {
+          {"grey", tab_groups::TabGroupColorId::kGrey},
+          {"blue", tab_groups::TabGroupColorId::kBlue},
+          {"red", tab_groups::TabGroupColorId::kRed},
+          {"yellow", tab_groups::TabGroupColorId::kYellow},
+          {"green", tab_groups::TabGroupColorId::kGreen},
+          {"pink", tab_groups::TabGroupColorId::kPink},
+          {"purple", tab_groups::TabGroupColorId::kPurple},
+          {"cyan", tab_groups::TabGroupColorId::kCyan},
+          {"orange", tab_groups::TabGroupColorId::kOrange},
+      };
+  for (const auto& [n, color] : kColors) {
+    if (name == n) {
+      return color;
+    }
+  }
+  return tab_groups::TabGroupColorId::kGrey;
+}
+
+std::optional<std::string> ReadFile(const base::FilePath& path) {
+  std::string text;
+  if (!base::ReadFileToString(path, &text)) {
+    return std::nullopt;
+  }
+  return text;
+}
+
+// The settings' archiveAfterHours, read as parseUiPrefs reads it: 12 when
+// missing, 0 never.
+double ArchiveHours(const std::string* ui_json) {
+  std::optional<base::Value> ui =
+      ui_json ? base::JSONReader::Read(*ui_json, base::JSON_PARSE_RFC)
+              : std::nullopt;
+  const base::Value* hours =
+      ui && ui->is_dict() ? ui->GetDict().Find("archiveAfterHours") : nullptr;
+  std::optional<double> value = hours ? hours->GetIfDouble() : std::nullopt;
+  if (!value || !std::isfinite(*value) || *value < 0) {
+    return kDefaultArchiveHours;
+  }
+  return *value;
+}
