+// static
+bool LokaSidebarHandler::DispatchCommand(BrowserWindowInterface* browser,
+                                         const std::string& command) {
+  const bool address = command == "new-tab" || command == "focus-location";
+  if (address && HasCommandBarPage() && Sidebars().contains(browser)) {
+    LokaCommandBar::Show(browser, command);
+    return true;
+  }
+  auto it = Sidebars().find(browser);
+  if (it == Sidebars().end() || !it->second->IsJavascriptAllowed()) {
+    return false;
+  }
+  LokaSidebarHandler* handler = it->second;
+  // Typing goes to the sidebar's own command bar; tab and space switches
+  // leave the keyboard where it was.
+  if (address) {
+    handler->web_ui()->GetWebContents()->Focus();
+  }
+  handler->FireWebUIListener("command", base::Value(command));
+  return true;
+}
+
+// static
+bool LokaSidebarHandler::DeliverCommandBarCommand(
+    BrowserWindowInterface* browser,
+    const std::string& command) {
+  auto it = CommandBars().find(browser);
+  if (it == CommandBars().end() || !it->second->IsJavascriptAllowed()) {
+    return false;
+  }
+  it->second->FireWebUIListener("command", base::Value(command));
+  return true;
+}
+
+bool LokaSidebarHandler::IsCommandBarPage() {
+  return web_ui()->GetWebContents()->GetVisibleURL().path() == "/command.html";
+}
+
+bool LokaSidebarHandler::IsMenuPage() {
+  return web_ui()->GetWebContents()->GetVisibleURL().path() == "/menu.html";
+}
+
+// static
+bool LokaSidebarHandler::DeliverMenu(BrowserWindowInterface* browser,
+                                     const base::Value& menu) {
+  auto it = MenuPages().find(browser);
+  if (it == MenuPages().end() || !it->second->IsJavascriptAllowed()) {
+    return false;
+  }
+  it->second->FireWebUIListener("menu-show", menu);
+  return true;
+}
+
+// static
+void LokaSidebarHandler::MenuClosed(BrowserWindowInterface* browser) {
+  auto it = Sidebars().find(browser);
+  if (it != Sidebars().end() && it->second->IsJavascriptAllowed()) {
+    it->second->FireWebUIListener("menu-closed");
+  }
+}
+
+void LokaSidebarHandler::HandleShowMenu(const base::ListValue& args) {
+  BrowserWindowInterface* browser = GetBrowser();
+  if (!browser || args.size() < 3 || !args[0].is_dict()) {
+    return;
+  }
+  // (x, y) is in the sidebar page; the window opens there on the screen.
+  const gfx::Rect page = web_ui()->GetWebContents()->GetContainerBounds();
+  const gfx::Point anchor(
+      page.x() + static_cast<int>(args[1].GetIfDouble().value_or(0)),
+      page.y() + static_cast<int>(args[2].GetIfDouble().value_or(0)));
+  LokaMenu::Show(browser, args[0].Clone(), anchor);
+}
+
+void LokaSidebarHandler::HandleMenuReady(const base::ListValue& args) {
+  // The page's first call, with no size, says it has loaded: it can hear
+  // "menu-show" from now on (StartObservingFeatures takes a waiting menu).
+  AllowJavascript();
+  BrowserWindowInterface* browser = GetBrowser();
+  if (!browser || args.size() < 2) {
+    return;
+  }
+  LokaMenu::Place(browser,
+                  gfx::Size(static_cast<int>(args[0].GetIfDouble().value_or(0)),
+                            static_cast<int>(args[1].GetIfDouble().value_or(0))));
+}
+
+void LokaSidebarHandler::HandleMenuPicked(const base::ListValue& args) {
+  BrowserWindowInterface* browser = GetBrowser();
+  if (!browser || args.empty()) {
+    return;
+  }
+  LokaMenu::Hide(browser, /*picked=*/true);
+  auto it = Sidebars().find(browser);
+  if (it != Sidebars().end() && it->second->IsJavascriptAllowed()) {
+    // The item runs in the sidebar, as if picked there: the keyboard goes
+    // back to it, and the click counts as its user gesture, so an item can
+    // open a file picker (Import) or use the clipboard (Copy link).
+    content::WebContents* sidebar = it->second->web_ui()->GetWebContents();
+    sidebar->Focus();
+    sidebar->GetPrimaryMainFrame()->NotifyUserActivation(
+        blink::mojom::UserActivationNotificationType::kInteraction);
+    it->second->FireWebUIListener("menu-picked", args[0]);
+  }
+}
+
+void LokaSidebarHandler::HandleCloseMenu(const base::ListValue& args) {
+  if (BrowserWindowInterface* browser = GetBrowser()) {
+    LokaMenu::Hide(browser, /*picked=*/false);
+  }
+}
+
+void LokaSidebarHandler::HandleOpenCommandBar(const base::ListValue& args) {
+  BrowserWindowInterface* browser = GetBrowser();
+  if (!browser || args.empty() || !args[0].is_string()) {
+    return;
+  }
+  DispatchCommand(browser, args[0].GetString());
+}
+
+void LokaSidebarHandler::HandleCommandPicked(const base::ListValue& args) {
+  // The floating bar picked something only the sidebar can do (a space, an
+  // unloaded Loka tab, a Loka command): hand it to this window's sidebar.
+  BrowserWindowInterface* browser = GetBrowser();
+  if (!browser || args.empty()) {
+    return;
+  }
+  auto it = Sidebars().find(browser);
+  if (it != Sidebars().end() && it->second->IsJavascriptAllowed()) {
+    it->second->FireWebUIListener("command-picked", args[0]);
+  }
+}
+
+void LokaSidebarHandler::OnSidebarPinnedChanged() {
+  FireWebUIListener(
+      "sidebar-pinned-changed",
+      base::Value(Profile::FromWebUI(web_ui())->GetPrefs()->GetBoolean(
+          prefs::kHeliumZenModeSidebarPinned)));
+}
