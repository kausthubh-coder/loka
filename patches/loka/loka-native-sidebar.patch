+constexpr base::TimeDelta kSaveAfter = base::Seconds(2);
+constexpr base::TimeDelta kArchiveEvery = base::Minutes(1);
+constexpr double kDefaultArchiveHours = 12;
+// The spaces' key in the loka.store pref, where the sidebar kept them before.
