+
+// The sidebar's line to its window: the real tabs and tab groups, and Loka's
+// store in the profile's prefs. Tabs are named by their TabHandle and groups
+// by a number this handler hands out, so the page works with plain numbers.
+//
+// Page -> browser (chrome.send):
+//   getTabs(cb), getGroups(cb), getStore(cb), setStore(key, value|null),
+//   createTab(cb, url, active), activateTab(id), closeTab(id),
+//   navigateTab(id, url), goBack(id), goForward(id), reload(id),
+//   setMuted(id, muted), groupTabs(cb, ids, groupId|-1),
+//   updateGroup(groupId, title, color, collapsed), ungroupTabs(ids),
+//   search(query, newTab), openPage(url),
+//   windowAction("minimize"|"maximize"|"close"), startWindowDrag()
+// Browser -> page (WebUI listeners):
+//   "tabs-changed" (tabs), "store-changed" (store)
+class LokaSidebarHandler : public content::WebUIMessageHandler,
+                           public TabStripModelObserver {
+ public:
+  LokaSidebarHandler();
+  LokaSidebarHandler(const LokaSidebarHandler&) = delete;
+  LokaSidebarHandler& operator=(const LokaSidebarHandler&) = delete;
+  ~LokaSidebarHandler() override;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override;
+  void OnJavascriptAllowed() override;
+  void OnJavascriptDisallowed() override;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(TabStripModel* tab_strip_model,
+                              const TabStripModelChange& change,
+                              const TabStripSelectionChange& selection) override;
+  void OnTabChangedAt(tabs::TabInterface* tab,
+                      TabChangeType change_type) override;
+  void OnTabGroupChanged(const TabGroupChange& change) override;
+
+ private:
+  BrowserWindowInterface* GetBrowser();
+  TabStripModel* GetTabStrip();
+  // The tab with this id, if it's in this window.
+  tabs::TabInterface* FindTab(const base::Value& id);
+  int GroupNumber(const tab_groups::TabGroupId& group);
+  std::optional<tab_groups::TabGroupId> GroupFromNumber(int number);
+
+  base::ListValue TabList();
+  base::DictValue TabData(tabs::TabInterface* tab, int index);
+  std::string FaviconDataUrl(tabs::TabInterface* tab);
+  base::ListValue GroupList();
+  base::DictValue StoreValue();
+
+  // Sends the tabs once, after the current batch of tab strip changes.
+  void ScheduleTabsChanged();
+  void SendTabsChanged();
+  void OnStoreChanged();
+  void StartObserving();
+
+  void HandleGetTabs(const base::ListValue& args);
+  void HandleGetGroups(const base::ListValue& args);
+  void HandleGetStore(const base::ListValue& args);
+  void HandleSetStore(const base::ListValue& args);
+  void HandleCreateTab(const base::ListValue& args);
+  void HandleActivateTab(const base::ListValue& args);
+  void HandleCloseTab(const base::ListValue& args);
+  void HandleNavigateTab(const base::ListValue& args);
+  void HandleGoBack(const base::ListValue& args);
+  void HandleGoForward(const base::ListValue& args);
+  void HandleReload(const base::ListValue& args);
+  void HandleSetMuted(const base::ListValue& args);
+  void HandleGroupTabs(const base::ListValue& args);
+  void HandleUpdateGroup(const base::ListValue& args);
+  void HandleUngroupTabs(const base::ListValue& args);
+  void HandleSearch(const base::ListValue& args);
+  void HandleOpenPage(const base::ListValue& args);
+  void HandleWindowAction(const base::ListValue& args);
+  void HandleStartWindowDrag(const base::ListValue& args);
+
+  raw_ptr<TabStripModel> observed_ = nullptr;
+  PrefChangeRegistrar pref_change_registrar_;
+  bool tabs_change_pending_ = false;
+  std::map<tab_groups::TabGroupId, int> group_numbers_;
+  int next_group_number_ = 1;
+  // Each tab's last favicon and its data: URL, so unchanged icons aren't
+  // encoded again on every change.
+  std::map<int32_t, std::pair<gfx::ImageSkia, std::string>> favicons_;
+  base::WeakPtrFactory<LokaSidebarHandler> weak_factory_{this};
+};
+
