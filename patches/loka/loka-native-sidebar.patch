+#include "content/public/browser/web_ui_data_source.h"
+#include "content/public/common/url_constants.h"
+#include "services/network/public/mojom/content_security_policy.mojom.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/base/window_open_disposition.h"
+#include "ui/webui/webui_util.h"
+
+namespace {
+
+constexpr char kHistoryHost[] = "history";
+constexpr int kMaxResults = 200;
+
+const webui::ResourcePath* HistoryPage() {
+  for (const auto& resource : kLokaSidebarGenerated) {
+    if (std::string_view(resource.path) == "history.html") {
+      return &resource;
+    }
+  }
+  return nullptr;
+}
+
+history::HistoryService* History(content::WebUI* web_ui) {
+  return HistoryServiceFactory::GetForProfile(
+      Profile::FromWebUI(web_ui), ServiceAccessType::EXPLICIT_ACCESS);
+}
+
+}  // namespace
+
+LokaHistoryUIConfig::LokaHistoryUIConfig()
+    : DefaultWebUIConfig(content::kChromeUIScheme, kHistoryHost) {}
+
+// static
+bool LokaHistoryUIConfig::HasPage() {
+  return HistoryPage() != nullptr;
+}
+
+LokaHistoryUI::LokaHistoryUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  Profile* profile = Profile::FromWebUI(web_ui);
+  content::WebUIDataSource* source =
+      content::WebUIDataSource::CreateAndAdd(profile, kHistoryHost);
+  webui::SetupWebUIDataSource(source, kLokaSidebarGenerated,
+                              HistoryPage()->id);
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::TrustedTypes,
+      "trusted-types lit-html;");
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ImgSrc,
+      "img-src chrome://favicon2 data: blob: 'self';");
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::StyleSrc,
+      "style-src 'self' 'unsafe-inline';");
+  content::URLDataSource::Add(
+      profile, std::make_unique<FaviconSource>(
+                   profile, chrome::FaviconUrlFormat::kFavicon2));
+  web_ui->AddMessageHandler(std::make_unique<LokaHistoryHandler>());
+  // The page is Loka's Library: its spaces, archived tabs and downloads come
+  // from the sidebar's handler.
+  web_ui->AddMessageHandler(std::make_unique<LokaSidebarHandler>());
+}
+
+LokaHistoryUI::~LokaHistoryUI() = default;
+
+WEB_UI_CONTROLLER_TYPE_IMPL(LokaHistoryUI)
+
+LokaHistoryHandler::LokaHistoryHandler() = default;
+LokaHistoryHandler::~LokaHistoryHandler() = default;
+
+void LokaHistoryHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "queryHistory",
+      base::BindRepeating(&LokaHistoryHandler::HandleQueryHistory,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "deleteUrls", base::BindRepeating(&LokaHistoryHandler::HandleDeleteUrls,
+                                        base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "deleteRange",
+      base::BindRepeating(&LokaHistoryHandler::HandleDeleteRange,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "openUrl", base::BindRepeating(&LokaHistoryHandler::HandleOpenUrl,
+                                     base::Unretained(this)));
+}
+
+void LokaHistoryHandler::HandleQueryHistory(const base::ListValue& args) {
+  AllowJavascript();
+  history::HistoryService* history = History(web_ui());
+  if (!history || args.size() < 4) {
+    ResolveJavascriptCallback(args[0], base::Value());
+    return;
+  }
+  history::QueryOptions options;
+  options.max_count =
+      std::clamp(args[3].is_int() ? args[3].GetInt() : 100, 1, kMaxResults);
+  options.duplicate_policy = history::QueryOptions::REMOVE_DUPLICATES_PER_DAY;
+  if (args[2].is_double() || args[2].is_int()) {
+    const double before = args[2].GetDouble();
+    if (before > 0) {
+      options.end_time = base::Time::FromMillisecondsSinceUnixEpoch(before);
+    }
+  }
+  const std::u16string text =
+      args[1].is_string() ? base::UTF8ToUTF16(args[1].GetString()) : u"";
+  history->QueryHistory(
+      text, options,
+      base::BindOnce(&LokaHistoryHandler::OnQueryDone,
+                     weak_factory_.GetWeakPtr(), args[0].Clone()),
+      &tracker_);
+}
+
+void LokaHistoryHandler::OnQueryDone(base::Value callback_id,
+                                     history::QueryResults results) {
+  base::ListValue items;
+  for (const history::URLResult& result : results) {
+    base::DictValue item;
+    item.Set("url", result.url().spec());
+    item.Set("title", base::UTF16ToUTF8(result.title()));
+    item.Set("time", result.visit_time().InMillisecondsFSinceUnixEpoch());
+    items.Append(std::move(item));
+  }
+  base::DictValue reply;
+  reply.Set("items", std::move(items));
+  reply.Set("done", results.reached_beginning());
+  ResolveJavascriptCallback(callback_id, reply);
+}
+
+void LokaHistoryHandler::HandleDeleteUrls(const base::ListValue& args) {
+  history::HistoryService* history = History(web_ui());
+  if (!history || args.empty() || !args[0].is_list()) {
+    return;
+  }
+  std::vector<GURL> urls;
+  for (const base::Value& url : args[0].GetList()) {
+    if (url.is_string()) {
+      urls.emplace_back(url.GetString());
+    }
+  }
+  history->DeleteURLs(urls);
+  OnDeleted();
+}
+
+void LokaHistoryHandler::HandleDeleteRange(const base::ListValue& args) {
+  history::HistoryService* history = History(web_ui());
+  if (!history || args.size() < 2) {
+    return;
+  }
+  const base::Time begin =
+      base::Time::FromMillisecondsSinceUnixEpoch(args[0].GetDouble());
+  const base::Time end =
+      base::Time::FromMillisecondsSinceUnixEpoch(args[1].GetDouble());
+  history->ExpireHistoryBetween(
+      std::set<GURL>(), std::nullopt, begin, end, /*user_initiated=*/true,
+      base::BindOnce(&LokaHistoryHandler::OnDeleted,
+                     weak_factory_.GetWeakPtr()),
+      &tracker_);
+}
+
+void LokaHistoryHandler::OnDeleted() {
+  AllowJavascript();
+  FireWebUIListener("history-changed");
+}
+
+void LokaHistoryHandler::HandleOpenUrl(const base::ListValue& args) {
+  if (args.size() < 2 || !args[0].is_string()) {
+    return;
+  }
+  GURL url(args[0].GetString());
+  if (!url.is_valid() || url.SchemeIs("javascript")) {
+    return;
+  }
+  tabs::TabInterface* tab =
+      tabs::TabInterface::MaybeGetFromContents(web_ui()->GetWebContents());
+  BrowserWindowInterface* browser =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  if (!browser) {
+    return;
+  }
+  NavigateParams params(browser, url, ui::PAGE_TRANSITION_AUTO_BOOKMARK);
+  params.disposition = args[1].is_bool() && args[1].GetBool()
+                           ? WindowOpenDisposition::NEW_FOREGROUND_TAB
+                           : WindowOpenDisposition::CURRENT_TAB;
+  Navigate(&params);
+}
