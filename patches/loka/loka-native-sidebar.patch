+}
+
+base::ListValue LokaSidebarHandler::LinkPairs() {
+  base::ListValue pairs;
+  BrowserWindowInterface* browser = GetBrowser();
+  if (!browser) {
+    return pairs;
+  }
+  for (const auto& [id, browser_id] :
+       LokaSpacesService::Get(Profile::FromWebUI(web_ui()))
+           ->LinksIn(browser)
+           .entries()) {
+    base::ListValue pair;
+    pair.Append(id);
+    pair.Append(browser_id);
+    pairs.Append(std::move(pair));
+  }
+  return pairs;
+}
+
+void LokaSidebarHandler::HandleGetSpaces(const base::ListValue& args) {
+  AllowJavascript();
+  if (args.empty()) {
+    return;
+  }
+  LokaSpacesService* service =
+      LokaSpacesService::Get(Profile::FromWebUI(web_ui()));
+  // Only a window's sidebar keeps its tabs in step; the command bar,
+  // Settings and the empty tab just show the spaces.
+  const GURL& url = web_ui()->GetWebContents()->GetVisibleURL();
+  const bool sidebar =
+      url.host() == kLokaSidebarHost && !IsCommandBarPage() && !IsMenuPage();
+  service->WhenReady(base::BindOnce(
+      [](base::WeakPtr<LokaSidebarHandler> self, base::Value callback,
+         bool sidebar) {
+        if (!self || !self->IsJavascriptAllowed()) {
+          return;
+        }
+        LokaSpacesService* service =
+            LokaSpacesService::Get(Profile::FromWebUI(self->web_ui()));
+        if (sidebar && self->GetBrowser()) {
+          service->AttachWindow(self->GetBrowser());
+        }
+        self->watching_spaces_ = true;
+        if (!self->spaces_observation_.IsObserving()) {
+          self->spaces_observation_.Observe(service);
+        }
+        // Each window shows its own space.
+        base::DictValue state = loka::ToValue(service->state());
+        self->sent_space_ = service->SpaceOf(self->GetBrowser());
+        state.Set("activeSpaceId", self->sent_space_);
+        base::DictValue reply;
+        reply.Set("state", std::move(state));
+        reply.Set("links", self->LinkPairs());
+        self->ResolveJavascriptCallback(callback, reply);
+      },
+      weak_factory_.GetWeakPtr(), args[0].Clone(), sidebar));
+}
+
+void LokaSidebarHandler::HandleSpacesDo(const base::ListValue& args) {
+  if (args.size() < 2 || !args[0].is_int() || !args[1].is_dict()) {
+    return;
+  }
+  LokaSpacesService* service =
+      LokaSpacesService::Get(Profile::FromWebUI(web_ui()));
+  acking_ = args[0].GetInt();
+  acked_ = false;
+  if (!service->Apply(args[1].GetDict(), GetBrowser())) {
+    LOG(ERROR) << "Loka: the sidebar sent an intent the browser doesn't know";
+  }
+  // Nothing changed (a refused move): the page still hears its intent is
+  // done, so it drops its own copy of the change.
+  if (!acked_ && IsJavascriptAllowed()) {
+    base::DictValue ack;
+    ack.Set("ack", *acking_);
+    FireWebUIListener("spaces-changed", ack);
+  }
+  acking_.reset();
+}
+
+void LokaSidebarHandler::OnSpacesChanged(const loka::State& before,
+                                         const loka::State& after) {
+  if (!watching_spaces_ || !IsJavascriptAllowed()) {
+    return;
+  }
+  base::DictValue delta = loka::ToDelta(before, after);
+  // The saved active space is the one last used; this page shows its
+  // window's.
+  delta.Remove("activeSpaceId");
+  const std::string& space =
+      LokaSpacesService::Get(Profile::FromWebUI(web_ui()))
+          ->SpaceOf(GetBrowser());
+  if (space != sent_space_) {
+    sent_space_ = space;
+    delta.Set("activeSpaceId", space);
+  }
+  if (acking_ && !acked_) {
+    delta.Set("ack", *acking_);
+    acked_ = true;
+  }
+  if (delta.empty()) {
+    return;
+  }
+  FireWebUIListener("spaces-changed", delta);
+}
+
+void LokaSidebarHandler::OnLinksChanged(BrowserWindowInterface* window) {
+  if (!watching_spaces_ || !IsJavascriptAllowed() || window != GetBrowser()) {
+    return;
+  }
+  FireWebUIListener("links-changed", LinkPairs());
+}
+
+void LokaSidebarHandler::HandleGetStore(const base::ListValue& args) {
+  AllowJavascript();
+  sent_store_ = StoreValue();
+  ResolveJavascriptCallback(args[0], sent_store_);
+}
+
+void LokaSidebarHandler::HandleSetStore(const base::ListValue& args) {
+  if (args.size() < 2 || !args[0].is_string()) {
+    return;
+  }
+  Profile* profile = Profile::FromWebUI(web_ui());
+  // The pref tells its observers as the update ends, this handler included.
+  setting_store_ = true;
+  {
+    ScopedDictPrefUpdate update(profile->GetPrefs(), kLokaSidebarStorePref);
+    if (args[1].is_string()) {
+      update->Set(args[0].GetString(), args[1].GetString());
+    } else {
+      update->Remove(args[0].GetString());
+    }
+  }
+  setting_store_ = false;
+}
+
+void LokaSidebarHandler::HandleCreateTab(const base::ListValue& args) {
+  AllowJavascript();
+  BrowserWindowInterface* browser = GetBrowser();
+  if (!browser || args.size() < 3) {
+    ResolveJavascriptCallback(args[0], base::Value());
+    return;
+  }
+  const std::string& spec = args[1].is_string() ? args[1].GetString() : "";
+  GURL url(spec.empty() ? "chrome://newtab/" : spec);
+  NavigateParams params(browser, url, ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+  params.disposition = args[2].is_bool() && !args[2].GetBool()
+                           ? WindowOpenDisposition::NEW_BACKGROUND_TAB
+                           : WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  Navigate(&params);
+  tabs::TabInterface* tab =
+      params.navigated_or_inserted_contents
+          ? tabs::TabInterface::MaybeGetFromContents(
+                params.navigated_or_inserted_contents)
+          : nullptr;
+  // The page hears of the new tab before it gets its id.
+  SendTabsChanged();
+  ResolveJavascriptCallback(args[0],
+                            tab ? base::Value(TabId(tab)) : base::Value());
+}
+
+void LokaSidebarHandler::HandleActivateTab(const base::ListValue& args) {
+  tabs::TabInterface* tab = args.empty() ? nullptr : FindTab(args[0]);
+  if (!tab) {
+    return;
+  }
+  TabStripModel* tab_strip = GetTabStrip();
+  tab_strip->ActivateTabAt(tab_strip->GetIndexOfTab(tab));
+}
+
+void LokaSidebarHandler::HandleCloseTab(const base::ListValue& args) {
+  tabs::TabInterface* tab = args.empty() ? nullptr : FindTab(args[0]);
+  if (!tab) {
+    return;
+  }
+  TabStripModel* tab_strip = GetTabStrip();
+  tab_strip->CloseWebContentsAt(
+      tab_strip->GetIndexOfTab(tab),
+      TabCloseTypes::CLOSE_USER_GESTURE |
+          TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+}
+
+void LokaSidebarHandler::HandleNavigateTab(const base::ListValue& args) {
+  tabs::TabInterface* tab = args.size() < 2 ? nullptr : FindTab(args[0]);
+  if (!tab || !args[1].is_string()) {
+    return;
+  }
+  GURL url(args[1].GetString());
+  if (!url.is_valid()) {
+    return;
+  }
+  content::NavigationController::LoadURLParams load(url);
+  load.transition_type = ui::PAGE_TRANSITION_TYPED;
+  tab->GetContents()->GetController().LoadURLWithParams(load);
+}
