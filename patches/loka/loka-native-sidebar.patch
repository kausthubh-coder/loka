+// static
+LokaSpacesService* LokaSpacesService::Get(Profile* profile) {
+  auto* service =
+      static_cast<LokaSpacesService*>(profile->GetUserData(kServiceKey));
+  if (!service) {
+    auto made = std::make_unique<LokaSpacesService>(profile);
+    service = made.get();
+    profile->SetUserData(kServiceKey, std::move(made));
+  }
+  return service;
+}
+
+LokaSpacesService::LokaSpacesService(Profile* profile) : profile_(profile) {
+  profile_->AddObserver(this);
+  scoped_refptr<base::SequencedTaskRunner> files =
+      base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+           base::TaskShutdownBehavior::BLOCK_SHUTDOWN});
+  const base::FilePath spaces = profile_->GetPath().Append(kSpacesFile);
+  const base::FilePath archive = profile_->GetPath().Append(kArchiveFile);
+  spaces_writer_ = std::make_unique<base::ImportantFileWriter>(
+      spaces, files, kSaveAfter);
+  archive_writer_ = std::make_unique<base::ImportantFileWriter>(
+      archive, files, kSaveAfter);
+  files->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::FilePath spaces, base::FilePath archive) {
+            return std::make_pair(ReadFile(spaces), ReadFile(archive));
+          },
+          spaces, archive),
+      base::BindOnce(
+          [](base::WeakPtr<LokaSpacesService> self,
+             std::pair<std::optional<std::string>, std::optional<std::string>>
+                 files) {
+            if (self) {
+              self->OnLoaded(std::move(files.first), std::move(files.second));
+            }
+          },
+          weak_factory_.GetWeakPtr()));
+}
+
+LokaSpacesService::~LokaSpacesService() {
+  if (profile_) {
+    OnProfileWillBeDestroyed(profile_);
+  }
+}
+
+void LokaSpacesService::OnProfileWillBeDestroyed(Profile* profile) {
+  archive_timer_.Stop();
+  for (const std::unique_ptr<Window>& window : windows_) {
+    window->tab_strip->RemoveObserver(this);
+  }
+  windows_.clear();
+  // The last changes reach the disk before the profile goes.
+  if (spaces_writer_->HasPendingWrite()) {
+    spaces_writer_->DoScheduledWrite();
+  }
+  profile_->RemoveObserver(this);
+  profile_ = nullptr;
+}
+
+void LokaSpacesService::OnLoaded(std::optional<std::string> spaces,
+                                 std::optional<std::string> archive) {
+  std::optional<loka::State> loaded;
+  bool save = false;
+  if (spaces) {
+    std::optional<base::Value> value =
+        base::JSONReader::Read(*spaces, base::JSON_PARSE_RFC);
+    if (value && value->is_dict()) {
+      std::optional<base::Value> archived =
+          archive ? base::JSONReader::Read(*archive, base::JSON_PARSE_RFC)
+                  : std::nullopt;
+      value->GetDict().Set("archive", archived && archived->is_list()
+                                          ? std::move(*archived)
+                                          : base::Value(base::ListValue()));
+      loaded = loka::ImportState(*value);
+    }
+    if (!loaded) {
+      LOG(ERROR) << "Loka Spaces.json doesn't hold valid spaces; starting from "
+                    "the older copy in the profile's prefs.";
+    }
+  }
+  if (!loaded) {
+    // Migrating: the sidebar kept the spaces in the loka.store pref.
+    const std::string* old = profile_->GetPrefs()
+                                 ->GetDict(kLokaSidebarStorePref)
+                                 .FindString(kOldStateKey);
+    loaded = old ? loka::ImportStateJson(*old) : std::nullopt;
+    save = true;
+  }
+  if (!loaded) {
+    loaded = loka::FirstState(NewId());
+  }
+  state_ = std::move(*loaded);
+  ready_ = true;
+  if (save) {
+    spaces_writer_->ScheduleWrite(this);
+    SaveArchive();
+  }
+  archive_timer_.Start(FROM_HERE, kArchiveEvery,
+                       base::BindRepeating(&LokaSpacesService::ArchiveOld,
+                                           base::Unretained(this)));
+  std::vector<base::OnceClosure> waiting = std::move(when_ready_);
+  for (base::OnceClosure& done : waiting) {
+    std::move(done).Run();
+  }
+}
+
+void LokaSpacesService::WhenReady(base::OnceClosure done) {
+  if (ready_) {
+    std::move(done).Run();
+    return;
+  }
+  when_ready_.push_back(std::move(done));
+}
+
+std::optional<std::string> LokaSpacesService::SerializeData() {
+  base::DictValue value = loka::ToValue(state_);
+  value.Remove("archive");
+  return base::WriteJson(value);
+}
+
+void LokaSpacesService::SaveArchive() {
+  base::DictValue value = loka::ToValue(state_);
+  if (std::optional<std::string> json = base::WriteJson(*value.Find("archive"))) {
+    archive_writer_->WriteNow(std::move(*json));
+  }
+}
+
+void LokaSpacesService::Commit(loka::State next) {
+  bool moved = false;
+  for (const std::unique_ptr<Window>& window : windows_) {
+    if (!loka::FindSpace(next, window->space)) {
+      window->space = next.active_space_id;
+    }
+    if (window->space != window->told_space) {
+      window->told_space = window->space;
+      moved = true;
+    }
+  }
+  if (next == state_ && !moved) {
+    return;
+  }
+  loka::State before = std::exchange(state_, std::move(next));
+  if (!(before == state_)) {
+    spaces_writer_->ScheduleWrite(this);
+    // A kept history goes when its tab leaves the spaces (deleted or archived).
+    std::erase_if(histories_, [&](const auto& kept) {
+      return !state_.tabs.contains(kept.first);
+    });
+  }
+  if (before.archive != state_.archive) {
+    SaveArchive();
+  }
+  for (Observer& observer : observers_) {
+    observer.OnSpacesChanged(before, state_);
+  }
+}
+
+loka::State LokaSpacesService::ViewOf(const Window& window) const {
+  loka::State view = state_;
+  view.active_space_id = window.space;
+  return view;
+}
+
+loka::State LokaSpacesService::TakeView(Window& window,
+                                        loka::State view,
+                                        bool used) {
+  const bool switched = view.active_space_id != window.space;
+  window.space = view.active_space_id;
+  if (!used && !switched && loka::FindSpace(view, state_.active_space_id)) {
+    view.active_space_id = state_.active_space_id;
+  }
+  return view;
+}
+
+const std::string& LokaSpacesService::SpaceOf(
+    BrowserWindowInterface* browser) const {
+  for (const std::unique_ptr<Window>& window : windows_) {
+    if (window->browser == browser) {
+      return window->space;
+    }
+  }
+  return state_.active_space_id;
+}
+
+bool LokaSpacesService::Apply(const base::DictValue& intent,
+                              BrowserWindowInterface* from) {
+  if (!ready_) {
+    return false;
+  }
+  Window* window = FindWindow(from);
+  std::optional<loka::State> next =
+      loka::ApplyIntent(window ? ViewOf(*window) : state_, intent);
+  if (!next) {
+    return false;
+  }
+  const std::string* op = intent.FindString("op");
+  if (op && *op == "replaceState" && !(*next == state_)) {
+    // New spaces (an import, another device's): the old links mean nothing
+    // in them, so the open tabs are matched again by address, as at startup.
+    // Without this, every tab not in the new spaces would close.
+    for (const std::unique_ptr<Window>& each : windows_) {
+      each->live = loka::LiveMap();
+      each->groups.clear();
+    }
+    AdoptAll(std::move(*next), /*keep_unloaded=*/true);
+    return true;
+  }
+  if (window) {
+    next = TakeView(*window, std::move(*next), /*used=*/true);
+  }
+  Commit(std::move(*next));
+  // The window that asked follows the intent. Others only close and regroup
+  // tabs: they keep their own space and the tab on screen.
+  for (const std::unique_ptr<Window>& each : windows_) {
+    Schedule(*each, !window || each.get() == window ? Pass::kUi
+                                                    : Pass::kBrowser);
+  }
+  return true;
+}
+
+void LokaSpacesService::AttachWindow(BrowserWindowInterface* browser) {
+  if (!profile_ || FindWindow(browser)) {
+    return;
+  }
+  if (!ready_) {
+    WhenReady(base::BindOnce(&LokaSpacesService::AttachWindow,
+                             weak_factory_.GetWeakPtr(),
+                             base::Unretained(browser)));
+    return;
+  }
+  auto attach = [this](BrowserWindowInterface* each) {
+    if (FindWindow(each)) {
+      return;
+    }
+    auto window = std::make_unique<Window>();
+    window->browser = each;
+    window->tab_strip = each->GetTabStripModel();
+    window->number = next_window_number_++;
+    // A new window opens on the space last used.
+    window->space = state_.active_space_id;
+    window->told_space = window->space;
+    window->shown_space = window->space;
+    each->GetTabStripModel()->AddObserver(this);
+    windows_.push_back(std::move(window));
+  };
+  if (adopted_) {
+    // A window opened later: its tabs come in as new ones at the first look.
+    attach(browser);
+    Schedule(*windows_.back(), Pass::kBrowser);
+    return;
+  }
+  // The first sidebar: take over every window's tabs at once, so a window
+  // whose sidebar loads later doesn't lose its open tabs.
+  for (BrowserWindowInterface* each : GetAllBrowserWindowInterfaces()) {
+    if (each->GetProfile() == profile_ &&
+        each->GetType() == BrowserWindowInterface::TYPE_NORMAL) {
+      attach(each);
+    }
+  }
+  attach(browser);
+  AdoptAll(state_, /*keep_unloaded=*/false);
+}
+
+void LokaSpacesService::AdoptAll(const loka::State& from,
+                                 bool keep_unloaded) {
+  adopted_ = true;
+  std::vector<loka::BrowserTab> tabs;
+  for (const std::unique_ptr<Window>& window : windows_) {
+    std::vector<loka::BrowserTab> each = TabsOf(*window);
+    for (const loka::BrowserTab& tab : each) {
+      window->seen[tab.id] = tab;
+    }
+    tabs.insert(tabs.end(), each.begin(), each.end());
+  }
+  auto [next, live] =
+      loka::AdoptTabs(from, tabs, Now(), [] { return NewId(); }, keep_unloaded);
+  for (const auto& [lokaId, browser_id] : live.entries()) {
+    for (const std::unique_ptr<Window>& window : windows_) {
+      if (window->seen.contains(browser_id)) {
+        window->live.Set(lokaId, browser_id);
+        break;
+      }
+    }
+  }
+  // Each window shows the space of the tab on screen, so windows restored
+  // after a restart keep their spaces; a window on an Essential or an empty
+  // tab shows the space last used.
+  const std::string last_used = next.active_space_id;
+  for (const std::unique_ptr<Window>& window : windows_) {
+    window->space = last_used;
+    auto shown = std::ranges::find_if(window->seen, [](const auto& entry) {
+      return entry.second.active;
+    });
+    std::optional<loka::TabId> id =
+        shown == window->seen.end() ? std::nullopt
+                                    : window->live.TabIdOf(shown->first);
+    std::optional<std::string> home =
+        id ? loka::HomeOf(next, *id) : std::nullopt;
+    if (home && *home != "essentials") {
+      loka::State view = std::move(next);
+      view.active_space_id = *home;
+      next = loka::TabActivated(view, window->live, shown->first, Now());
+      window->space = next.active_space_id;
+      next.active_space_id = last_used;
+    }
+    window->shown_space = window->space;
+  }
+  Commit(std::move(next));
+  for (const std::unique_ptr<Window>& window : windows_) {
+    LinksChanged(*window);
+    Schedule(*window, Pass::kBrowser);
+  }
+}
+
+const loka::LiveMap& LokaSpacesService::LinksIn(
+    BrowserWindowInterface* browser) const {
+  static const base::NoDestructor<loka::LiveMap> kNone;
+  for (const std::unique_ptr<Window>& window : windows_) {
+    if (window->browser == browser) {
+      return window->live;
+    }
+  }
+  return *kNone;
+}
+
+void LokaSpacesService::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void LokaSpacesService::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+LokaSpacesService::Window* LokaSpacesService::FindWindow(
+    BrowserWindowInterface* browser) {
+  for (const std::unique_ptr<Window>& window : windows_) {
+    if (window->browser == browser) {
+      return window.get();
+    }
+  }
+  return nullptr;
+}
+
+LokaSpacesService::Window* LokaSpacesService::FindWindow(
+    TabStripModel* tab_strip) {
+  for (const std::unique_ptr<Window>& window : windows_) {
+    if (window->tab_strip == tab_strip) {
+      return window.get();
+    }
+  }
+  return nullptr;
+}
+
+void LokaSpacesService::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  Window* window = FindWindow(tab_strip_model);
+  if (!window) {
+    return;
+  }
+  // A closing tab's page is still here: a pinned tab or Essential keeps its
+  // history for when it opens again.
+  if (change.type() == TabStripModelChange::kRemoved) {
+    for (const TabStripModelChange::RemovedTab& removed :
+         change.GetRemove()->contents) {
+      if (removed.tab && removed.contents &&
+          TabRemoveReasonUtils::WillDeleteWebContents(removed.remove_reason)) {
+        KeepHistory(*window, TabNumber(removed.tab), removed.contents);
+      }
+    }
+  }
+  Schedule(*window, Pass::kBrowser);
+}
+
+void LokaSpacesService::KeepHistory(Window& window,
+                                    int browser_id,
+                                    content::WebContents* page) {
+  std::optional<loka::TabId> id = window.live.TabIdOf(browser_id);
+  if (!id || !state_.tabs.contains(*id)) {
+    return;
+  }
+  const bool open = std::ranges::any_of(
+      state_.spaces,
+      [&](const loka::Space& space) {
+        return std::ranges::contains(space.open, *id);
+      });
+  if (open) {
+    return;
+  }
+  content::NavigationController& controller = page->GetController();
+  History history;
+  for (int i = 0; i < controller.GetEntryCount(); ++i) {
+    content::NavigationEntry* entry = controller.GetEntryAtIndex(i);
+    if (entry->IsInitialEntry()) {
+      continue;
+    }
+    if (i == controller.GetLastCommittedEntryIndex()) {
+      history.selected = static_cast<int>(history.entries.size());
+    }
+    history.entries.push_back(
+        sessions::ContentSerializedNavigationBuilder::FromNavigationEntry(
+            static_cast<int>(history.entries.size()), entry));
+  }
+  if (history.entries.empty()) {
+    histories_.erase(*id);
+    return;
+  }
+  histories_[*id] = std::move(history);
+}
+
+std::optional<int> LokaSpacesService::OpenWithHistory(Window& window,
+                                                      const loka::TabId& id) {
+  auto kept = histories_.find(id);
+  if (kept == histories_.end()) {
+    return std::nullopt;
+  }
+  History history = std::move(kept->second);
+  histories_.erase(kept);
+  const loka::Tab& tab = state_.tabs.at(id);
+  // Forward history goes, as a new page would drop it; the tab's own address
+  // comes next, unless that's where it already was.
+  history.entries.resize(history.selected + 1);
+  const GURL home(tab.url);
+  if (history.entries.back().virtual_url() != home) {
+    sessions::SerializedNavigationEntry entry;
+    entry.set_index(static_cast<int>(history.entries.size()));
+    entry.set_virtual_url(home);
+    entry.set_original_request_url(home);
+    entry.set_title(base::UTF8ToUTF16(tab.title));
+    entry.set_transition_type(ui::PAGE_TRANSITION_AUTO_BOOKMARK);
+    entry.set_timestamp(base::Time::Now());
+    history.entries.push_back(std::move(entry));
+  }
+  content::WebContents* page = chrome::AddRestoredTab(
+      window.browser, history.entries, window.tab_strip->count(),
+      static_cast<int>(history.entries.size()) - 1,
+      /*extension_app_id=*/std::string(), /*group=*/std::nullopt,
+      /*select=*/true, /*pin=*/false, base::TimeTicks::Now(), base::Time::Now(),
+      /*storage_namespace=*/nullptr, sessions::SerializedUserAgentOverride(),
+      /*extra_data=*/{}, /*from_session_restore=*/false,
+      /*is_active_browser=*/std::nullopt);
+  tabs::TabInterface* made =
+      page ? tabs::TabInterface::MaybeGetFromContents(page) : nullptr;
+  return made ? std::optional<int>(TabNumber(made)) : std::nullopt;
+}
+
+void LokaSpacesService::OnTabChangedAt(tabs::TabInterface* tab,
+                                       TabChangeType change_type) {
+  // Spinners and progress change many times a second; only an address or
+  // title matters to the spaces.
+  if (change_type != TabChangeType::kAll) {
+    return;
+  }
+  if (Window* window = FindWindow(tab->GetBrowserWindowInterface())) {
+    Schedule(*window, Pass::kBrowser);
+  }
+}
+
+void LokaSpacesService::OnTabStripModelDestroyed(
+    TabStripModel* tab_strip_model) {
+  // The window is going: it's half torn down, so only its tab strip, kept
+  // from when it was attached, is safe to compare. TabStripModelObserver has
+  // already stopped observing it.
+  std::erase_if(windows_, [&](const std::unique_ptr<Window>& window) {
+    return window->tab_strip == tab_strip_model;
+  });
+}
+
+int LokaSpacesService::GroupNumber(const tab_groups::TabGroupId& group) {
+  auto [it, inserted] = group_numbers_.try_emplace(group, next_group_number_);
+  if (inserted) {
+    ++next_group_number_;
+  }
+  return it->second;
+}
+
+std::optional<tab_groups::TabGroupId> LokaSpacesService::GroupFromNumber(
+    int number) {
+  for (const auto& [group, n] : group_numbers_) {
+    if (n == number) {
+      return group;
+    }
+  }
+  return std::nullopt;
+}
+
+std::vector<loka::BrowserTab> LokaSpacesService::TabsOf(Window& window) {
+  std::vector<loka::BrowserTab> tabs;
+  TabStripModel* tab_strip = window.tab_strip;
+  for (int i = 0; i < tab_strip->count(); ++i) {
+    tabs::TabInterface* tab = tab_strip->GetTabAtIndex(i);
+    TabUIHelper* helper = TabUIHelper::From(tab);
+    GURL url = helper ? helper->GetLastCommittedURL() : GURL();
+    if ((!url.is_valid() || url.is_empty()) && helper) {
+      url = helper->GetVisibleURL();
+    }
+    loka::BrowserTab each;
+    each.id = TabNumber(tab);
+    each.url = url.spec();
+    each.title = helper ? base::UTF16ToUTF8(helper->GetTitle()) : std::string();
+    each.active = i == tab_strip->active_index();
+    std::optional<tab_groups::TabGroupId> group = tab->GetGroup();
+    each.group_id = group ? GroupNumber(*group) : -1;
+    each.window_id = window.number;
+    if (tabs::TabInterface* opener = tab_strip->GetOpenerOfTabAt(i)) {
+      each.opener_tab_id = TabNumber(opener);
+    }
+    each.last_accessed =
+        tab->GetContents()->GetLastActiveTime().InMillisecondsFSinceUnixEpoch();
+    if (const std::string* kept = SessionServiceBase::GetKeptTabData(
+            tab->GetContents(), kLokaTabKey)) {
+      each.loka_id = *kept;
+    }
+    tabs.push_back(std::move(each));
+  }
+  return tabs;
+}
+
+void LokaSpacesService::Schedule(Window& window, Pass pass) {
+  if (pass == Pass::kUi) {
+    window.ui_pass = true;
+  }
+  if (window.pending) {
+    return;
+  }
+  window.pending = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&LokaSpacesService::LookAndPass,
+                                weak_factory_.GetWeakPtr(), window.number));
+}
+
+void LokaSpacesService::LookAndPass(int window_number) {
+  auto it = std::ranges::find(windows_, window_number,
+                              [](const std::unique_ptr<Window>& window) {
+                                return window->number;
+                              });
+  if (it == windows_.end() || !profile_) {
+    return;
+  }
+  Window& window = **it;
+  window.pending = false;
+  Look(window);
+  const Pass pass = window.ui_pass ? Pass::kUi : Pass::kBrowser;
+  window.ui_pass = false;
+  Reconcile(window, pass);
+}
+
+void LokaSpacesService::Look(Window& window) {
+  std::vector<loka::BrowserTab> tabs = TabsOf(window);
+  std::map<int, loka::BrowserTab> before = std::move(window.seen);
+  // A tab keeps the opener it had when first seen: a new tab waits for its
+  // first page before joining a space, and if the tab that opened it (an
+  // empty tab) closes meanwhile, the browser hands it that tab's opener,
+  // which may be in another space.
+  for (loka::BrowserTab& tab : tabs) {
+    if (auto old = before.find(tab.id); old != before.end()) {
+      tab.opener_tab_id = old->second.opener_tab_id;
+    }
+  }
+  window.seen.clear();
+  for (const loka::BrowserTab& tab : tabs) {
+    window.seen[tab.id] = tab;
+  }
+  loka::State next = ViewOf(window);
+  const loka::LiveMap links = window.live;
+  for (const loka::BrowserTab& tab : tabs) {
+    auto old = before.find(tab.id);
+    if (old == before.end()) {
+      if (window.empty_tabs.erase(tab.id)) {
+        continue;
+      }
+      // A tab dragged in from another window brings its link along.
+      for (const std::unique_ptr<Window>& other : windows_) {
+        if (other.get() == &window) {
+          continue;
+        }
+        if (std::optional<loka::TabId> id = other->live.TabIdOf(tab.id)) {
+          other->live.Erase(*id);
+          window.live.Set(*id, tab.id);
+          LinksChanged(*other);
+        }
+      }
+      std::tie(next, window.live) = loka::TabCreated(
+          next, window.live, tab, Now(), std::nullopt, [] { return NewId(); });
+      continue;
+    }
+    if (old->second.title != tab.title || old->second.url != tab.url) {
+      std::tie(next, window.live) =
+          loka::TabUpdated(next, window.live, tab, Now(), [] { return NewId(); });
+    }
+    if (tab.active && !old->second.active) {
+      next = loka::TabActivated(next, window.live, tab.id, Now());
+    }
+  }
+  for (const auto& [id, tab] : before) {
+    if (window.seen.contains(id)) {
+      continue;
+    }
+    // Moving to another window isn't closing: that window takes the link.
+    tabs::TabInterface* still = tabs::TabHandle(id).Get();
+    if (still && still->GetBrowserWindowInterface() &&
+        FindWindow(still->GetBrowserWindowInterface())) {
+      continue;
+    }
+    std::tie(next, window.live) =
+        loka::TabRemoved(next, window.live, id, Now());
+  }
+  next = TakeView(window, std::move(next), /*used=*/false);
+  const bool changed = !(next == state_);
+  Commit(std::move(next));
+  if (!(links == window.live)) {
+    LinksChanged(window);
+  }
+  // Other windows close and regroup tabs to match, keeping their focus.
+  if (changed) {
+    for (const std::unique_ptr<Window>& other : windows_) {
+      if (other.get() != &window) {
+        Schedule(*other, Pass::kBrowser);
+      }
+    }
+  }
+}
+
+void LokaSpacesService::Reconcile(Window& window, Pass pass) {
+  TabStripModel* tab_strip = window.tab_strip;
+  // Groups closed by hand are forgotten.
+  std::set<int> known;
+  if (tab_strip->group_model()) {
+    for (const tab_groups::TabGroupId& group :
+         tab_strip->group_model()->ListTabGroups()) {
+      known.insert(GroupNumber(group));
+    }
+  }
+  std::erase_if(window.groups, [&](const auto& entry) {
+    return !known.contains(entry.second.id);
+  });
+  std::vector<loka::BrowserTab> tabs = TabsOf(window);
+  // The window is never left on another space's tab: after a switch, or when
+  // the tab on screen was just moved to another space, it shows this space's
+  // tab (or a new empty one).
+  auto on_screen = std::ranges::find_if(tabs, &loka::BrowserTab::active);
+  std::optional<loka::TabId> on_screen_loka =
+      on_screen == tabs.end() ? std::nullopt
+                              : window.live.TabIdOf(on_screen->id);
+  std::optional<std::string> home =
+      on_screen_loka ? loka::HomeOf(state_, *on_screen_loka) : std::nullopt;
+  const bool elsewhere =
+      home && *home != "essentials" && *home != window.space;
+  const bool switched =
+      pass == Pass::kUi && (window.shown_space != window.space || elsewhere);
+  window.shown_space = window.space;
+  const loka::LiveMap links = window.live;
+  for (const loka::Op& op : loka::PlanReconcile(ViewOf(window), window.live,
+                                                tabs, window.groups,
+                                                switched)) {
+    const bool moves_focus = op.kind == loka::Op::Kind::kActivate ||
+                             op.kind == loka::Op::Kind::kCreate ||
+                             op.kind == loka::Op::Kind::kEmptyTab;
+    if (pass == Pass::kUi || !moves_focus) {
+      Run(window, op);
+    }
+  }
+  if (!(links == window.live)) {
+    LinksChanged(window);
+  }
+}
+
+void LokaSpacesService::LinksChanged(Window& window) {
+  if (SessionService* session =
+          SessionServiceFactory::GetForProfileIfExisting(profile_)) {
+    for (const auto& [id, browser_id] : window.live.entries()) {
+      tabs::TabInterface* tab = tabs::TabHandle(browser_id).Get();
+      if (!tab) {
+        continue;
+      }
+      const std::string* kept =
+          SessionServiceBase::GetKeptTabData(tab->GetContents(), kLokaTabKey);
+      if (!kept || *kept != id) {
+        session->SetKeptTabData(tab->GetContents(), kLokaTabKey, id);
+      }
+    }
+  }
+  for (Observer& observer : observers_) {
+    observer.OnLinksChanged(window.browser);
+  }
+}
+
+void LokaSpacesService::Run(Window& window, const loka::Op& op) {
+  BrowserWindowInterface* browser = window.browser;
+  TabStripModel* tab_strip = window.tab_strip;
+  auto index_of = [&](int id) {
+    tabs::TabInterface* tab = tabs::TabHandle(id).Get();
+    return tab ? tab_strip->GetIndexOfTab(tab) : TabStripModel::kNoTab;
+  };
+  auto indices_of = [&](const std::vector<int>& ids) {
+    std::vector<int> indices;
+    for (int id : ids) {
+      int index = index_of(id);
+      if (index != TabStripModel::kNoTab) {
+        indices.push_back(index);
+      }
+    }
+    std::ranges::sort(indices);
+    return indices;
+  };
+  auto open = [&](const std::string& spec) -> std::optional<int> {
+    NavigateParams params(browser, GURL(spec), ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+    params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+    Navigate(&params);
+    tabs::TabInterface* tab =
+        params.navigated_or_inserted_contents
+            ? tabs::TabInterface::MaybeGetFromContents(
+                  params.navigated_or_inserted_contents)
+            : nullptr;
+    return tab ? std::optional<int>(TabNumber(tab)) : std::nullopt;
+  };
+  auto visuals = [&](int group_number, const std::optional<std::string>& title,
+                     const std::optional<std::string>& color,
+                     std::optional<bool> collapsed) {
+    std::optional<tab_groups::TabGroupId> id = GroupFromNumber(group_number);
+    if (!id || !tab_strip->group_model()->ContainsTabGroup(*id)) {
+      return;
+    }
+    const tab_groups::TabGroupVisualData* old =
+        tab_strip->group_model()->GetTabGroup(*id)->visual_data();
+    tab_strip->ChangeTabGroupVisuals(
+        *id, tab_groups::TabGroupVisualData(
+                 title ? base::UTF8ToUTF16(*title) : old->title(),
+                 color ? ColorFromName(*color) : old->color(),
+                 collapsed.value_or(old->is_collapsed())));
+  };
+  auto record = [&](const std::string& key) -> loka::GroupRecord* {
+    auto it = std::ranges::find(
+        window.groups, key,
+        &std::pair<std::string, loka::GroupRecord>::first);
+    return it == window.groups.end() ? nullptr : &it->second;
+  };
+
+  switch (op.kind) {
+    case loka::Op::Kind::kCreate: {
+      std::optional<int> made = OpenWithHistory(window, op.tab_id);
+      if (!made) {
+        made = open(state_.tabs.at(op.tab_id).url);
+      }
+      if (made) {
+        window.live.Set(op.tab_id, *made);
+        // Seen now, so the next look doesn't take it for a tab of its own.
+        for (const loka::BrowserTab& tab : TabsOf(window)) {
+          if (tab.id == *made) {
+            window.seen[tab.id] = tab;
+          }
+        }
+      }
+      break;
+    }
+    case loka::Op::Kind::kEmptyTab:
+      if (std::optional<int> made = open("chrome://newtab/")) {
+        window.empty_tabs.insert(*made);
+      }
+      break;
+    case loka::Op::Kind::kActivate: {
+      int index = index_of(op.browser_id);
+      if (index != TabStripModel::kNoTab) {
+        tab_strip->ActivateTabAt(index);
+      }
+      break;
+    }
+    case loka::Op::Kind::kRemove: {
+      int index = index_of(op.browser_id);
+      if (index != TabStripModel::kNoTab) {
+        tab_strip->CloseWebContentsAt(
+            index, TabCloseTypes::CLOSE_USER_GESTURE |
+                       TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+      }
+      break;
+    }
+    case loka::Op::Kind::kGroup: {
+      std::vector<int> indices = indices_of(op.browser_ids);
+      if (indices.empty()) {
+        break;
+      }
+      loka::GroupRecord* existing = record(op.key);
+      std::optional<tab_groups::TabGroupId> group =
+          existing ? GroupFromNumber(existing->id) : std::nullopt;
+      if (group && tab_strip->group_model()->ContainsTabGroup(*group)) {
+        tab_strip->AddToExistingGroup(indices, *group);
+      } else {
+        group = tab_strip->AddToNewGroup(indices);
+      }
+      const int number = GroupNumber(*group);
+      visuals(number, op.title, op.color, false);
+      loka::GroupRecord fresh{number, false, op.title, op.color};
+      if (loka::GroupRecord* kept = record(op.key)) {
+        *kept = fresh;
+      } else {
+        window.groups.emplace_back(op.key, fresh);
+      }
+      break;
+    }
+    case loka::Op::Kind::kLook:
+      visuals(op.group_id, op.title, op.color, std::nullopt);
+      if (loka::GroupRecord* kept = record(op.key)) {
+        kept->title = op.title;
+        kept->color = op.color;
+      }
+      break;
+    case loka::Op::Kind::kUngroup: {
+      std::vector<int> indices = indices_of(op.browser_ids);
+      if (!indices.empty()) {
+        tab_strip->RemoveFromGroup(indices);
+      }
+      break;
+    }
+    case loka::Op::Kind::kCollapse:
+      visuals(op.group_id, std::nullopt, std::nullopt, op.collapsed);
+      for (auto& [key, group] : window.groups) {
+        if (group.id == op.group_id) {
+          group.collapsed = op.collapsed;
+        }
+      }
+      break;
+  }
+}
+
+void LokaSpacesService::ArchiveOld() {
+  if (!profile_) {
+    return;
+  }
+  const double hours =
+      ArchiveHours(profile_->GetPrefs()->GetDict(kLokaSidebarStorePref).FindString(
+          kUiKey));
+  if (hours <= 0) {
+    return;
+  }
+  // A tab playing sound stays, however long ago it was shown.
+  std::set<loka::TabId> audible;
+  for (const std::unique_ptr<Window>& window : windows_) {
+    for (const auto& [id, browser_id] : window->live.entries()) {
+      tabs::TabInterface* tab = tabs::TabHandle(browser_id).Get();
+      if (tab && tab->GetContents()->IsCurrentlyAudible()) {
+        audible.insert(id);
+      }
+    }
+  }
+  loka::State next =
+      loka::ArchiveStale(state_, Now(), hours * 60 * 60 * 1000, audible);
+  if (next == state_) {
+    return;
+  }
+  Commit(std::move(next));
+  // Archived tabs' browser tabs close; nothing else moves.
+  for (const std::unique_ptr<Window>& window : windows_) {
+    Schedule(*window, Pass::kBrowser);
+  }
+}
