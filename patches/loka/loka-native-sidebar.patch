+class BrowserWindowInterface;
+class Profile;
+
+namespace content {
+class WebContents;
+}
+class TabStripModel;
+
+// Loka's spaces for one profile, owned in the browser process: the model
+// (components/loka/core), saving it, and keeping every window's real tabs in
+// step with it. The sidebar pages show it and send intents
+// (intents.logic.ts); they never write the spaces themselves.
+//
+// Saved in the profile as "Loka Spaces.json", the archive apart in "Loka
+// Archive.json", through ImportantFileWriter: batched, written off the UI
+// thread, atomically. The first run takes the spaces the sidebar used to keep
+// in the loka.store pref, and leaves the pref as it was, so going back to an
+// older build loses nothing.
+//
+// Each window keeps its own links (which browser tab shows which Loka tab),
+// tab groups (one per space shown in it) and space: two windows can show two
+// spaces. The model knows one active space, so each window's events and
+// intents run on the spaces with its own space made the active one; the saved
+// active space is the one last used, which a new window opens on. The same
+// two rules as the page's sync hold: only Loka moves a window's focus (a pass
+// after that window's intent may activate and open tabs; a pass after the
+// browser's own events, or another window's intent, never does), and every
+// change starts from the current spaces, so nothing is written over.
+class LokaSpacesService : public base::SupportsUserData::Data,
+                          public ProfileObserver,
+                          public TabStripModelObserver,
+                          public base::ImportantFileWriter::DataSerializer {
+ public:
+  class Observer : public base::CheckedObserver {
+   public:
+    // The spaces changed from `before` to `after`, or a window's space did
+    // (SpaceOf).
+    virtual void OnSpacesChanged(const loka::State& before,
+                                 const loka::State& after) {}
+    // The links of `window`'s tabs to Loka's changed.
+    virtual void OnLinksChanged(BrowserWindowInterface* window) {}
+  };
+
+  // The profile's service, made on first use.
+  static LokaSpacesService* Get(Profile* profile);
+
+  explicit LokaSpacesService(Profile* profile);
+  LokaSpacesService(const LokaSpacesService&) = delete;
+  LokaSpacesService& operator=(const LokaSpacesService&) = delete;
+  ~LokaSpacesService() override;
+
+  // Runs `done` once the saved spaces are read (at once if they are).
+  void WhenReady(base::OnceClosure done);
+  bool ready() const { return ready_; }
+  const loka::State& state() const { return state_; }
+
+  // Applies the intent of a page in `from` (null: a page in no window). False
+  // when it isn't one; true otherwise, also when the rules refused it and
+  // nothing changed.
+  bool Apply(const base::DictValue& intent, BrowserWindowInterface* from);
+
+  // Starts keeping `window`'s tabs in step. Its sidebar calls this once loaded.
+  void AttachWindow(BrowserWindowInterface* window);
+  // The space `window` shows; the one last used for a window Loka doesn't
+  // keep.
+  const std::string& SpaceOf(BrowserWindowInterface* window) const;
+  // Which browser tab (by TabHandle) shows each loaded Loka tab in `window`.
+  const loka::LiveMap& LinksIn(BrowserWindowInterface* window) const;
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  // ProfileObserver:
+  void OnProfileWillBeDestroyed(Profile* profile) override;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(TabStripModel* tab_strip_model,
+                              const TabStripModelChange& change,
+                              const TabStripSelectionChange& selection) override;
+  void OnTabChangedAt(tabs::TabInterface* tab,
+                      TabChangeType change_type) override;
+  void OnTabStripModelDestroyed(TabStripModel* tab_strip_model) override;
+
+  // base::ImportantFileWriter::DataSerializer:
+  std::optional<std::string> SerializeData() override;
+
+ private:
+  // Why a window's tabs are being brought in step: after an intent (Loka may
+  // move focus and open tabs), or after the browser's own events (it may not).
+  enum class Pass { kUi, kBrowser };
+
+  struct Window {
+    Window();
+    Window(const Window&) = delete;
+    Window& operator=(const Window&) = delete;
+    ~Window();
+
+    raw_ptr<BrowserWindowInterface> browser;
+    raw_ptr<TabStripModel> tab_strip;
+    int number = 0;
+    loka::LiveMap live;
+    loka::Groups groups;
+    // The space the window shows.
+    std::string space;
+    // The space observers last heard it shows.
+    std::string told_space;
+    // The space the window was last made to show, to notice a switch.
+    std::string shown_space;
+    // Each tab as last seen, to turn the next look into events.
+    std::map<int, loka::BrowserTab> seen;
+    // Empty tabs Loka opened here, until a look sees them.
+    std::set<int> empty_tabs;
+    // A look and pass is posted.
+    bool pending = false;
+    // A pass after an intent is owed.
+    bool ui_pass = false;
+  };
+
+  // A pinned tab's or Essential's Back history, kept while it's unloaded so
+  // opening it again can go back to where it was.
+  struct History {
+    History();
+    History(const History&);
+    History& operator=(const History&);
+    ~History();
+
+    std::vector<sessions::SerializedNavigationEntry> entries;
+    int selected = 0;
+  };
+
+  void OnLoaded(std::optional<std::string> spaces,
+                std::optional<std::string> archive);
+  // Keeps the history of `window`'s browser tab `browser_id`, about to be
+  // closed, when it shows a pinned tab or Essential.
+  void KeepHistory(Window& window, int browser_id, content::WebContents* page);
+  // Opens Loka tab `id` in `window` from its kept history, then at its own
+  // address: Back goes to where it was when it unloaded. Null when it has no
+  // kept history.
+  std::optional<int> OpenWithHistory(Window& window, const loka::TabId& id);
+  // Makes `next` the spaces: saves, tells observers, also when only a
+  // window's space changed. A window whose space is gone shows the one last
+  // used.
+  void Commit(loka::State next);
+  // The spaces as `window` sees them: its space is the active one.
+  loka::State ViewOf(const Window& window) const;
+  // Takes `window`'s space from `view` (ViewOf after a change) and gives
+  // `view` back as the spaces, its active space the one last used: this
+  // window's when `used`, or when its space changed.
+  loka::State TakeView(Window& window, loka::State view, bool used);
+  // Writes the archive's own file now: it changes at most once a minute.
+  void SaveArchive();
+
+  Window* FindWindow(BrowserWindowInterface* browser);
+  Window* FindWindow(TabStripModel* tab_strip);
+  std::vector<loka::BrowserTab> TabsOf(Window& window);
+  int GroupNumber(const tab_groups::TabGroupId& group);
+  std::optional<tab_groups::TabGroupId> GroupFromNumber(int number);
+  // Asks for a look at `window`'s tabs and a pass after it, once per task.
+  void Schedule(Window& window, Pass pass);
+  void LookAndPass(int window_number);
+  // Turns what changed in `window`'s tabs since the last look into model
+  // events.
+  void Look(Window& window);
+  void Reconcile(Window& window, Pass pass);
+  // Saves in the session which Loka tab each of `window`'s tabs shows, and
+  // tells observers its links changed.
+  void LinksChanged(Window& window);
+  void Run(Window& window, const loka::Op& op);
+  void ArchiveOld();
+  // Takes over the tabs every open window already has, matching them by
+  // address to the tabs in `from`, which become the spaces: once the spaces
+  // are read and the first sidebar has loaded, and after spaces are replaced
+  // (`keep_unloaded`: the new spaces' open tabs stay though no tab shows them).
+  void AdoptAll(const loka::State& from, bool keep_unloaded);
+
+  raw_ptr<Profile> profile_;
+  bool ready_ = false;
+  bool adopted_ = false;
+  std::vector<base::OnceClosure> when_ready_;
+  loka::State state_;
+  std::vector<std::unique_ptr<Window>> windows_;
+  int next_window_number_ = 1;
+  std::map<tab_groups::TabGroupId, int> group_numbers_;
+  int next_group_number_ = 1;
+  std::unique_ptr<base::ImportantFileWriter> spaces_writer_;
+  std::unique_ptr<base::ImportantFileWriter> archive_writer_;
+  // Kept until the browser quits: an unloaded tab after a restart opens with
+  // no Back history, as before.
+  std::map<loka::TabId, History> histories_;
+  base::RepeatingTimer archive_timer_;
+  base::ObserverList<Observer> observers_;
+  base::WeakPtrFactory<LokaSpacesService> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_LOKA_SIDEBAR_LOKA_SPACES_SERVICE_H_
