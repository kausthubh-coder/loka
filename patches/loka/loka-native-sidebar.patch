+void LokaSidebarHandler::HandleReload(const base::ListValue& args) {
+  tabs::TabInterface* tab = args.empty() ? nullptr : FindTab(args[0]);
+  if (tab) {
+    tab->GetContents()->GetController().Reload(content::ReloadType::NORMAL,
+                                               /*check_for_repost=*/true);
+  }
+}
+
+void LokaSidebarHandler::HandleSetMuted(const base::ListValue& args) {
+  tabs::TabInterface* tab = args.size() < 2 ? nullptr : FindTab(args[0]);
+  if (tab && args[1].is_bool()) {
+    tab->GetContents()->SetAudioMuted(args[1].GetBool());
+  }
+}
+
+void LokaSidebarHandler::HandleSearch(const base::ListValue& args) {
+  BrowserWindowInterface* browser = GetBrowser();
+  if (!browser || args.size() < 2 || !args[0].is_string()) {
+    return;
+  }
+  TemplateURLService* service =
+      TemplateURLServiceFactory::GetForProfile(Profile::FromWebUI(web_ui()));
+  const TemplateURL* engine =
+      service ? service->GetDefaultSearchProvider() : nullptr;
+  if (!engine) {
+    return;
+  }
+  GURL url = engine->GenerateSearchURL(service->search_terms_data(),
+                                       base::UTF8ToUTF16(args[0].GetString()));
+  const bool new_tab = !args[1].is_bool() || args[1].GetBool();
+  NavigateParams params(browser, url, ui::PAGE_TRANSITION_GENERATED);
+  params.disposition = new_tab ? WindowOpenDisposition::NEW_FOREGROUND_TAB
+                               : WindowOpenDisposition::CURRENT_TAB;
+  Navigate(&params);
+}
+
+void LokaSidebarHandler::HandleOpenPage(const base::ListValue& args) {
+  BrowserWindowInterface* browser = GetBrowser();
+  if (!browser || args.empty() || !args[0].is_string()) {
+    return;
+  }
+  // Only the browser's own pages: the sidebar opens settings, downloads and
+  // extensions this way.
+  GURL url(args[0].GetString());
+  if (!url.SchemeIs(content::kChromeUIScheme)) {
+    return;
+  }
+  NavigateParams params(browser, url, ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+  params.disposition = WindowOpenDisposition::SINGLETON_TAB;
+  // A tab already on that page goes to the address asked for: the Library at
+  // chrome://history opens on the section its #hash names.
+  params.path_behavior = NavigateParams::IGNORE_AND_NAVIGATE;
+  Navigate(&params);
+}
+
+void LokaSidebarHandler::HandleWindowAction(const base::ListValue& args) {
+  BrowserWindowInterface* browser = GetBrowser();
+  if (!browser || args.empty() || !args[0].is_string()) {
+    return;
+  }
+  ui::BaseWindow* window = browser->GetWindow();
+  const std::string& action = args[0].GetString();
+  if (action == "minimize") {
+    window->Minimize();
+  } else if (action == "maximize") {
+    if (window->IsMaximized()) {
+      window->Restore();
+    } else {
+      window->Maximize();
+    }
+  } else if (action == "close") {
+    window->Close();
+  }
+}
+
+void LokaSidebarHandler::HandleStartWindowDrag(const base::ListValue& args) {
+  // The sidebar's empty top row moves the window, like a title bar: hand the
+  // press that's still down to Windows' own move loop.
+#if BUILDFLAG(IS_WIN)
+  BrowserWindowInterface* browser = GetBrowser();
+  if (!browser || browser->GetWindow()->IsFullscreen()) {
+    return;
+  }
+  HWND hwnd = views::HWNDForNativeWindow(browser->GetWindow()->GetNativeWindow());
+  if (!hwnd || !(::GetAsyncKeyState(VK_LBUTTON) & 0x8000)) {
+    return;
+  }
+  ::ReleaseCapture();
+  ::SendMessage(hwnd, WM_NCLBUTTONDOWN, HTCAPTION, 0);
+#else
+  // Elsewhere (macOS, Linux) views' own move loop moves the window with the
+  // press that's down, as tab dragging does. Untested off Windows so far.
+  BrowserWindowInterface* browser = GetBrowser();
+  views::Widget* widget =
+      browser ? views::Widget::GetWidgetForNativeWindow(
+                    browser->GetWindow()->GetNativeWindow())
+              : nullptr;
+  if (!widget || !widget->IsMoveLoopSupported() ||
+      browser->GetWindow()->IsFullscreen()) {
+    return;
+  }
+  const gfx::Point cursor =
+      display::Screen::Get()->GetCursorScreenPoint();
+  widget->RunMoveLoop(cursor - widget->GetWindowBoundsInScreen().origin(),
+                      views::Widget::MoveLoopSource::kMouse,
+                      views::Widget::MoveLoopEscapeBehavior::kDontHide);
+#endif
+}
