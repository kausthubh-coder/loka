+#ifndef CHROME_BROWSER_UI_VIEWS_LOKA_LOKA_MENU_H_
+#define CHROME_BROWSER_UI_VIEWS_LOKA_LOKA_MENU_H_
+
+#include <memory>
+#include <optional>
+
+#include "base/memory/raw_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/values.h"
+#include "ui/gfx/geometry/point.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/widget/widget_observer.h"
+
+class BrowserWindowInterface;
+
+namespace views {
+class WebView;
+}
+
+// The sidebar's right-click and "..." menus, drawn by Loka's own page
+// (chrome://loka-sidebar.top-chrome/menu.html) in a frameless, transparent
+// window of their own, so a menu can reach past the sidebar's edge and isn't
+// cut off. One per browser window, made when its sidebar loads and kept, so a
+// menu opens with no page to start. The flow:
+//   sidebar showMenu(menu, x, y) -> Show: the page hears "menu-show"
+//   page menuReady(w, h)          -> Place: sized, placed, shown, focused
+//   page menuPicked(path) or a click elsewhere -> Hide; the sidebar hears
+//   "menu-picked" or "menu-closed".
+class LokaMenu : public views::WidgetObserver {
+ public:
+  // Makes `browser`'s menu window and loads its page, hidden.
+  static void Preload(BrowserWindowInterface* browser);
+  // Hands `menu` to the page, to open at `anchor` (screen DIPs) once the
+  // page says how big it is.
+  static void Show(BrowserWindowInterface* browser,
+                   base::Value menu,
+                   const gfx::Point& anchor);
+  // The page's size for the menu it was handed: shows it there.
+  static void Place(BrowserWindowInterface* browser, const gfx::Size& size);
+  // Hides the menu. The sidebar hears "menu-closed" unless `picked`.
+  static void Hide(BrowserWindowInterface* browser, bool picked);
+  // The menu waiting for a page that hadn't loaded, taken once.
+  static std::optional<base::Value> TakePendingMenu(
+      BrowserWindowInterface* browser);
+
+  LokaMenu(const LokaMenu&) = delete;
+  LokaMenu& operator=(const LokaMenu&) = delete;
+  ~LokaMenu() override;
+
+  // views::WidgetObserver:
+  void OnWidgetActivationChanged(views::Widget* widget, bool active) override;
+  void OnWidgetDestroying(views::Widget* widget) override;
+
+ private:
+  explicit LokaMenu(BrowserWindowInterface* browser);
+
+  void EnsureWidget();
+
+  raw_ptr<BrowserWindowInterface> browser_;
+  raw_ptr<views::Widget> browser_widget_;
+  std::unique_ptr<views::Widget> widget_;
+  raw_ptr<views::WebView> web_view_ = nullptr;
+  gfx::Point anchor_;
+  std::optional<base::Value> pending_menu_;
+  base::ScopedObservation<views::Widget, views::WidgetObserver>
+      browser_widget_observation_{this};
+  base::ScopedObservation<views::Widget, views::WidgetObserver>
+      widget_observation_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_LOKA_LOKA_MENU_H_
