+tabs::TabInterface* LokaSidebarHandler::FindTab(const base::Value& id) {
+  TabStripModel* tab_strip = GetTabStrip();
+  if (!tab_strip || !id.is_int()) {
+    return nullptr;
+  }
+  tabs::TabInterface* tab = tabs::TabHandle(id.GetInt()).Get();
+  if (!tab || tab_strip->GetIndexOfTab(tab) == TabStripModel::kNoTab) {
+    return nullptr;
+  }
+  return tab;
