+#include "chrome/browser/ui/webui/loka_sidebar/loka_tab_sleeper.h"
+
+#include <cmath>
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+#include "chrome/browser/performance_manager/policies/discard_eligibility_policy.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/resource_coordinator/lifecycle_unit_state.mojom.h"
+#include "chrome/browser/resource_coordinator/tab_lifecycle_unit_external.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface_iterator.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/webui/loka_sidebar/loka_sidebar_ui.h"
+#include "components/performance_manager/public/graph/page_node.h"
+#include "components/performance_manager/public/performance_manager.h"
+#include "components/prefs/pref_service.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+
+namespace {
+
+const char kSleeperKey[] = "loka.tab_sleeper";
+// Settings' choices are 15 minutes and up, so a minute late is close enough,
+// and the browser wakes for this once a minute at most.
+constexpr base::TimeDelta kSweepEvery = base::Minutes(1);
+constexpr int kDefaultMinutes = 30;
+
+}  // namespace
+
+// static
+void LokaTabSleeper::EnsureForProfile(Profile* profile) {
+  if (profile->GetUserData(kSleeperKey)) {
+    return;
+  }
+  profile->SetUserData(kSleeperKey, std::make_unique<LokaTabSleeper>(profile));
+}
+
+// static
+std::optional<base::TimeDelta> LokaTabSleeper::SleepAfter(
+    std::string_view ui_json) {
+  std::optional<base::Value> ui =
+      base::JSONReader::Read(ui_json, base::JSON_PARSE_RFC);
+  const base::Value* minutes =
+      ui && ui->is_dict() ? ui->GetDict().Find("sleepAfterMinutes") : nullptr;
+  // The same reading as the page's parseUiPrefs: a missing or negative
+  // value is the default, 0 is never.
+  std::optional<double> value = minutes ? minutes->GetIfDouble() : std::nullopt;
+  if (!value || !std::isfinite(*value) || *value < 0) {
+    return base::Minutes(kDefaultMinutes);
+  }
+  if (*value == 0) {
+    return std::nullopt;
+  }
+  return base::Minutes(*value);
+}
+
+LokaTabSleeper::LokaTabSleeper(Profile* profile) : profile_(profile) {
+  timer_.Start(FROM_HERE, kSweepEvery,
+               base::BindRepeating(&LokaTabSleeper::Sweep,
+                                   base::Unretained(this)));
+  store_.Init(profile_->GetPrefs());
+  store_.Add(kLokaSidebarStorePref,
+             base::BindRepeating(&LokaTabSleeper::OnStoreChanged,
+                                 base::Unretained(this)));
+  OnStoreChanged();
+  profile_->AddObserver(this);
+}
+
+LokaTabSleeper::~LokaTabSleeper() {
+  if (profile_) {
+    profile_->RemoveObserver(this);
+  }
+}
+
+void LokaTabSleeper::OnProfileWillBeDestroyed(Profile* profile) {
+  timer_.Stop();
+  store_.RemoveAll();
+  profile_->RemoveObserver(this);
+  profile_ = nullptr;
+}
+
+void LokaTabSleeper::OnStoreChanged() {
+  // The store also holds the spaces, which change on every title; only the
+  // settings matter here.
+  const std::string* ui =
+      profile_->GetPrefs()->GetDict(kLokaSidebarStorePref).FindString("ui.v1");
+  if (ui && *ui == ui_json_) {
+    return;
+  }
+  ui_json_ = ui ? *ui : std::string();
+  Sweep();
+}
+
+void LokaTabSleeper::Sweep() {
+  std::optional<base::TimeDelta> after = SleepAfter(ui_json_);
+  if (!after || !profile_) {
+    return;
+  }
+  using performance_manager::policies::CanDiscardResult;
+  using performance_manager::policies::DiscardEligibilityPolicy;
+  auto* policy = DiscardEligibilityPolicy::GetFromGraph(
+      performance_manager::PerformanceManager::GetGraph());
+  if (!policy) {
+    return;
+  }
+  for (BrowserWindowInterface* window : GetAllBrowserWindowInterfaces()) {
+    if (window->GetProfile() != profile_ ||
+        window->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+      continue;
+    }
+    TabStripModel* tab_strip = window->GetTabStripModel();
+    for (int i = 0; i < tab_strip->count(); ++i) {
+      if (i == tab_strip->active_index()) {
+        continue;
+      }
+      std::optional<tab_groups::TabGroupId> group =
+          tab_strip->GetTabGroupForTab(i);
+      // Only other spaces' tabs: the space on screen keeps its group open,
+      // and Essentials are in no group. Memory Saver still covers those.
+      if (!group || !tab_strip->IsGroupCollapsed(*group)) {
+        continue;
+      }
+      content::WebContents* contents = tab_strip->GetWebContentsAt(i);
+      base::WeakPtr<performance_manager::PageNode> page =
+          performance_manager::PerformanceManager::
+              GetPrimaryPageNodeForWebContents(contents);
+      // The window is how long the tab has been out of sight; the policy
+      // also refuses tabs with sound, capture, picture-in-picture, form
+      // input, or that are already unloaded.
+      if (!page || policy->CanDiscardWithCustomRecentVisibilityWindow(
+                       page.get(),
+                       ::mojom::LifecycleUnitDiscardReason::PROACTIVE,
+                       *after) != CanDiscardResult::kEligible) {
+        continue;
+      }
+      auto* lifecycle =
+          resource_coordinator::TabLifecycleUnitExternal::FromWebContents(
+              contents);
+      if (lifecycle) {
+        lifecycle->DiscardTab(::mojom::LifecycleUnitDiscardReason::PROACTIVE);
+      }
+    }
+  }
+}
