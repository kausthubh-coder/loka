+// Copyright 2026 The Loka Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_LOKA_LOKA_COMMAND_BAR_H_
+#define CHROME_BROWSER_UI_VIEWS_LOKA_LOKA_COMMAND_BAR_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "base/scoped_observation.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/widget/widget_observer.h"
+
+class BrowserWindowInterface;
+
+namespace views {
+class WebView;
+}
+
+// Loka's command bar (Ctrl+T, Ctrl+L, the sidebar's address field), floating
+// over the middle of the window like Arc's and Zen's. It is the sidebar's page
+// at chrome://loka-sidebar.top-chrome/command.html in a frameless,
+// transparent window above the browser window; the same handler as the
+// sidebar answers it.
+class LokaCommandBar : public views::WidgetObserver {
+ public:
+  // Shows the bar over `browser`'s window and hands it `command`
+  // ("new-tab" or "focus-location").
+  static void Show(BrowserWindowInterface* browser, const std::string& command);
+  // Hides the bar of `browser`'s window, if it's showing.
+  static void Hide(BrowserWindowInterface* browser);
+  // The command waiting for the bar's page of `browser`, taken once: the page
+  // asks for it when it has loaded.
+  static std::optional<std::string> TakePendingCommand(
+      BrowserWindowInterface* browser);
+
+  LokaCommandBar(const LokaCommandBar&) = delete;
+  LokaCommandBar& operator=(const LokaCommandBar&) = delete;
+  ~LokaCommandBar() override;
+
+  // views::WidgetObserver:
+  void OnWidgetActivationChanged(views::Widget* widget, bool active) override;
+  void OnWidgetBoundsChanged(views::Widget* widget,
+                             const gfx::Rect& new_bounds) override;
+  void OnWidgetDestroying(views::Widget* widget) override;
+
+ private:
+  explicit LokaCommandBar(BrowserWindowInterface* browser);
+
+  void EnsureWidget();
+  void Place();
+  void ShowWith(const std::string& command);
+  void HideNow();
+
+  raw_ptr<BrowserWindowInterface> browser_;
+  raw_ptr<views::Widget> browser_widget_;
+  std::unique_ptr<views::Widget> widget_;
+  raw_ptr<views::WebView> web_view_ = nullptr;
+  std::optional<std::string> pending_command_;
+  base::ScopedObservation<views::Widget, views::WidgetObserver>
+      browser_widget_observation_{this};
