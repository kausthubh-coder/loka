+// ---- Media ------------------------------------------------------------------
+
+base::ListValue LokaSidebarHandler::MediaList() {
+  base::ListValue list;
+  TabStripModel* tab_strip = GetTabStrip();
+  if (!tab_strip) {
+    return list;
+  }
+  using media_session::mojom::MediaSessionAction;
+  std::map<int32_t, std::unique_ptr<LokaMediaWatcher>> watchers;
+  for (int i = 0; i < tab_strip->count(); ++i) {
+    tabs::TabInterface* tab = tab_strip->GetTabAtIndex(i);
+    content::WebContents* contents = tab->GetContents();
+    const int32_t id = tab->GetHandle().raw_value();
+    const bool audible = contents->IsCurrentlyAudible();
+    // Watch a tab once it has media (a session) or makes sound.
+    auto known = media_watchers_.find(id);
+    if (known != media_watchers_.end()) {
+      watchers[id] = std::move(known->second);
+    } else if (audible || content::MediaSession::GetIfExists(contents)) {
+      watchers[id] = std::make_unique<LokaMediaWatcher>(
+          contents,
+          base::BindRepeating(&LokaSidebarHandler::ScheduleMediaChanged,
+                              weak_factory_.GetWeakPtr()));
+    }
+    auto watched = watchers.find(id);
+    const LokaMediaWatcher* media =
+        watched != watchers.end() ? watched->second.get() : nullptr;
+    // Sound with no media session (a game, Web Audio) still shows, as
+    // playing, while it sounds.
+    const bool active = (media && media->IsActive()) || audible;
+    const bool playing = media && media->IsActive() ? media->IsPlaying()
+                                                    : audible;
+    if (playing) {
+      media_dismissed_.erase(id);
+    }
+    if (!active || media_dismissed_.contains(id)) {
+      continue;
+    }
+    TabUIHelper* helper = TabUIHelper::From(tab);
+    const std::u16string title = media && !media->title().empty()
+                                     ? media->title()
+                                     : (helper ? helper->GetTitle()
+                                               : std::u16string());
+    base::DictValue data;
+    data.Set("tabId", id);
+    data.Set("title", base::UTF16ToUTF8(title));
+    data.Set("artist", media && !media->artist().empty()
+                           ? base::UTF16ToUTF8(media->artist())
+                           : contents->GetLastCommittedURL().host());
+    data.Set("artwork", media && !media->artwork().empty()
+                            ? media->artwork()
+                            : FaviconUrl(tab));
+    data.Set("playing", playing);
+    data.Set("canPrevious",
+             media && media->Can(MediaSessionAction::kPreviousTrack));
+    data.Set("canNext", media && media->Can(MediaSessionAction::kNextTrack));
+    list.Append(std::move(data));
+  }
+  // Tabs that closed take their watchers with them.
+  media_watchers_ = std::move(watchers);
+  std::erase_if(media_dismissed_, [this](int32_t id) {
+    return !media_watchers_.contains(id);
+  });
+  return list;
+}
+
+void LokaSidebarHandler::ScheduleMediaChanged() {
+  if (media_change_pending_ || !IsJavascriptAllowed()) {
+    return;
+  }
+  media_change_pending_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&LokaSidebarHandler::SendMediaChanged,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void LokaSidebarHandler::SendMediaChanged() {
+  media_change_pending_ = false;
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  base::ListValue list = MediaList();
+  if (list == sent_media_) {
+    return;
+  }
+  sent_media_ = list.Clone();
+  FireWebUIListener("media-changed", list);
+}
+
+void LokaSidebarHandler::HandleGetMedia(const base::ListValue& args) {
+  AllowJavascript();
+  ResolveJavascriptCallback(args[0], MediaList());
+}
+
+void LokaSidebarHandler::HandleMediaAction(const base::ListValue& args) {
+  tabs::TabInterface* tab = args.size() < 2 ? nullptr : FindTab(args[0]);
+  if (!tab || !args[1].is_string()) {
+    return;
+  }
+  content::MediaSession* session =
+      content::MediaSession::Get(tab->GetContents());
+  const std::string& action = args[1].GetString();
+  // The page's media session reports the new state back (LokaMediaWatcher),
+  // which updates the card.
+  if (action == "pause") {
+    session->Suspend(content::MediaSession::SuspendType::kUI);
+  } else if (action == "play") {
+    session->Resume(content::MediaSession::SuspendType::kUI);
+  } else if (action == "next") {
+    session->NextTrack();
+  } else if (action == "previous") {
+    session->PreviousTrack();
+  } else if (action == "dismiss") {
+    media_dismissed_.insert(tab->GetHandle().raw_value());
+    ScheduleMediaChanged();
+  }
+}
