+// static
+bool LokaSidebarHandler::IsTabIconRequest(const std::string& path) {
+  return base::StartsWith(path, kTabIconPath);
+}
+
+// static
+void LokaSidebarHandler::ServeTabIcon(
+    const std::string& path,
+    content::WebUIDataSource::GotDataCallback callback) {
+  // The version in the address only keeps image caches honest; the tab's
+  // icon now is what's served.
+  const std::string_view name =
+      std::string_view(path).substr(std::size(kTabIconPath) - 1);
+  const size_t dash = name.find('-');
+  const size_t at = name.find('@');
+  const size_t dot = name.rfind(".png");
+  int id = 0;
+  int percent = 0;
+  tabs::TabInterface* tab = nullptr;
+  if (dash != std::string_view::npos && at != std::string_view::npos &&
+      dot != std::string_view::npos && dash < at && at < dot &&
+      base::StringToInt(name.substr(0, dash), &id) &&
+      base::StringToInt(name.substr(at + 1, dot - at - 1), &percent) &&
+      percent > 0) {
+    tab = tabs::TabHandle(id).Get();
+  }
+  gfx::ImageSkia image;
+  if (tab && tab->GetContents()) {
+    image = TabIcon(tab, tab->GetContents()->GetColorProvider());
+  }
+  if (image.isNull()) {
+    std::move(callback).Run(nullptr);
+    return;
+  }
+  std::optional<std::vector<uint8_t>> png =
+      gfx::PNGCodec::EncodeBGRASkBitmap(
+          image.GetRepresentation(percent / 100.0f).GetBitmap(),
+          /*discard_transparency=*/false);
+  if (!png) {
+    std::move(callback).Run(nullptr);
+    return;
+  }
+  std::move(callback).Run(
+      base::MakeRefCounted<base::RefCountedBytes>(std::move(*png)));
+}
