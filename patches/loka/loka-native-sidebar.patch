+
+void LokaSidebarHandler::HandleRunExtension(const base::ListValue& args) {
+  BrowserWindowInterface* browser = GetBrowser();
+  TabStripModel* tab_strip = GetTabStrip();
+  if (!browser || !tab_strip || args.empty() || !args[0].is_string()) {
+    return;
+  }
+  Profile* profile = Profile::FromWebUI(web_ui());
+  const extensions::Extension* extension =
+      extensions::ExtensionRegistry::Get(profile)
+          ->enabled_extensions()
+          .GetByID(args[0].GetString());
+  content::WebContents* active = tab_strip->GetActiveWebContents();
+  if (!extension || !active) {
+    return;
+  }
+  // The click that just closed this extension's popup (it closes when the
+  // sidebar is clicked) is a toggle, not a request to open it again.
+  if (auto closed = popup_closed_.find(extension->id());
+      closed != popup_closed_.end() &&
+      base::TimeTicks::Now() - closed->second < base::Milliseconds(400)) {
+    popup_closed_.erase(closed);
+    return;
+  }
+  // Clicking the button of an open popup closes it.
+  for (extensions::ExtensionHost* open : popup_observations_.sources()) {
+    if (open->extension_id() == extension->id()) {
+      open->Close();
+      return;
+    }
+  }
+  auto* runner = extensions::ExtensionActionRunner::GetForWebContents(active);
+  if (!runner || runner->RunAction(extension, /*grant_tab_permissions=*/true) !=
+                     extensions::ExtensionAction::ShowAction::kShowPopup) {
+    return;
+  }
+  extensions::ExtensionAction* action =
+      extensions::ExtensionActionManager::Get(profile)->GetExtensionAction(
+          *extension);
+  if (!action) {
+    return;
+  }
+  GURL popup_url =
+      action->GetPopupUrl(extensions::ExtensionTabUtil::GetTabId(active));
+  std::unique_ptr<extensions::ExtensionViewHost> host =
+      extensions::ExtensionViewHostFactory::CreatePopupHost(*extension,
+                                                            popup_url, browser);
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  VerticalTabStripRegionView* region =
+      browser_view ? browser_view->vertical_tab_strip_region_view_for_testing()
+                   : nullptr;
+  // The button the user clicked, in the sidebar page's CSS pixels (which are
+  // the column's DIPs: the page isn't zoomed).
+  gfx::Rect button;
+  if (args.size() > 1 && args[1].is_dict()) {
+    const base::DictValue& r = args[1].GetDict();
+    button = gfx::Rect(r.FindDouble("x").value_or(0), r.FindDouble("y").value_or(0),
+                       r.FindDouble("width").value_or(1),
+                       r.FindDouble("height").value_or(1));
+  }
+  views::View* anchor = region ? region->GetLokaAnchor(button) : nullptr;
+  if (!host || !anchor) {
+    return;
+  }
+  // The popup opens beside the sidebar, level with the button.
+  ExtensionPopup::ShowPopup(browser, std::move(host), views::BubbleAnchor(anchor),
+                            views::BubbleBorder::LEFT_TOP,
+                            PopupShowAction::kShow,
+                            base::BindOnce(
+                                [](base::WeakPtr<LokaSidebarHandler> self,
+                                   extensions::ExtensionHost* host) {
+                                  if (self && host &&
+                                      !self->popup_observations_
+                                           .IsObservingSource(host)) {
+                                    self->popup_observations_.AddObservation(
+                                        host);
+                                  }
+                                },
+                                weak_factory_.GetWeakPtr()));
+}
+
+// An extension's right-click menu: "options" opens its options page, "manage"
+// its page in chrome://extensions, and "remove" asks with Chrome's own dialog.
+void LokaSidebarHandler::HandleExtensionAction(const base::ListValue& args) {
+  BrowserWindowInterface* browser = GetBrowser();
+  if (!browser || args.size() < 2 || !args[0].is_string() ||
+      !args[1].is_string()) {
+    return;
+  }
+  Profile* profile = Profile::FromWebUI(web_ui());
+  const extensions::Extension* extension =
+      extensions::ExtensionRegistry::Get(profile)
+          ->enabled_extensions()
+          .GetByID(args[0].GetString());
+  if (!extension) {
+    return;
+  }
+  const std::string& action = args[1].GetString();
+  if (action == "options") {
+    extensions::ExtensionTabUtil::OpenOptionsPage(extension, browser);
+  } else if (action == "manage") {
+    NavigateParams params(
+        browser, GURL("chrome://extensions/?id=" + extension->id()),
+        ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+    params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+    Navigate(&params);
+  } else if (action == "remove" && !uninstall_dialog_) {
+    uninstall_dialog_ = extensions::ExtensionUninstallDialog::Create(
+        profile, browser->GetWindow()->GetNativeWindow(), this);
+    uninstall_dialog_->ConfirmUninstall(
+        extension, extensions::UNINSTALL_REASON_USER_INITIATED,
+        extensions::UNINSTALL_SOURCE_TOOLBAR_CONTEXT_MENU);
+  }
+}
+
+void LokaSidebarHandler::OnExtensionUninstallDialogClosed(
+    bool did_start_uninstall,
+    const std::u16string& error) {
+  // This runs from inside the dialog, so it is deleted after it returns.
+  base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+      FROM_HERE, std::move(uninstall_dialog_));
+}
