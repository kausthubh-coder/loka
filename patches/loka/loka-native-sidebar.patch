+// Whether websites may play before you click: "block", "block-audible" or
+// "allow". See DetermineWebContentsAutoplayPolicy.
+void LokaSidebarHandler::HandleSetAutoplay(const base::ListValue& args) {
+  if (args.empty() || !args[0].is_string()) {
+    return;
+  }
+  const std::string& mode = args[0].GetString();
+  if (mode != "block" && mode != "block-audible" && mode != "allow") {
+    return;
+  }
+  Profile::FromWebUI(web_ui())->GetPrefs()->SetString("loka.autoplay", mode);
+}
+
+void LokaSidebarHandler::HandleGetAutoplay(const base::ListValue& args) {
+  AllowJavascript();
+  ResolveJavascriptCallback(
+      args[0], base::Value(Profile::FromWebUI(web_ui())->GetPrefs()->GetString(
+                   "loka.autoplay")));
+}
+
+void LokaSidebarHandler::HandleSetColorScheme(const base::ListValue& args) {
+  if (args.empty() || !args[0].is_string()) {
+    return;
+  }
+  const std::string& scheme = args[0].GetString();
+  ThemeService::BrowserColorScheme color_scheme =
+      scheme == "light"  ? ThemeService::BrowserColorScheme::kLight
+      : scheme == "dark" ? ThemeService::BrowserColorScheme::kDark
+                         : ThemeService::BrowserColorScheme::kSystem;
+  ThemeService* theme =
+      ThemeServiceFactory::GetForProfile(Profile::FromWebUI(web_ui()));
+  if (theme && theme->GetBrowserColorScheme() != color_scheme) {
+    theme->SetBrowserColorScheme(color_scheme);
+  }
+}
+
+void LokaSidebarHandler::HandleSetThemeColor(const base::ListValue& args) {
+  // The window's frame (around the page) takes the space's color, so the
+  // sidebar's sky reads as the whole window, like Arc's. "#rrggbb", or null
+  // to go back to the theme's frame. AddChromeColorMixers paints the frame
+  // with it.
+  ThemeService* theme =
+      ThemeServiceFactory::GetForProfile(Profile::FromWebUI(web_ui()));
+  if (!theme || args.empty()) {
+    return;
+  }
+  std::optional<SkColor> color;
+  if (args[0].is_string()) {
+    const std::string& hex = args[0].GetString();
+    uint32_t rgb = 0;
+    if (hex.size() != 7 || hex[0] != '#' ||
+        !base::HexStringToUInt(std::string_view(hex).substr(1), &rgb)) {
+      return;
+    }
+    color = SkColorSetRGB((rgb >> 16) & 0xFF, (rgb >> 8) & 0xFF, rgb & 0xFF);
+  }
+  if (theme->GetUserColor() != color) {
+    theme->SetUserColor(color);
+  }
+}
+
+void LokaSidebarHandler::OnExtensionHostDestroyed(
+    extensions::ExtensionHost* host) {
+  popup_closed_[host->extension_id()] = base::TimeTicks::Now();
+  popup_observations_.RemoveObservation(host);
+}
