+void LokaSidebarHandler::HandleCommandPicked(const base::ListValue& args) {
+  // The floating bar picked something only the sidebar can do (a space, an
+  // unloaded Loka tab, a Loka command): hand it to this window's sidebar.
+  BrowserWindowInterface* browser = GetBrowser();
+  if (!browser || args.empty()) {
+    return;
+  }
+  auto it = Sidebars().find(browser);
+  if (it != Sidebars().end() && it->second->IsJavascriptAllowed()) {
