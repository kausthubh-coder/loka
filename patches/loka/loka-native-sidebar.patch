+
+void LokaSidebarHandler::StartObservingFeatures() {
+  Profile* profile = Profile::FromWebUI(web_ui());
+  if (BrowserWindowInterface* browser = GetBrowser()) {
+    if (web_ui()->GetWebContents()->GetVisibleURL().host() != kLokaSidebarHost) {
+      // Loka's Settings page: it uses the store, not the window's shortcuts.
+    } else if (IsMenuPage()) {
+      MenuPages()[browser] = this;
+      // A menu was asked for before its page had loaded.
+      if (std::optional<base::Value> menu = LokaMenu::TakePendingMenu(browser)) {
+        FireWebUIListener("menu-show", *menu);
+      }
+    } else if (IsCommandBarPage()) {
+      CommandBars()[browser] = this;
+      // The bar was asked for before its page had loaded.
+      if (std::optional<std::string> command =
+              LokaCommandBar::TakePendingCommand(browser)) {
+        FireWebUIListener("command", base::Value(*command));
+      }
+    } else {
+      Sidebars()[browser] = this;
+      // Its menus open in a window kept loaded, so the first one is quick.
+      LokaMenu::Preload(browser);
+    }
+  }
+  if (auto* model = ToolbarActionsModel::Get(profile);
+      model && !toolbar_observation_.IsObserving()) {
+    toolbar_observation_.Observe(model);
+  }
+  if (auto* dispatcher = extensions::ExtensionActionDispatcher::Get(profile);
+      dispatcher && !action_observation_.IsObserving()) {
+    action_observation_.Observe(dispatcher);
+  }
+  if (!download_notifier_ && profile->GetDownloadManager()) {
+    download_notifier_ = std::make_unique<download::AllDownloadItemNotifier>(
+        profile->GetDownloadManager(), this);
+  }
+}
+
+void LokaSidebarHandler::StopObservingFeatures() {
+  for (auto* map : {&Sidebars(), &CommandBars(), &MenuPages()}) {
+    for (auto it = map->begin(); it != map->end();) {
+      it = it->second == this ? map->erase(it) : std::next(it);
+    }
+  }
+  toolbar_observation_.Reset();
+  action_observation_.Reset();
+  download_notifier_.reset();
+  autocomplete_.reset();
+  extensions_change_pending_ = false;
+  downloads_change_pending_ = false;
+}
