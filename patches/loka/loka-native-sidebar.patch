+
+  LokaSidebarHandler();
+  LokaSidebarHandler(const LokaSidebarHandler&) = delete;
+  LokaSidebarHandler& operator=(const LokaSidebarHandler&) = delete;
+  ~LokaSidebarHandler() override;
