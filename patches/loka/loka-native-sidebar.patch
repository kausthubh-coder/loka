+// Copyright 2026 The Loka Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/loka/loka_menu.h"
+
+#include <algorithm>
+#include <map>
+#include <string>
+#include <utility>
+
+#include "base/no_destructor.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/webui/loka_sidebar/loka_sidebar_handler.h"
+#include "chrome/browser/ui/webui/loka_sidebar/loka_sidebar_ui.h"
+#include "chrome/browser/ui/webui/webui_embedding_context.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/display/display.h"
+#include "ui/display/screen.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/views/controls/webview/web_contents_set_background_color.h"
+#include "ui/views/controls/webview/webview.h"
+#include "url/gurl.h"
+
+namespace {
+
+constexpr int kShadow = 10;
+
+std::map<BrowserWindowInterface*, std::unique_ptr<LokaMenu>>& Menus() {
+  static base::NoDestructor<
+      std::map<BrowserWindowInterface*, std::unique_ptr<LokaMenu>>>
+      menus;
+  return *menus;
+}
+
+LokaMenu* Find(BrowserWindowInterface* browser) {
+  auto it = Menus().find(browser);
+  return it == Menus().end() ? nullptr : it->second.get();
+}
+
+}  // namespace
+
+// static
+void LokaMenu::Preload(BrowserWindowInterface* browser) {
+  auto& menu = Menus()[browser];
+  if (!menu) {
+    menu.reset(new LokaMenu(browser));
+  }
+  menu->EnsureWidget();
+}
+
+// static
+void LokaMenu::Show(BrowserWindowInterface* browser,
+                    base::Value menu,
+                    const gfx::Point& anchor) {
+  Preload(browser);
+  LokaMenu* self = Find(browser);
+  if (!self || !self->widget_) {
+    return;
+  }
+  self->anchor_ = anchor;
+  // The page may still be loading the first time: it takes the menu when it's
+  // ready. Otherwise it hears it now.
+  if (!LokaSidebarHandler::DeliverMenu(browser, menu)) {
+    self->pending_menu_ = std::move(menu);
+  }
+}
+
+// static
+void LokaMenu::Place(BrowserWindowInterface* browser, const gfx::Size& size) {
+  LokaMenu* self = Find(browser);
+  if (!self || !self->widget_ || size.IsEmpty()) {
+    return;
+  }
+  // At the pointer, flipped up or left where the screen ends, and kept on it.
+  const gfx::Rect screen = display::Screen::Get()
+                               ->GetDisplayNearestPoint(self->anchor_)
+                               .work_area();
+  // The page leaves room for the menu's shadow on every side (SHADOW in
+  // menu.ts): the window starts that much up and left of the pointer.
+  int x = self->anchor_.x() - kShadow;
+  int y = self->anchor_.y() - kShadow;
+  if (x + size.width() > screen.right()) {
+    x = std::max(screen.x(), x - size.width());
+  }
+  if (y + size.height() > screen.bottom()) {
+    y = std::max(screen.y(), screen.bottom() - size.height());
+  }
+  self->widget_->SetBounds(gfx::Rect(gfx::Point(x, y), size));
+  if (!self->widget_->IsVisible()) {
+    self->widget_->Show();
+  }
+  self->widget_->Activate();
+  self->web_view_->RequestFocus();
+  self->web_view_->GetWebContents()->Focus();
+}
+
+// static
+void LokaMenu::Hide(BrowserWindowInterface* browser, bool picked) {
+  LokaMenu* self = Find(browser);
+  if (!self || !self->widget_ || !self->widget_->IsVisible()) {
+    return;
+  }
+  self->widget_->Hide();
+  if (self->browser_widget_) {
+    self->browser_widget_->Activate();
+  }
+  if (!picked) {
+    LokaSidebarHandler::MenuClosed(browser);
+  }
+}
+
+// static
+std::optional<base::Value> LokaMenu::TakePendingMenu(
+    BrowserWindowInterface* browser) {
+  LokaMenu* self = Find(browser);
+  if (!self) {
+    return std::nullopt;
+  }
+  return std::exchange(self->pending_menu_, std::nullopt);
+}
+
+LokaMenu::LokaMenu(BrowserWindowInterface* browser) : browser_(browser) {
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  browser_widget_ = browser_view ? browser_view->GetWidget() : nullptr;
+  if (browser_widget_) {
+    browser_widget_observation_.Observe(browser_widget_.get());
+  }
+}
+
+LokaMenu::~LokaMenu() = default;
+
+void LokaMenu::EnsureWidget() {
+  if (widget_ || !browser_widget_) {
+    return;
+  }
+  widget_ = std::make_unique<views::Widget>();
+  views::Widget::InitParams params(
+      views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+      views::Widget::InitParams::TYPE_WINDOW_FRAMELESS);
+  params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+  params.parent = browser_widget_->GetNativeView();
+  params.context = browser_widget_->GetNativeWindow();
+  params.shadow_type = views::Widget::InitParams::ShadowType::kNone;
+  params.name = "LokaMenu";
+  widget_->Init(std::move(params));
+
+  auto web_view = std::make_unique<views::WebView>(browser_->GetProfile());
+  webui::SetBrowserWindowInterface(web_view->GetWebContents(), browser_);
+  views::WebContentsSetBackgroundColor::CreateForWebContentsWithColor(
+      web_view->GetWebContents(), SK_ColorTRANSPARENT);
+  web_view->LoadInitialURL(GURL(std::string(kLokaSidebarURL) + "menu.html"));
+  web_view_ = widget_->SetContentsView(std::move(web_view));
+  widget_->SetVisibilityChangedAnimationsEnabled(false);
+  widget_observation_.Observe(widget_.get());
+}
+
+void LokaMenu::OnWidgetActivationChanged(views::Widget* widget, bool active) {
+  // A click anywhere else closes it, as a menu does.
+  if (widget == widget_.get() && !active) {
+    Hide(browser_, /*picked=*/false);
+  }
+}
+
+void LokaMenu::OnWidgetDestroying(views::Widget* widget) {
+  if (widget == browser_widget_) {
+    widget_observation_.Reset();
+    browser_widget_observation_.Reset();
+    widget_.reset();
+    browser_widget_ = nullptr;
+    // Deletes this.
+    Menus().erase(browser_);
+  } else if (widget == widget_.get()) {
+    widget_observation_.Reset();
+  }
+}
