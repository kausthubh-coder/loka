+std::string LokaSidebarHandler::FaviconDataUrl(tabs::TabInterface* tab) {
+  TabUIHelper* helper = TabUIHelper::From(tab);
+  if (!helper || !helper->ShouldDisplayFavicon()) {
+    return std::string();
+  }
+  const ui::ImageModel favicon = helper->GetFavicon();
+  if (favicon.IsEmpty()) {
+    return std::string();
+  }
+  const ui::ColorProvider& provider =
+      web_ui()->GetWebContents()->GetColorProvider();
+  gfx::ImageSkia image = favicon.Rasterize(&provider);
+  // The browser's stand-in globe isn't the site's icon; the page shows its
+  // own fallback for that.
+  if (image.BackedBySameObjectAs(
+          favicon::GetDefaultFaviconModel().Rasterize(&provider))) {
+    return std::string();
+  }
+  auto& cached = favicons_[TabId(tab)];
+  if (!cached.second.empty() && cached.first.BackedBySameObjectAs(image)) {
+    return cached.second;
+  }
+  cached = {image, webui::EncodePNGAndMakeDataURI(
+                       image, web_ui()->GetDeviceScaleFactor())};
+  return cached.second;
+}
+
+base::DictValue LokaSidebarHandler::TabData(tabs::TabInterface* tab,
+                                             int index) {
+  TabStripModel* tab_strip = GetTabStrip();
+  content::WebContents* contents = tab->GetContents();
+  TabUIHelper* helper = TabUIHelper::From(tab);
+  GURL url = helper ? helper->GetLastCommittedURL() : GURL();
+  if ((!url.is_valid() || url.is_empty()) && helper) {
+    url = helper->GetVisibleURL();
+  }
+  base::DictValue data;
+  data.Set("id", TabId(tab));
+  data.Set("index", index);
+  data.Set("url", url.spec());
+  data.Set("title",
+           helper ? base::UTF16ToUTF8(helper->GetTitle()) : std::string());
+  data.Set("favicon", FaviconDataUrl(tab));
+  data.Set("active", tab_strip->active_index() == index);
+  data.Set("pinned", tab->IsPinned());
+  data.Set("loading", contents->IsLoading());
+  data.Set("audible", contents->IsCurrentlyAudible());
+  data.Set("muted", contents->IsAudioMuted());
+  const std::optional<tab_groups::TabGroupId> group = tab->GetGroup();
+  data.Set("groupId", group ? GroupNumber(*group) : -1);
+  if (tabs::TabInterface* opener = tab_strip->GetOpenerOfTabAt(index)) {
+    data.Set("openerId", TabId(opener));
+  }
+  data.Set("lastAccessed",
+           contents->GetLastActiveTime().InMillisecondsFSinceUnixEpoch());
+  return data;
+}
+
+base::ListValue LokaSidebarHandler::TabList() {
+  base::ListValue tabs;
+  TabStripModel* tab_strip = GetTabStrip();
+  if (!tab_strip) {
+    return tabs;
+  }
+  std::map<int32_t, std::pair<gfx::ImageSkia, std::string>> alive;
+  for (int i = 0; i < tab_strip->count(); ++i) {
+    tabs::TabInterface* tab = tab_strip->GetTabAtIndex(i);
+    tabs.Append(TabData(tab, i));
+    if (auto it = favicons_.find(TabId(tab)); it != favicons_.end()) {
+      alive.insert(*it);
+    }
+  }
+  favicons_ = std::move(alive);
+  return tabs;
+}
+
+base::ListValue LokaSidebarHandler::GroupList() {
+  base::ListValue groups;
+  TabStripModel* tab_strip = GetTabStrip();
+  if (!tab_strip || !tab_strip->group_model()) {
+    return groups;
+  }
+  for (const tab_groups::TabGroupId& id :
+       tab_strip->group_model()->ListTabGroups()) {
+    const TabGroup* group = tab_strip->group_model()->GetTabGroup(id);
+    base::DictValue data;
+    data.Set("id", GroupNumber(id));
+    data.Set("title", base::UTF16ToUTF8(group->visual_data()->title()));
+    data.Set("collapsed", group->visual_data()->is_collapsed());
+    groups.Append(std::move(data));
+  }
+  return groups;
+}
