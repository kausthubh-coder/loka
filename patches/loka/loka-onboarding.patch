+                (acc[profile.name] ??= []).push(profile);
+                return acc;
+            },
+            {} as Record<string, BrowserProfile[]>
+        );
+
+        const featured = FEATURED.flatMap(name => {
+            const profiles = groups[name];
+            return profiles ? [[name, profiles] as const] : [];
+        });
+        const others = Object.entries(groups)
+            .filter(([name]) => !(FEATURED as readonly string[]).includes(name))
+            .sort(([a], [b]) => a.localeCompare(b));
