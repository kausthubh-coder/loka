+<script lang="ts">
+    // Loka's setup window: the sky, the top bar and Loka's pages. main.ts mounts this instead of Helium's App.svelte.
+    import { SvelteSet } from "svelte/reactivity";
+    import * as pages from "./pages";
+    import * as Browser from "./lib/browser";
+    import * as WindowFrame from "./lib/browser/window-frame";
+    import { startWindowDrag, windowFrame } from "./lib/browser/window-frame";
+    import {
+        currentPage,
+        direction,
+        flow,
+        pageIndex,
+    } from "./lib/onboarding-flow";
+    import { skyHue, starterSpaces } from "./lib/spaces";
+
+    import PageNavigation from "./components/PageNavigation.svelte";
+    import Sky from "./components/Sky.svelte";
+    import LokaMark from "./components/LokaMark.svelte";
+    import SoundToggle from "./components/SoundToggle.svelte";
+    import StepDots from "./components/StepDots.svelte";
+    import WindowControls from "./components/WindowControls.svelte";
+
+    const OUT_ANIMATION_DURATION = 200;
+
+    type Page = typeof flow[number];
+
+    Browser.setup();
+    // Loka's own browser call, after Helium's: who draws the window's controls.
+    WindowFrame.setup();
+
+    const mountedPages = new SvelteSet<Page>([$currentPage]);
+    let previousPage = $currentPage;
+
+    // The Spaces step colors the sky with the space being made. After it, the rest of setup takes the color of
+    // the first space, the way the browser takes the color of the space you're in.
+    const hue = $derived(
+        $currentPage === "Spaces"
+            ? $skyHue
+            : ($currentPage === "Welcome" ? 200 : $starterSpaces[0]?.hue ?? 200)
+    );
+
+    const horizon = $derived(
+        $currentPage === "Welcome" || $currentPage === "Finish" ? "high" : "low"
+    );
+    let risen = $state(false);
+
+    $effect(() => {
+        document.documentElement.style.setProperty("--hue", String(hue));
+    });
+
+    $effect(() => {
+        document.documentElement.classList.toggle("going-back", $direction === -1);
+    });
+
+    $effect(() => {
+        const page = $currentPage;
+
+        if (page === previousPage) {
+            return;
+        }
+
+        const leavingPage = previousPage;
+        mountedPages.add(page);
+        previousPage = page;
+
+        window.setTimeout(() => {
+            if ($currentPage !== leavingPage) {
+                mountedPages.delete(leavingPage);
+            }
+        }, OUT_ANIMATION_DURATION);
+    });
+
+    // Without a title bar the top bar is one: pressing its empty space moves the window, as in the browser's sidebar.
+    const onTopBarPress = (event: MouseEvent) => {
+        const target = event.target as Element;
+        if (event.button !== 0 || event.detail !== 1 || target.closest("button, a, input")) return;
+        startWindowDrag();
+    };
+
+    // The planet rises on the first frame after the page draws, so the welcome opens on it coming up.
+    $effect(() => {
+        const frame = requestAnimationFrame(() => {
+            risen = true;
+        });
+        return () => cancelAnimationFrame(frame);
+    });
+</script>
+
+<Sky travel={$pageIndex} horizon={risen ? horizon : "below"} />
+
+<main>
+    <!-- A mouse-only stand-in for the title bar: the keyboard moves the window with the system's keys (Win+arrows). -->
+    <!-- svelte-ignore a11y_no_static_element_interactions -->
+    <header
+        class="top-bar"
+        class:title-bar={$windowFrame === "page"}
+        onmousedown={$windowFrame === "page" ? onTopBarPress : undefined}
+    >
+        <div class="corner">
+            {#if $currentPage !== "Welcome"}
+                <span class="wordmark-in">
+                    <LokaMark size={22} wordmark />
+                </span>
+            {/if}
+        </div>
+        <div>
+            <StepDots />
+        </div>
+        <div class="corner end">
+            <SoundToggle />
+            {#if $windowFrame === "page"}
+                <WindowControls />
+            {/if}
+        </div>
+    </header>
+
+    {#each flow as page (page)}
+        {#if mountedPages.has(page)}
+            {@const Component = pages[page]}
+            <Component />
+        {/if}
+    {/each}
+
+    <!-- After the pages, so Tab reaches a page's own controls before Back and Next (it's fixed to the bottom, so
+         this doesn't move it). Kept mounted on Finish so it can animate out. -->
+    {#if $currentPage !== "Welcome"}
+        <PageNavigation />
+    {/if}
+</main>
+
+<style>
+    main {
+        position: relative;
+        display: flex;
+        justify-content: center;
+        width: 100vw;
+        min-height: 100vh;
+
+        & :global(.onboarding-page) {
+            z-index: 1;
+        }
+    }
+
+    .top-bar {
+        position: fixed;
+        z-index: 10;
+        top: 0;
+        left: 0;
+        right: 0;
+        display: grid;
+        grid-template-columns: 1fr auto 1fr;
+        align-items: center;
+        height: var(--top-bar);
+        padding-inline: 24px;
+        pointer-events: none;
+
+        & > * {
+            pointer-events: auto;
+        }
+
+        /* The whole bar takes presses, so its empty space can move the window. */
+        &.title-bar {
+            pointer-events: auto;
+            user-select: none;
+        }
+    }
+
+    .corner {
+        display: flex;
+        align-items: center;
+        min-width: 0;
+
+        &.end {
+            justify-content: flex-end;
+            gap: var(--space-1);
+        }
+    }
+
+    .wordmark-in {
+        display: inline-flex;
+        animation: wordmark-in 400ms var(--ease-out) 200ms backwards;
+    }
+
+    @keyframes wordmark-in {
+        from {
+            opacity: 0;
+        }
+    }
+</style>
