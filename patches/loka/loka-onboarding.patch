+// Loka's messages in the dev server (`vite`), where Helium's chrome-send-polyfill.ts stands in for the browser. It
+// answers Loka's calls and hands everything else to Helium's polyfill, so that file stays Helium's.
+import * as cr from './cr';
+
+declare namespace globalThis {
+    namespace chrome {
+        function send(msg: string, params?: any[]): void;
+    }
+}
+
+if (import.meta.env.DEV) {
+    const helium = globalThis.chrome.send;
+
+    globalThis.chrome.send = (msg: string, params?: any[]) => {
+        if (msg === 'getWindowFrame') {
+            console.log(msg, params);
+            // As in the setup window on Windows, which has no title bar. ?frame=system shows a window that has one.
+            const frame = new URLSearchParams(location.search).get('frame') === 'system' ? 'system' : 'page';
+            cr.webUIResponse(params![0], true, frame);
+        } else if (msg === 'windowAction' || msg === 'startWindowDrag') {
+            // Nothing to move or close in a dev tab; the console line shows the call.
+            console.log(msg, params);
+        } else if (msg === 'setPref' && params?.[1] === 'loka.onboarding_spaces') {
+            // Registered by Loka's C++ side as helium.loka.onboarding_spaces; Helium's polyfill doesn't know it.
+            console.log(msg, params);
+            cr.webUIResponse(params[0], typeof params[2] === 'string', null);
+        } else {
+            helium(msg, params);
+        }
+    };
+}
