+/**
+ * Who draws the window's controls. "page": the setup window has no title bar (Windows), so the page draws minimize
+ * and close and its top bar moves the window. "system": the window has its own title bar (macOS for now, or setup
+ * opened in a tab), so the page draws none.
+ */
+export type WindowFrame = "page" | "system";
+
+const _frame = writable<WindowFrame>("system");
+export const windowFrame = readonly(_frame);
+
+export const setup = () => {
+    cr.sendWithPromise<WindowFrame>("getWindowFrame").then(_frame.set);
+};
+
+export const minimizeWindow = () => chrome.send("windowAction", ["minimize"]);
+export const closeWindow = () => chrome.send("windowAction", ["close"]);
+
+/** Hands the press that's still down to the system's move loop, like pressing on a title bar. */
+export const startWindowDrag = () => chrome.send("startWindowDrag");
