+
+    /* Type: one job per size. Display sizes (h1, h2) are fluid and set below. */
+    --text-caption: 13px;
+    --text-small: 15px;
+    --text-body: 17px;
+    --text-lead: 19px;
+
+    /* Space: 4, 8, 12, 16, 24, 32, 48. */
+    --space-1: 4px;
+    --space-2: 8px;
+    --space-3: 12px;
+    --space-4: 16px;
+    --space-6: 24px;
+    --space-8: 32px;
+    --space-12: 48px;
+
+    /* Three curves. --ease for color and things already on screen, --ease-out for anything the user starts,
+       --ease-in only for what is leaving. */
+    --ease: cubic-bezier(0.2, 0, 0, 1);
+    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
+    --ease-in: cubic-bezier(0.4, 0, 1, 1);
