+    // What each brings is exactly what Helium's importer does: Arc's spaces become bookmark folders, and Zen
+    // gives bookmarks and history (its workspaces aren't read).
+    const FEATURED = ["Arc", "Zen"] as const;
+    const featuredText = {
+        Arc: { title: () => s.dataImport.arcTitle, desc: () => s.dataImport.arcDesc },
+        Zen: { title: () => s.dataImport.zenTitle, desc: () => s.dataImport.zenDesc },
+    };
+
+    const grouped = $derived.by(() => {
