+    200: s.spaces.hueBlue,
+    30: s.spaces.hueAmber,
+    150: s.spaces.hueGreen,
+    330: s.spaces.huePink,
+    260: s.spaces.hueViolet,
+    175: s.spaces.hueTeal,
+    0: s.spaces.hueRed,
+    90: s.spaces.hueLime,
