+<script lang="ts">
+    import { onMount } from "svelte";
+    import { reducedMotion } from "../lib/motion";
+
+    // Loka's night sky behind every page: the sidebar's tinted glows and band of light (prototype/src/app/sky.ts),
+    // a star field on a canvas, and the space's planet as a horizon at the bottom, as under the sidebar.
+    // `travel` is the page number: moving between pages drifts the stars, nearer ones further, like the camera
+    // moving through the sky. `horizon` is how far the planet has risen.
+    type Props = {
+        travel: number;
+        horizon: "below" | "low" | "high";
+    };
+
+    const { travel, horizon }: Props = $props();
+
+    let canvas = $state<HTMLCanvasElement>();
+    let targetTravel = 0;
+
+    $effect(() => {
+        targetTravel = travel;
+    });
+
+    type Star = {
+        x: number;
+        y: number;
+        r: number;
+        alpha: number;
+        color: string;
+        layer: number;
+        phase: number;
+        speed: number;
+    };
+
+    // How far each depth layer moves per page, in CSS px: far stars barely move, near ones most.
+    const DRIFT = [18, 38, 70];
+    // The sky is never still, like the sidebar's: it cruises sideways this many pages a second, so far stars creep
+    // about 1 px/s and near ones about 4 px/s.
+    const CRUISE = 0.06;
+    const FRAME_MS = 1000 / 30;
+
+    onMount(() => {
+        if (!canvas) return;
+        const context = canvas.getContext("2d");
+        if (!context) return;
+        const ctx = context;
+        const el = canvas;
+
+        let width = 0;
+        let height = 0;
+        let dpr = 1;
+        let layers: HTMLCanvasElement[] = [];
+        let twinklers: Star[] = [];
+        let offset = targetTravel;
+        let raf = 0;
+        let last = 0;
+        let start = performance.now();
+        let meteor: { x: number; y: number; t0: number; angle: number; length: number } | null = null;
+        let nextMeteor = start + 3500 + Math.random() * 4000;
+        let reduce = false;
+
+        // Seeded like the sidebar's sky, so the same stars come back every time.
+        const seeded = (seed: number) => () => {
+            seed = (seed * 16807) % 2147483647;
+            return seed / 2147483647;
+        };
+
+        const build = () => {
+            dpr = Math.min(window.devicePixelRatio || 1, 1.5);
+            width = window.innerWidth;
+            height = window.innerHeight;
+            el.width = Math.round(width * dpr);
+            el.height = Math.round(height * dpr);
+
+            const rand = seeded(7919);
+            const count = Math.round(Math.min(560, Math.max(140, (width * height) / 5200)));
+            layers = DRIFT.map(() => {
+                const layer = document.createElement("canvas");
+                layer.width = el.width;
+                layer.height = el.height;
+                return layer;
+            });
+            twinklers = [];
+
+            for (let i = 0; i < count; i++) {
+                const bright = rand() > 0.92;
+                const star: Star = {
+                    x: rand() * width,
+                    y: rand() * height,
+                    r: bright ? 1 + rand() * 0.8 : 0.35 + rand() * 0.6,
+                    color: rand() > 0.8 ? "hsl(200 90% 88%)" : "#fff",
+                    alpha: 0.25 + rand() * 0.65,
+                    layer: 0,
+                    phase: rand() * Math.PI * 2,
+                    speed: 0.5 + rand() * 1.3,
+                };
+                star.layer = bright ? 2 : rand() > 0.5 ? 1 : 0;
+
+                if (rand() < 0.16) {
+                    twinklers.push(star);
+                    continue;
+                }
+
+                const layerCtx = layers[star.layer]?.getContext("2d");
+                if (!layerCtx) continue;
+                layerCtx.globalAlpha = star.alpha;
+                layerCtx.fillStyle = star.color;
+                layerCtx.beginPath();
+                layerCtx.arc(star.x * dpr, star.y * dpr, star.r * dpr, 0, Math.PI * 2);
+                layerCtx.fill();
+            }
+        };
+
+        const wrap = (value: number, size: number) => ((value % size) + size) % size;
+
+        const draw = (now: number) => {
+            const t = (now - start) / 1000;
+            const appear = reduce ? 1 : Math.min(1, t / 1.2);
+            const shift = reduce ? 0 : offset + t * CRUISE;
+
+            ctx.setTransform(1, 0, 0, 1, 0, 0);
+            ctx.clearRect(0, 0, el.width, el.height);
+            ctx.globalAlpha = appear;
+
+            layers.forEach((layer, i) => {
+                const dx = wrap(shift * (DRIFT[i] ?? 0), width) * dpr;
+                ctx.drawImage(layer, -dx, 0);
+                ctx.drawImage(layer, el.width - dx, 0);
+            });
+
+            for (const star of twinklers) {
+                const x = wrap(star.x - shift * (DRIFT[star.layer] ?? 0), width);
+                const shimmer = reduce ? 0.8 : 0.55 + 0.45 * Math.sin(star.phase + t * star.speed);
+                ctx.globalAlpha = appear * star.alpha * shimmer;
+                ctx.fillStyle = star.color;
+                ctx.beginPath();
+                ctx.arc(x * dpr, star.y * dpr, star.r * dpr, 0, Math.PI * 2);
+                ctx.fill();
+            }
+
+            if (meteor) {
+                const p = (now - meteor.t0) / 700;
+                if (p >= 1) {
+                    meteor = null;
+                } else {
+                    const head = meteor.length * Math.min(1, p * 1.6);
+                    const x = meteor.x + Math.cos(meteor.angle) * head;
+                    const y = meteor.y + Math.sin(meteor.angle) * head;
+                    const tail = 90;
+                    const gradient = ctx.createLinearGradient(
