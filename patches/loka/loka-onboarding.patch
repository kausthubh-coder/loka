+    { name: s.spaces.suggestSchool, hue: 30, planet: "banded" },
+    { name: s.spaces.suggestHome, hue: 150, planet: "ocean" },
+    { name: s.spaces.suggestPersonal, hue: 330, planet: "cratered" },
+    { name: s.spaces.suggestProjects, hue: 260, planet: "ringed" },
+];
