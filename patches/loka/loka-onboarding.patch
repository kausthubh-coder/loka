+import { get, writable } from "svelte/store";
+import { SPACE_HUES } from "./spaces";
+
+// Onboarding's sounds, synthesized with WebAudio so there are no audio files and nothing to license.
+// Every cue confirms something already visible on screen; with sound muted the page says the same thing.
+// The AudioContext is only made inside the first click or key press, so nothing plays before a gesture.
+
+export type Cue =
+    | "tap"
+    | "select"
+    | "toggleOn"
+    | "toggleOff"
+    | "next"
+    | "back"
+    | "kind"
+    | "remove"
+    | "nope"
+    | "create"
+    | "finish"
+    | `hue:${number}`;
+
+const MUTE_KEY = "loka-onboarding-muted";
+
+const readMuted = (): boolean => {
+    try {
+        return localStorage.getItem(MUTE_KEY) === "1";
+    } catch {
+        return false;
+    }
+};
+
+export const muted = writable(readMuted());
+muted.subscribe((value) => {
+    try {
+        localStorage.setItem(MUTE_KEY, value ? "1" : "0");
+    } catch {
+        // Storage can be unavailable; muting still works for this visit.
+    }
+});
+
+let ctx: AudioContext | undefined;
+let out: GainNode | undefined;
+let space: GainNode | undefined;
+let noiseBuffer: AudioBuffer | undefined;
+let gestureSeen = false;
+
+/** Built inside a user gesture: a soft low-pass on the way out, and a damped echo that gives cues a sense of space. */
+const startAudio = () => {
+    if (ctx) {
+        if (ctx.state === "suspended") void ctx.resume();
+        return;
+    }
+
+    try {
+        ctx = new AudioContext({ latencyHint: "interactive" });
+    } catch {
+        return;
+    }
+
+    const soften = ctx.createBiquadFilter();
+    soften.type = "lowpass";
+    soften.frequency.value = 5200;
+    soften.connect(ctx.destination);
+
+    out = ctx.createGain();
+    // The cues are written quiet; this sets how loud the whole set is.
+    out.gain.value = 2.2;
+    out.connect(soften);
+
+    const delay = ctx.createDelay(1);
+    delay.delayTime.value = 0.24;
+    const feedback = ctx.createGain();
+    feedback.gain.value = 0.34;
+    const damp = ctx.createBiquadFilter();
+    damp.type = "lowpass";
+    damp.frequency.value = 1800;
+
+    space = ctx.createGain();
+    space.gain.value = 0.5;
+    space.connect(delay);
+    delay.connect(damp);
+    damp.connect(feedback);
+    feedback.connect(delay);
+    damp.connect(out);
+
+    noiseBuffer = ctx.createBuffer(1, ctx.sampleRate, ctx.sampleRate);
+    const data = noiseBuffer.getChannelData(0);
+    for (let i = 0; i < data.length; i++) data[i] = Math.random() * 2 - 1;
+};
+
+type Envelope = {
+    at?: number;
+    attack?: number;
+    decay: number;
+    gain: number;
+    /** How much goes to the echo, 0 to 1. */
+    send?: number;
+};
+
+const envelope = (c: AudioContext, node: AudioNode, e: Envelope) => {
+    const start = c.currentTime + (e.at ?? 0);
+    const attack = e.attack ?? 0.004;
+    const g = c.createGain();
+    g.gain.setValueAtTime(0.0001, start);
+    g.gain.exponentialRampToValueAtTime(e.gain, start + attack);
+    g.gain.exponentialRampToValueAtTime(0.0001, start + attack + e.decay);
+    node.connect(g);
+    if (out) g.connect(out);
+    if (e.send && space) {
+        const send = c.createGain();
+        send.gain.value = e.send;
+        g.connect(send);
+        send.connect(space);
+    }
+    return { start, end: start + attack + e.decay + 0.05 };
+};
