+    }
+    source.start(start, Math.random() * 0.5);
+    source.stop(end);
+};
+
+// A major pentatonic, so any two cues that overlap still sound good together.
+const NOTES = [440, 493.9, 554.4, 659.3, 740, 880, 987.8, 1108.7];
+
+const CUES: Record<Exclude<Cue, `hue:${number}`>, () => void> = {
+    tap: () => {
+        noise({ freq: 2600, q: 1.4, decay: 0.014, gain: 0.03 });
+        tone({ freq: 880, to: 740, decay: 0.045, gain: 0.022 });
+    },
