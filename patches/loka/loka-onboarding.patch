+const tone = (
+    t: Envelope & { freq: number; to?: number; type?: OscillatorType },
+) => {
+    if (!ctx) return;
+    const osc = ctx.createOscillator();
+    osc.type = t.type ?? "sine";
+    const { start, end } = envelope(ctx, osc, t);
+    osc.frequency.setValueAtTime(t.freq, start);
+    if (t.to) {
+        osc.frequency.exponentialRampToValueAtTime(t.to, start + (t.attack ?? 0.004) + t.decay);
+    }
+    osc.start(start);
+    osc.stop(end);
+};
