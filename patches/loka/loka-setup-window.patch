+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+
+// Loka: first run opens Loka's setup page (chrome://setup) in an app popup of
+// its own with this app name (ShowLokaSetupWindow).
+inline constexpr char kLokaSetupAppName[] = "loka_setup";
+
+// Loka: whether the setup window has no title bar on this platform. On Windows
+// BrowserFrameViewWin draws none, so setup's page fills the window and draws
+// its own minimize, close and drag area. macOS keeps its title bar (and its
+// traffic lights) until its frame does the same.
+inline constexpr bool kLokaSetupWindowHasNoTitleBar = BUILDFLAG(IS_WIN);
+
+// Loka: true for the setup window, false for every other window (and null).
+inline bool IsLokaSetupWindow(const BrowserWindowInterface* browser) {
+  if (!browser ||
+      browser->GetType() != BrowserWindowInterface::TYPE_APP_POPUP) {
+    return false;
+  }
+  const BrowserInitState* init_state = BrowserInitState::From(browser);
+  return init_state &&
+         init_state->create_params().app_name == kLokaSetupAppName;
+}
+
+#endif  // CHROME_BROWSER_UI_STARTUP_LOKA_SETUP_WINDOW_H_
