+namespace {
+
+// Loka: the setup window has no title bar on Windows (loka_setup_window.h), so
+// setup's page draws minimize and close and moves the window from its top bar
+// through these. They do nothing for setup opened in an ordinary tab.
+class LokaSetupWindowHandler : public content::WebUIMessageHandler {
+ public:
+  void RegisterMessages() override {
+    web_ui()->RegisterMessageCallback(
+        "getWindowFrame",
+        base::BindRepeating(&LokaSetupWindowHandler::HandleGetWindowFrame,
+                            base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "windowAction",
+        base::BindRepeating(&LokaSetupWindowHandler::HandleWindowAction,
+                            base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "startWindowDrag",
+        base::BindRepeating(&LokaSetupWindowHandler::HandleStartWindowDrag,
+                            base::Unretained(this)));
+  }
+
+ private:
+  // The setup window this page fills, or null when the page is anywhere else.
+  BrowserWindowInterface* SetupWindow() {
+    tabs::TabInterface* tab =
+        tabs::TabInterface::MaybeGetFromContents(web_ui()->GetWebContents());
+    BrowserWindowInterface* browser =
+        tab ? tab->GetBrowserWindowInterface() : nullptr;
+    return IsLokaSetupWindow(browser) ? browser : nullptr;
+  }
+
+  // Answers "page" when the window has no title bar and the page draws its
+  // controls, "system" when the window has its own.
+  void HandleGetWindowFrame(const base::ListValue& args) {
+    if (args.empty()) {
+      return;
+    }
+    AllowJavascript();
+    const bool page_draws_frame =
+        kLokaSetupWindowHasNoTitleBar && SetupWindow();
+    ResolveJavascriptCallback(
+        args[0], base::Value(page_draws_frame ? "page" : "system"));
+  }
+
+  void HandleWindowAction(const base::ListValue& args) {
+    BrowserWindowInterface* setup = SetupWindow();
+    if (!setup || args.empty() || !args[0].is_string()) {
+      return;
+    }
+    const std::string& action = args[0].GetString();
+    if (action == "minimize") {
+      setup->GetWindow()->Minimize();
+    } else if (action == "close") {
+      setup->GetWindow()->Close();
+    }
+  }
+
+  // The page's top bar moves the window, like a title bar: the press that's
+  // still down goes to Windows' own move loop (which also snaps), as the
+  // sidebar's top row does (LokaSidebarHandler::HandleStartWindowDrag).
+  void HandleStartWindowDrag(const base::ListValue& args) {
+#if BUILDFLAG(IS_WIN)
+    BrowserWindowInterface* setup = SetupWindow();
+    if (!setup || setup->GetWindow()->IsFullscreen()) {
+      return;
+    }
+    HWND hwnd =
+        views::HWNDForNativeWindow(setup->GetWindow()->GetNativeWindow());
+    if (!hwnd || !(::GetAsyncKeyState(VK_LBUTTON) & 0x8000)) {
+      return;
+    }
+    ::ReleaseCapture();
+    ::SendMessage(hwnd, WM_NCLBUTTONDOWN, HTCAPTION, 0);
+#endif
+  }
+};
+
+}  // namespace
 
