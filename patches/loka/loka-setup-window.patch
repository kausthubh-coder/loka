 namespace {
+
+// Loka: first run opens Loka's setup page in a window of its own, before any
+// browser window. When setup finishes, the browser window opens and the setup
+// window closes.
+void ShowLokaSetupWindow(Profile* profile) {
+  gfx::Rect bounds(0, 0, 1180, 780);
+  if (display::Screen* screen = display::Screen::Get()) {
+    const gfx::Rect area = screen->GetPrimaryDisplay().work_area();
+    bounds.set_size(gfx::Size(std::min(bounds.width(), area.width()),
+                              std::min(bounds.height(), area.height())));
+    bounds.set_origin(area.CenterPoint() -
+                      gfx::Vector2d(bounds.width() / 2, bounds.height() / 2));
+  }
+  BrowserWindowInterface* setup =
+      CreateBrowserWindow(BrowserWindowCreateParams::CreateForAppPopup(
+          kLokaSetupAppName, /*trusted_source=*/true, bounds, profile,
+          /*user_gesture=*/true));
+  if (!setup) {
+    return;
+  }
+  chrome::AddTabAt(setup, GURL(chrome::kHeliumSetupURL), -1,
+                   /*foreground=*/true);
+  setup->GetWindow()->Show();
+
+  auto* registrar = new PrefChangeRegistrar();
+  registrar->Init(profile->GetPrefs());
+  registrar->Add(
+      prefs::kHeliumDidOnboarding,
+      base::BindRepeating(
+          [](PrefChangeRegistrar* registrar, Profile* profile,
+             base::WeakPtr<BrowserWindowInterface> setup) {
+            if (!profile->GetPrefs()->GetBoolean(prefs::kHeliumDidOnboarding)) {
+              return;
+            }
+            // The pref is set from inside the setup page's message handler,
+            // which answers the page afterwards; closing the window here can
+            // destroy the page first (a minimized window closes at once). So
+            // the switch happens on the next task.
+            base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+                FROM_HERE,
+                base::BindOnce(
+                    [](Profile* profile,
+                       base::WeakPtr<BrowserWindowInterface> setup) {
+                      chrome::NewEmptyWindow(
+                          profile, /*should_trigger_session_restore=*/false);
+                      if (setup) {
+                        setup->GetWindow()->Close();
+                      }
+                    },
+                    profile, setup));
+            base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+                FROM_HERE, registrar);
+          },
+          registrar, profile, setup->GetWeakPtr()));
+}
 
