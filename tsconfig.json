{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["bun", "chrome"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"useDefineForClassFields": false,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"allowJs": true,
		"checkJs": true,
		"noEmit": true
	},
	"include": ["prototype/src", "extension/src", "extension/vite.config.ts", "webui/src", "webui/vite.config.ts", "prototype/vite.config.ts", "scripts", ".agents/skills/*/scripts"]
}
